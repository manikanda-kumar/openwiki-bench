{
  "id": "smaug-flash-opencode",
  "model": "routellm/abacusai/Smaug-Flash",
  "runtime": "host-opencode",
  "openwiki_version": "0.4.3",
  "agent": "build",
  "command": [
    "opencode",
    "run",
    "--model",
    "{model}",
    "--agent",
    "build",
    "--format",
    "json",
    "--auto",
    "--title",
    "openwiki-bench-{seed}",
    "Use the OpenWiki skill to initialize a complete source-grounded wiki for this repository. Follow the lifecycle through openwiki_finish. Apply the benchmark brief in openwiki/INSTRUCTIONS.md. Do not modify source files, document OpenWiki-generated integration files, use subagents, or switch models."
  ],
  "env_passthrough": ["ROUTELLM_API_KEY"],
  "env": {
    "OPENCODE_CONFIG_CONTENT": "{\"provider\":{\"routellm\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"RouteLLM\",\"options\":{\"baseURL\":\"https://routellm.abacus.ai/v1\",\"apiKey\":\"{env:ROUTELLM_API_KEY}\"},\"models\":{\"abacusai/Smaug-Flash\":{\"name\":\"Smaug Flash\",\"limit\":{\"context\":1000000,\"output\":384000},\"cost\":{\"input\":0.1,\"output\":0.4,\"cache_read\":0.005}}}}}}"
  },
  "output_directory": "openwiki",
  "run_state_path": "openwiki/.run.json",
  "timeout_seconds": 10800,
  "telemetry": "opencode-jsonl"
}
