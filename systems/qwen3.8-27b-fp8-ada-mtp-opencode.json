{
  "id": "qwen3.8-27b-fp8-ada-mtp-opencode",
  "model": "massed-local/Qwen/Qwen3.8-27B-FP8",
  "runtime": "host-opencode",
  "openwiki_version": "0.4.3",
  "agent": "build",
  "command": [
    "opencode",
    "run",
    "--model",
    "{model}",
    "--agent",
    "build",
    "--format",
    "json",
    "--auto",
    "--title",
    "openwiki-bench-{seed}",
    "Use the OpenWiki skill to initialize a complete source-grounded wiki for this repository. Follow the lifecycle through openwiki_finish. Apply the benchmark brief in openwiki/INSTRUCTIONS.md. Do not modify source files, document OpenWiki-generated integration files, use subagents, or switch models."
  ],
  "env_passthrough": [],
  "env": {
    "OPENCODE_CONFIG_CONTENT": "{\"provider\":{\"massed-local\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"Massed Compute local Qwen\",\"options\":{\"baseURL\":\"http://127.0.0.1:18000/v1\"},\"models\":{\"Qwen/Qwen3.8-27B-FP8\":{\"name\":\"Qwen3.8 27B FP8 Ada\",\"limit\":{\"context\":131072,\"output\":32768}}}}}}"
  },
  "output_directory": "openwiki",
  "run_state_path": "openwiki/.run.json",
  "timeout_seconds": 10800,
  "telemetry": "opencode-jsonl"
}
