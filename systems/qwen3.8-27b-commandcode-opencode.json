{
  "id": "qwen3.8-27b-commandcode-opencode",
  "model": "commandcode/Qwen/Qwen3.8-27B",
  "runtime": "host-opencode",
  "openwiki_version": "0.4.3",
  "agent": "build",
  "command": [
    "opencode",
    "run",
    "--model",
    "{model}",
    "--agent",
    "build",
    "--format",
    "json",
    "--auto",
    "--title",
    "openwiki-bench-{seed}",
    "Use the OpenWiki skill to initialize a complete source-grounded wiki for this repository. Follow the lifecycle through openwiki_finish. Apply the benchmark brief in openwiki/INSTRUCTIONS.md. Do not modify source files, document OpenWiki-generated integration files, use subagents, or switch models."
  ],
  "env_passthrough": ["COMMAND_CODE_API_KEY"],
  "env": {
    "OPENCODE_CONFIG_CONTENT": "{\"provider\":{\"commandcode\":{\"npm\":\"@ai-sdk/openai-compatible\",\"name\":\"Command Code Provider API\",\"options\":{\"baseURL\":\"https://api.commandcode.ai/provider/v1\",\"apiKey\":\"{env:COMMAND_CODE_API_KEY}\"},\"models\":{\"Qwen/Qwen3.8-27B\":{\"name\":\"Qwen 3.8 27B (Command Code)\",\"limit\":{\"context\":262144,\"output\":32768},\"cost\":{\"input\":0.4,\"output\":3.0,\"cache_read\":0.04}}}}}}"
  },
  "output_directory": "openwiki",
  "run_state_path": "openwiki/.run.json",
  "timeout_seconds": 10800,
  "telemetry": "opencode-jsonl"
}
