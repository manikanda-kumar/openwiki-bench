  "claims": [
    {
      "id": "claim_cfd751db753241a2ba83a2e84b2ebb7c",
      "statement": "The step base path defaults to $HOME/.step and can be overridden with the STEPPATH environment variable; step path prints the effective path via cli-utils step.Path(), with --base returning step.BasePath() and --profile returning step.ProfilePath().",
      "evidence": [
        {
          "resource": "repo://command/path/path.go#L17-L22",
          "version": "repo-lines-v1:sha256:b071faa38919496715571ad90620ec487a9b7a023ff3ac2b7ef73b40e404c269:"
        },
        {
          "resource": "repo://command/path/path.go#L92-L103",
          "version": "repo-lines-v1:sha256:1d7e37deab834e1ceaaa91f17a0676d5dcf7bed40a2220548e0b5a9184576318:"
        }
      ]
    },
    {
      "id": "claim_9fc1b7cc8766469bb7c8ec152abda367",
      "statement": "When a context is active, step path resolves to the current context's authority path under <base>/authorities/<authority>, and step path --profile resolves to <base>/profiles/<profile>; the base path holds current-context.json (e.g. {\"context\": \"machine.step-internal.net\"}) and contexts.json mapping names to {profile, authority} pairs.",
      "evidence": [
        {
          "resource": "repo://command/path/path.go#L39-L46",
          "version": "repo-lines-v1:sha256:a9f2e08b03d3a72dd476470dfa13221244b4ab625eca16d4e6acc81c44727112:"
        },
        {
          "resource": "repo://command/path/path.go#L61-L80",
          "version": "repo-lines-v1:sha256:fa69e1a1a3a0801a97dd9f002ee6fd3b982c39b5bff1783a4eb655fbaf1f57b2:"
        }
      ]
    },
    {
      "id": "claim_26ed0e3f371b40719938b74ba8d538a8",
      "statement": "defaults.json (written by step ca bootstrap) always contains ca-url, fingerprint, and root; redirect-url, provisioner, and min-password-length appear only when the bootstrap flow provides them (team authority API data can set all three).",
      "evidence": [
        {
          "resource": "repo://utils/cautils/bootstrap.go#L170-L185",
          "version": "repo-lines-v1:sha256:0abb790aa69ff969d97083aec3c1668c1d004d4fc2b2001fb7f116c278fb6cf1:"
        },
        {
          "resource": "repo://utils/cautils/bootstrap.go#L89-L96",
