    {
      "id": "claim_6bb7daaa0fdc4520a41db59455295d73",
      "statement": "step ca init validates a flag-compatibility matrix before any work: --root requires --key, --ra must be StepCAS or CloudCAS, --kms must be azurekms and is incompatible with --ra, --pki excludes --no-db and --helm, --remote-management and --acme require a database (no --no-db), and --admin-subject requires --remote-management; it also fails fast if crypto/rand is unavailable.",
      "evidence": [
        {
          "resource": "repo://command/ca/init.go#L240-L279",
