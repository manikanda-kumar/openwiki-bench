    {
      "id": "claim_a959dd97badf472faa053492de4f16a8",
      "statement": "All CA client commands program against the CaClient interface (Sign, Renew, RenewWithToken, Revoke, Rekey, the SSH surface, Version, GetRootCAs, GetCaURL); NewClient returns an offline OfflineCA when --offline is set (also requiring --ca-config), otherwise an online ca.Client built from --ca-url and --root with fallback to pki.GetRootCAPath().",
      "evidence": [
        {
          "resource": "repo://utils/cautils/client.go#L29-L48",
          "version": "repo-lines-v1:sha256:a000d1d60c28618e22b0902c70b819e3b30b8ab48eaededb488012c2aad4d575:"
        },
        {
