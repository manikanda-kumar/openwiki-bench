    {
      "id": "claim_3c96369a27d04fe8aa746f8d00263d7b",
      "statement": "Layer 1 (entrypoint): cmd/step/main.go holds only ldflags-injected build variables, an init() that publishes them to cli-utils and sets the CA client user agent, and main() that calls cmd.Run(); all other logic lives below this layer.",
      "evidence": [
        {
          "resource": "repo://cmd/step/main.go#L10-L29",
          "version": "repo-lines-v1:sha256:9d61d4a4bf529b8deb6e8682d4501b2fca8fe2213ebee5ea784d8dc6947d3b3a:"
