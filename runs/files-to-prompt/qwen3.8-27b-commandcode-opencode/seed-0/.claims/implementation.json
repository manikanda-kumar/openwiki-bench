    {
      "id": "claim_daf24ea4cbf1468a95bee5038255eaad",
      "statement": ".gitignore rules are parsed line-based (non-empty, non-# lines only) and accumulate into one shared list: the parent directory of each top-level path contributes before walking, and every walked directory extends the same list, so rules persist across all input paths; --ignore-gitignore disables this entirely.",
      "evidence": [
        {
          "resource": "repo://files_to_prompt/cli.py#L127-L128",
          "version": "repo-lines-v1:sha256:351951656a0c77573b5fb7ed7e9f81442de79cf9efc53b9a8d25df8e85e49a81:"
