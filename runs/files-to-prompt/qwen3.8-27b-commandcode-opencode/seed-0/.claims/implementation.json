    {
      "id": "claim_a1a8ffd49e7d4b28bca061ebc8da57d7",
      "statement": "All CLI behavior lives in a single click command, cli, in files_to_prompt/cli.py, exposed as the files-to-prompt console script and via python -m files_to_prompt.",
