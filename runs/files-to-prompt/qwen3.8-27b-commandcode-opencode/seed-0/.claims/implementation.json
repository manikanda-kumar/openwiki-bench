    {
      "id": "claim_7fc3bafd0f0d4579a613797e406354ec",
      "statement": "Directory traversal uses os.walk, and files within each directory are emitted in sorted(files) order.",
      "evidence": [
        {
          "resource": "repo://files_to_prompt/cli.py#L121-L156",
          "version": "repo-lines-v1:sha256:7abdebd1113d9ff195ca6f38e47ad263bcea0a51ffbd621e59412ab8c533d702:"
        }
