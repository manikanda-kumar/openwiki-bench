    },
    {
      "id": "claim_e6dfec5bb0774218905952ae97246f07",
      "statement": "Hidden files and directories (names starting with .) are excluded by default; --include-hidden re-includes them, and directory pruning is done via in-place dirs[:] reassignment so os.walk never descends into hidden directories.",
      "evidence": [
        {
          "resource": "repo://files_to_prompt/cli.py#L123-L125",
          "version": "repo-lines-v1:sha256:6df17c79078deb370d2d4dc8e0efd1f8c69c324793d30d409a068b45f4c59d88:"
