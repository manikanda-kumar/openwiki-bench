    {
      "id": "claim_ffc0c1202d4c41c48ecc971ecbbef658",
      "statement": "Within each walked directory, process_path applies filters in a fixed order: hidden entries (unless --include-hidden), then accumulated .gitignore rules (unless --ignore-gitignore), then --ignore fnmatch patterns, and finally -e extension filtering via str.endswith on a tuple.",
      "evidence": [
        {
          "resource": "repo://files_to_prompt/cli.py#L121-L154",
          "version": "repo-lines-v1:sha256:d625a8920beef00574db54cd2fbece63163a7a5dc65368ebe859a27c620c37f2:"
        }
      ]
    },
    {
      "id": "claim_e9b7c1bae3334f6f9c98aceca753a495",
      "statement": ".gitignore rules accumulate across the walk: rules from the parent directory of each top-level path are loaded before traversal and read_gitignore(root) rules are appended for every directory visited, so a nested .gitignore applies to its subtree; should_ignore fnmatches only basenames (and basename + '/' for directories), so git path syntax, anchoring, and negation are not supported.",
      "evidence": [
        {
          "resource": "repo://files_to_prompt/cli.py#L127-L138",
