    {
      "id": "claim_b8beef02b5be47ff89a3dc67ee1d5ea4",
      "statement": "Paths are taken from command-line arguments and stdin; read_paths_from_stdin returns an empty list when stdin is a TTY so interactive use never blocks, otherwise splits on NUL with --null or on whitespace otherwise; stdin paths are appended after argument paths and every combined path is rechecked with os.path.exists, raising click.BadArgumentUsage when missing.",
      "evidence": [
        {
          "resource": "repo://files_to_prompt/cli.py#L175-L185",
          "version": "repo-lines-v1:sha256:ea4d0e83a936038d1328c3a66c4501cc2c6f9fa98c0784be3c4c0c97cc0b550f:"
