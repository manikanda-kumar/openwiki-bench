  "claims": [
    {
      "id": "claim_4bb3e98211484dcca3608a9668b17f5c",
      "statement": "Telemetry is off by default and the off state is structural: init never runs, start_trace finds no globals and answers None, and no event is ever built.",
      "evidence": [
        {
          "resource": "repo://crates/celld/telemetry.rs#L6-L12",
          "version": "repo-lines-v1:sha256:03ec58ec5a1168d8cde3fe3edad1d6350088821664df6453ed9be482f8842bd5:"
        }
      ]
    },
    {
      "id": "claim_407529d7a7804d9ca30990ea50694128",
      "statement": "The default sink is the fleet bucket, writing Parquet under the telemetry/ prefix with no other service; the alternative sink sends the same data to an OpenTelemetry collector, and the schema is version v0-unstable carried in each file's object metadata.",
      "evidence": [
        {
          "resource": "repo://docs/telemetry.md#L7-L15",
          "version": "repo-lines-v1:sha256:3c194b6dd15e47812e0e6a0f3bc5124724cd06d8aa6bb1b569ab2c6b4503ed0c:"
        }
      ]
    },
    {
      "id": "claim_0244db6e2f7842ca98e6b9647e5dac7d",
      "statement": "Telemetry config is built once by Config::from_env, which returns None unless CELLD_OTEL is set to 1.",
      "evidence": [
        {
          "resource": "repo://crates/celld/telemetry.rs#L102-L108",
          "version": "repo-lines-v1:sha256:737f41ab3dfa9ed52df2368fd4d1921e0cc43b6d76a854868124980c16af5730:"
        }
      ]
    },
    {
      "id": "claim_2075fb298f7744de87dfe018c1472409",
      "statement": "The telemetry settings — CELLD_OTEL_SINK, CELLD_OTEL_BUCKET, CELLD_OTEL_RETENTION (default 30d), CELLD_OTEL_FLUSH_MS (default 300000), CELLD_OTEL_FLUSH_BYTES (default 5242880), OTEL_TRACES_SAMPLER, OTEL_EXPORTER_OTLP_ENDPOINT, and OTEL_SERVICE_NAME — are parsed by Config::from_lookup.",
      "evidence": [
