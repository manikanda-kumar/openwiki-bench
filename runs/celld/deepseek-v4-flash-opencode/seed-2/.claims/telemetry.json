    {
      "id": "claim_add02f69023e4858a4c1a8d4898befca",
      "statement": "Telemetry files are partitioned by node and by hour under telemetry/traces/<node>/<yyyy>/<mm>/<dd>/<hh>/ and telemetry/logs/..., so a query that reads one day touches only that day's files.",
