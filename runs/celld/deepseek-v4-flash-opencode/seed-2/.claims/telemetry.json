    {
      "id": "claim_9ada826ea0ff45a7bc024c88b2a74f09",
      "statement": "celld does not compact its own telemetry files; a compaction job must run on a maintenance node once an hour for the hour that just ended, rewriting one past hour of small files into one large zstd-compressed file with DuckDB.",
