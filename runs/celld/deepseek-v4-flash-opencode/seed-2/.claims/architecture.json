        }
      ]
    },
    {
      "id": "claim_a282789a08a84cc7bcfa0ec702a74fd4",
      "statement": "celld-logic is a pure decision core: on_event is the only way behavioral state advances, the production executor and deterministic simulator both feed it events and perform the returned effects, and no adapter may mutate State directly.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L3-L7",
          "version": "repo-lines-v1:sha256:d17ba561785ca7348bb778cc922706279fc2c8177e57be65f95ad2d2ff6c06b8:"
