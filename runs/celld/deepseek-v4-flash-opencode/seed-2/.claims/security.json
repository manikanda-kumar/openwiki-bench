        {
          "resource": "repo://crates/celld/control_plane.rs#L38-L54",
          "version": "repo-lines-v1:sha256:3a5d177bfa6190715093ee1e0b24f5d1aaabb7079c08dfb0ab2a7cc8991c0339:"
