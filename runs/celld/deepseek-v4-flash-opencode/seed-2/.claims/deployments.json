    {
      "id": "claim_eede7cc6a3f5496d9e4e26f57bb1e6fb",
      "statement": "Each node reads deploy/current.json every CELLD_DEPLOY_POLL_S seconds (default 30) and adopts a new deployment in place; POST /reload adopts it now, a node builds the new deployment beside the current one and switches new requests in one step, and a deployment that does not build leaves the current one serving.",
      "evidence": [
        {
          "resource": "repo://docs/README.md#L245-L253",
          "version": "repo-lines-v1:sha256:8ee191ea2b8465c36fe7011a68a8cd60c01c24f4333506d943b8bea7d0c0fe7b:"
        }
