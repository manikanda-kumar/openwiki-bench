    },
    {
      "id": "claim_0b142ec8e7044e8e966f92774c9f3b76",
      "statement": "The module registry is an isolate slot rather than a thread-local because its Global<Module> handles belong to one isolate's heap; with several isolates entered from the same tokio worker, a thread-local let a new isolate wipe a live one's stubs.",
      "evidence": [
        {
          "resource": "repo://crates/celld/js/modules.rs#L35-L54",
          "version": "repo-lines-v1:sha256:e900625aa98ef8e598cd0436bb69f2b56abbb644608b7c8a933fdf13791bb393:"
