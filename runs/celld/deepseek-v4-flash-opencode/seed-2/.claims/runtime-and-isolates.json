  "claims": [
    {
      "id": "claim_a8f178d12cf344f6a736c9df53fa2151",
      "statement": "celld embeds rusty_v8 directly with one isolate per cell; a Worker's default-export fetch receives an env whose bindings are Durable Object namespaces, and env.NS.get(id).fetch() instantiates the exported DO class once per id with state storage backed by the cell's SQLite.",
      "evidence": [
        {
          "resource": "repo://crates/celld/js.rs#L8-L15",
          "version": "repo-lines-v1:sha256:a3d6723fd7461ff73e7bdc96a3de3ba2066f8cf9005123a51731700b09dd97a2:"
        }
      ]
    },
    {
      "id": "claim_09d409e3203f410781a62dfa7f924204",
      "statement": "Durable Object ctx.storage is async in JS but synchronous underneath because it is local SQLite; each cell is its own database file, so the JS side keeps a scope-to-Connection map that opens on activation and closes on eviction.",
      "evidence": [
        {
          "resource": "repo://crates/celld/storage.rs#L6-L14",
          "version": "repo-lines-v1:sha256:70efb51767a5944f51fe86cb6ba9c9e77e1d0b44753431b624eafda074c770a4:"
        }
      ]
    },
    {
      "id": "claim_25b0eab3556246b88973b7d7928921ff",
      "statement": "Cell storage state belongs to the isolate rather than a thread, because a cell event is driven by a tokio task whose turns run on whatever worker holds the isolate; a turn holds the isolate lock so exactly one thread reaches the maps at a time.",
      "evidence": [
        {
          "resource": "repo://crates/celld/storage.rs#L22-L33",
          "version": "repo-lines-v1:sha256:2e51a6e757a89997357e57c46af40a38d425b7923d2f828bd839d117261c9d12:"
        }
      ]
    },
    {
      "id": "claim_236afcc685904c95bfc127e130449dc0",
      "statement": "The database connection and the ownership epoch that authorized its activation are kept in one map entry, so asynchronous object-store work cannot recover an epoch through a later ownership lookup after a takeover.",
      "evidence": [
        {
          "resource": "repo://crates/celld/storage.rs#L52-L60",
          "version": "repo-lines-v1:sha256:0aee592c5655ca94f7a60d89cfe0c73b0d7f14485d7750992756f8a7017742ee:"
        }
      ]
    },
    {
      "id": "claim_2dfff6e6d8554ed59c99878db457900b",
      "statement": "A module specifier is either a builtin whose source the module holds or an import of another worker that resolves through the loader, and most builtins compile lazily the first time something reads their global.",
      "evidence": [
        {
          "resource": "repo://crates/celld/js/modules.rs#L3-L8",
          "version": "repo-lines-v1:sha256:9bed57565fc003f502c43b47e330681c01d9e4d9f7b13225bfbcd17dc1b3c1d1:"
        }
