    {
      "id": "claim_0169dd65b0d2446095bb0981c169fdbd",
      "statement": "The upgrade from v0.1.0 to v0.2.0 must not be a rolling update: v0.2.0 nodes advertise the internal listener and compact replicated data into block objects that a v0.1.0 reader cannot restore.",
      "evidence": [
        {
          "resource": "repo://docs/README.md#L514-L522",
          "version": "repo-lines-v1:sha256:3ac08f8a6e2cd14ec7f26ff34f6fddaf88ba697334495bcbfdc3e4ae0e3f65d9:"
        }
