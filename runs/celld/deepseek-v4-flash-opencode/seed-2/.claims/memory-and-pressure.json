  "claims": [
    {
      "id": "claim_ea714b5b448b4f668f96fe07ab0a1144",
      "statement": "Resident-cell count is a hard cap enforced at admission, while the pressure classifier answers only whether the node is out of memory and must give cells back; conflating the two produced placement churn and an admission wedge.",
      "evidence": [
