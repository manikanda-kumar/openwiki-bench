        }
      ]
    },
    {
      "id": "claim_4c5abe65a4b448a8af76575fd71eb4e4",
      "statement": "celld enables jemalloc's background thread at startup so freed pages return even when a node that just shed its working set does not allocate again; on macOS the thread is unavailable so the absolute cap is the only protection against an OS kill.",
      "evidence": [
