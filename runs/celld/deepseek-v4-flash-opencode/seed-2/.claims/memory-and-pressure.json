        }
      ]
    },
    {
      "id": "claim_5e7bf124a9314821b10988cde8a3b75e",
      "statement": "PressureConfig is built from the environment: high_bytes defaults to 80% of the available memory and CELLD_MAX_RSS_MB=0 disables it, while rss_hard_bytes is an absolute cap of 95% of the available memory on the complete cgroup charge, never derived from the ceiling.",
      "evidence": [
