        }
      ]
    },
    {
      "id": "claim_9546b324948c4b7bad36982c411e33fe",
      "statement": "Two conditional-write dialects share one surface: S3 (and Azure) use the etag as an If-Match / If-None-Match CAS token, while GCS uses the object generation as x-goog-if-generation-match.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L3-L24",
