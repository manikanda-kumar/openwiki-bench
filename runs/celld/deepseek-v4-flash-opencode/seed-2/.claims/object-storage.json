          "version": "repo-lines-v1:sha256:55966316b6e34f7d770501c27990c9a4c0f31e2395636900e25a4bf0e8a181a4:"
        }
      ]
    },
    {
      "id": "claim_b6c5b3c37f4c4a69bcc9112020747662",
      "statement": "The Bucket keeps a paginated-listing handle because ObjectStore::list_with_delimiter drains every continuation page into one buffer and cannot bound a listing's cost.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L146-L154",
          "version": "repo-lines-v1:sha256:ab14a1c852d001119202db0cfe12cb58bf7176854345319a34789a251dcf6bcc:"
