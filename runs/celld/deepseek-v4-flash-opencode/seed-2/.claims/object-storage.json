        {
          "resource": "repo://docs/guarantees.md#L18-L24",
          "version": "repo-lines-v1:sha256:0ee14b099064e1ad2123065d06a0badc62f2d722507d8d37ca55fa4ceb66897c:"
        }
      ]
    },
    {
      "id": "claim_12e1c75cca184927a3bda051a8a7c9db",
      "statement": "Amazon S3, Cloudflare R2, Tigris, Google Cloud Storage, and Azure Blob Storage qualify; Backblaze B2, Hetzner, and DigitalOcean Spaces do not implement the required conditional writes, and MinIO passes the storage test but is not qualified for production.",
      "evidence": [
