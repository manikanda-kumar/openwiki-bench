    {
      "id": "claim_a0a0dc70b80447368be2f94998e00ea7",
      "statement": "split_spec parses [s3://|gs://|az://]NAME[/PREFIX] into the backend, bucket name, and a normalized key prefix; on az:// the NAME is the container and the storage account comes from AZURE_STORAGE_ACCOUNT_NAME.",
