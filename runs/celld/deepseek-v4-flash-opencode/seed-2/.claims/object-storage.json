  "claims": [
    {
      "id": "claim_8ee25dc52bc94e82a7e5a5ff3eed9e75",
      "statement": "celld uses one object-store client for the whole engine, the object_store crate bound to one bucket, and every call site uses in-memory Bytes because no call site streamed a body.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L3-L5",
          "version": "repo-lines-v1:sha256:8d71989876e7d19eca7e85ceab4868af31e883a859f0c1da807c9b290ff3d91e:"
        }
      ]
    },
    {
      "id": "claim_49bcb5d98a334b0782873051305a2304",
      "statement": "celld requires three properties from the object store: a conditional create, a conditional overwrite, and read-after-write consistency.",
