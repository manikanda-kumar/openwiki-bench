  "claims": [
    {
      "id": "claim_13c14422d88e4a38bc5ab59268a61617",
      "statement": "celld-ltx is an embeddable streaming-replication library for SQLite that captures WAL data as LTX segments, reads and writes replica storage, restores databases, compacts levels, and reads bundle objects; it is a from-scratch Rust reimplementation of Litestream v0.5.11 with the block format following LTX v0.5.2.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/lib.rs#L3-L13",
          "version": "repo-lines-v1:sha256:42f836c5aab710f1907aca4f7fcf364967cca174eb5fc6fa59c0912efa84fee2:"
        }
      ]
    },
    {
      "id": "claim_98a5124a9cb24221851689cfc0ea8723",
      "statement": "The db module owns the SQLite lifecycle (WAL-mode setup, the long-running read-lock checkpoint takeover, and the WAL-to-LTX capture loop); sync diffs the real WAL against the last LTX position and writes the next L0 LTX file with an atomic tmp-to-rename and a position cache, and the capture API is synchronous and owns the connection directly.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/db.rs#L1-L33",
          "version": "repo-lines-v1:sha256:5b386f83b498d1b40b5bd0d049d66fa3dc0616ba86ce80d0fea8d7e51b236f65:"
        }
      ]
    },
    {
      "id": "claim_ac33113b001049609f13785bc3a1f33f",
      "statement": "The WAL reader parses SQLite WAL frames and verifies salt and cumulative-checksum integrity, but does not enforce transaction boundaries, so honoring commit records is the caller's responsibility.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/wal.rs#L1-L10",
          "version": "repo-lines-v1:sha256:8ce39256cf1d6fdc3c6c1d2b878c8d3b640b414c2f453d9c7c1cd611722ec414:"
        }
      ]
    },
    {
      "id": "claim_808759a35e28482f95807494c90d62d1",
      "statement": "A Replica connects a managed Db to a ReplicaClient: sync copies each new L0 LTX file to the remote one TXID at a time, and restore downloads LTX files in TXID order, merges them, and reconstructs the SQLite file to a temp file that is fsync'd and atomically renamed; the scope is L0-only and single-replica.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/replica.rs#L1-L30",
          "version": "repo-lines-v1:sha256:8035ed3b777c68a245dd59e0ce527f43957c6b0bd0c77b9a281094a6a77fb9f0:"
        }
      ]
    },
    {
      "id": "claim_769705d2f7984f57b52344f78d23194c",
      "statement": "The compactor merges ordered LTX inputs into one byte-compatible LTX output while keeping one decompressed page per input rather than a database-sized page map.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/compactor.rs#L1-L8",
          "version": "repo-lines-v1:sha256:2a17e5e9fcb91d5439b738bb729f2c5e7509da57eabd290ad48274fca1250348:"
        }
      ]
    },
    {
      "id": "claim_67992ffe8cfd4cd38ca4841263692d3f",
      "statement": "Compaction levels are Litestream-compatible and the snapshot level is SNAPSHOT_LEVEL = 9.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/compaction_level.rs#L6-L9",
          "version": "repo-lines-v1:sha256:9a468b19fabc600a958234e62ed1bb78571040d1d0ee6f420a151c135f3c6cc1:"
        }
      ]
    },
    {
      "id": "claim_b26d3d4ff9c847bd8b34e4e66aa0c216",
      "statement": "A bundle is a celld-original envelope of verbatim L0 LTX files: concatenated raw L0 bytes, a binary footer of rows, the footer length as a little-endian u32, and a magic CLB1; at rest the bucket is pure Litestream and a drained bundle leaves no trace.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/bundle.rs#L1-L10",
          "version": "repo-lines-v1:sha256:5884a56a8120d442a62c6ce480c180b6161e7bde0d5c76a3ab9f55aac3945555:"
        }
      ]
    },
    {
      "id": "claim_a67a31f0ad2947ce9af088702d15c4cc",
      "statement": "An LTX v3 file is a 100-byte header, a page block, an empty page header terminating the block, a page index of varint tuples plus an end marker and a u64 size, and a 16-byte trailer, with all multi-byte integers big-endian.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/reference/ltx-format.md#L7-L23",
          "version": "repo-lines-v1:sha256:5e079b304c3527d4dbcff76e14ba279f1a63235eb56bec5fc7dbfe04e36ebc4d:"
        }
      ]
    },
    {
      "id": "claim_80f355fc719341fa936e785394cb7997",
      "statement": "The LTX header carries the magic LTX1, flags, page size, commit size, MinTXID, MaxTXID, a timestamp, the pre-apply checksum, WAL offset/size and salts, and a node id; a file is a snapshot when MinTXID == 1.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/reference/ltx-format.md#L25-L45",
          "version": "repo-lines-v1:sha256:6f96fa58ad94ec7790fbdc9161f5b04948a5220cec60a07ae8b74d1456cc9768:"
        }
      ]
    },
    {
      "id": "claim_27862ad8f5474b9693b31bdbebff01c4",
      "statement": "LTX checksums are CRC64-ISO with a ChecksumFlag OR-ed into every stored checksum, and a file is named <minTXID:016x>-<maxTXID:016x>.ltx.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/reference/ltx-format.md#L75-L93",
          "version": "repo-lines-v1:sha256:acd2ff11d31d4fc33409deb4cd6f8904de7c01889233172b362fd772d367b032:"
        }
      ]
    },
    {
      "id": "claim_c24cbf2f9ebc43dca3ae4cbd51324461",
      "statement": "The in-process replication backend uses one shared object_store client for the node and a managed celld_ltx::Db per resident cell; the object layout is cells/<cell>/ltx/e<epoch>/ in the bucket, and the backend carries the fleet's key prefix so two fleets sharing a bucket do not replicate over each other.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ltx_repl.rs#L3-L15",
          "version": "repo-lines-v1:sha256:c3a3f1761b142ca475824fff2038b7ab60b44826e1f0ee8f6ab5830a651f4ef6:"
        }
      ]
    },
    {
      "id": "claim_9681c594e3884cadb3574e453148a4db",
      "statement": "CELLD_LTX_COMPACTION (default 1) creates additive L1 objects so a takeover reads tens of objects instead of thousands and must be 0 in a mixed fleet until all nodes can read the block objects; CELLD_LTX_COMPACTION_MIN_TXIDS defaults to 256, CELLD_LTX_COMPACTIONS to 2, and CELLD_LTX_DURABILITY_TIMEOUT_SECS to 10.",
      "evidence": [
        {
          "resource": "repo://docs/README.md#L696-L699",
          "version": "repo-lines-v1:sha256:d2577b626ed2a2d69974e2e6af44fd7d46c9e30a024553ecd58959d0ee9deed5:"
        }
      ]
    },
    {
      "id": "claim_cf2798971d524302a5196f1386cfd588",
      "statement": "The replication backend caps concurrent cell uploads at 64, restore downloads across the node at 64, and a single compaction attempt at 256 source objects and 64 MiB of input.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ltx_repl.rs#L58-L75",
          "version": "repo-lines-v1:sha256:703b91bf1a0c4f982fc180241f28bbf7829d4658420854122c9d90054b46ab81:"
        }
      ]
    },
    {
      "id": "claim_01e81c11405d4e0ca80d514735801d6d",
      "statement": "The node-log tier streams per-cell L0 LTX segments that are captured but not yet uploaded to a small follower ensemble over the signed peer transport; a write acknowledges when every member holds its segment on disk or when the bucket upload proves it first, and a follower failure degrades the node to bucket-proof acks until a periodic re-recruit CASes a fresh ensemble.",
      "evidence": [
        {
          "resource": "repo://crates/celld/node_log.rs#L3-L23",
          "version": "repo-lines-v1:sha256:51e90bdc048f8cdba4cbdb2a7ebb4fa1e9b7b3b416dcba2c0ff410cb0e5bba47:"
        }
      ]
    },
    {
      "id": "claim_a7087564d638421fa26b669d9373f4c3",
      "statement": "log/<node>.json is the CAS-guarded root of truth for the ensemble and log epoch; it is created before the node's first fleet-durable acknowledgement and never deleted, so a takeover that finds no record may treat the bucket as complete.",
      "evidence": [
        {
          "resource": "repo://crates/celld/node_log.rs#L14-L18",
          "version": "repo-lines-v1:sha256:b9b5270c6067a1c226a62d00089b65111d653530aa8659d32f1c9e0368487484:"
        }
      ]
    },
    {
      "id": "claim_4e9780424fc64a11be005e35f8c071d4",
      "statement": "The log tier's load-bearing safety rules are: a follower's (ensemble, epoch) view changes only with the record; a follower refuses appends at or below its persisted seal mark; reconfiguration force-tiers the open fragment before the CAS; recovery seals before it certifies and certifies from a sealed member only; and the record is created before the first fleet-durable ack and never deleted.",
      "evidence": [
        {
          "resource": "repo://crates/logic/log_tier.rs#L13-L23",
          "version": "repo-lines-v1:sha256:0d294c9d15b2b172f304be818d4a6e1e16b326582cbee043dd3dc2c551e45056:"
        }
      ]
    },
    {
      "id": "claim_e095ca6982b44fa1b0c2cd7afa6861ce",
      "statement": "The folded node-log fields (state open/recovering/sealed, epoch, ensemble, tiered, active) travel inside the node lease record and every writer of the lease carries them through unchanged except the log tier itself and recovery.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ownership_store.rs#L57-L78",
          "version": "repo-lines-v1:sha256:1eae6a03b8bc691b29bb54dc42fd49474770b4d37667b847eb17a53c9f2613ba:"
        }
      ]
    },
    {
      "id": "claim_405c7c0deac942d1babbbdb60dd54c4b",
      "statement": "The gray-follower eviction policy evicts a follower when its windowed append-latency tail exceeds max(absolute budget, k times sibling median) sustained for a short window, or when a single append is outstanding past a hard backstop, and bounds flapping by rate-capping reconfigurations.",
      "evidence": [
        {
          "resource": "repo://crates/logic/log_evict.rs#L3-L18",
          "version": "repo-lines-v1:sha256:a5ea36c1602678225106f787bf85ce07714985911f6b312ed324ca6451c2b963:"
        }
      ]
    }
  ],
