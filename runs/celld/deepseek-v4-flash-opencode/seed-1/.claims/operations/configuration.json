  "claims": [
    {
      "id": "claim_8037df6f5c294df580e315f60a942094",
      "statement": "Environment parsing is strict: an unset variable selects its caller's documented default, a supplied variable must contain a valid value so a typo cannot silently change a running node's configuration, and validate() runs before any command or runtime work to cover every typed production variable.",
      "evidence": [
        {
          "resource": "repo://crates/celld/env_vars.rs#L3-L16",
          "version": "repo-lines-v1:sha256:358e8b2f96669f296f6d9b2cb79f7e04c471b3b76686cc40f19db1148d43a389:"
        }
      ]
    },
    {
      "id": "claim_79716ff6a2ff4214a8f4ed5515a931b2",
      "statement": "The command line resolves to exactly one Action (Run, Diagnose, Deploy, Dev, Cell, D1, Kv, Queue, Connect, Credentials, Token, Disconnect, Help, Version), and stdout_is_data is false only for Run, Dev, Help, and Version so that a CLI subcommand's stdout carries its answer while a node's stdout is its log.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main/cli.rs#L31-L71",
          "version": "repo-lines-v1:sha256:08e59fa30554e4777062bf9efbd7553d5d476c72b0bdf5e6e3c1a3bc1d740f41:"
        }
      ]
    },
    {
      "id": "claim_50614a97e92241dbad4917603e1d6b15",
      "statement": "Listener resolution refuses two shapes: an explicit non-loopback --listen (or CELLD_ADDR) requires an explicit --internal-listen, and --advertise (or CELLD_ADVERTISE) requires an explicit --internal-listen because the default internal listener uses a random loopback port.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main/cli.rs#L230-L247",
          "version": "repo-lines-v1:sha256:caec02cf504512a1ad7784a237075bdc4d8afe69e05592cad42f92ab309be7e0:"
        }
      ]
    },
    {
      "id": "claim_9cfa926385e04daf985ad4017377ce78",
