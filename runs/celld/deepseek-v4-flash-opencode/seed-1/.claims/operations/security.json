  "claims": [
    {
      "id": "claim_36c9c095acdb42a0b56d8d2c38f46c8a",
      "statement": "celld is an alpha not safe for hostile multi-tenant use: one fleet runs one application and trusts the application code, fleet nodes, and operators; it depends on a trusted private network protecting the internal listener and object-storage credentials controlling the fleet, and the internal listener defaults to a loopback ephemeral port with --advertise giving peers a reachable address.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L3-L35",
          "version": "repo-lines-v1:sha256:db834b9107e367d7fc979d5a0a09c7ed2c62c34cc31478758dab2fe00188bc1e:"
        }
      ]
    },
    {
      "id": "claim_31823f4f800f4c71988532c957a15454",
      "statement": "bind_internal_listener rejects a literal public advertised IP unless --unsafe-public-advertise is set, requires --advertise when --internal-listen uses an unspecified address, and cannot verify a hostname or a translated port.",
      "evidence": [
        {
          "resource": "repo://crates/celld/startup.rs#L221-L255",
          "version": "repo-lines-v1:sha256:ad2ae0d22053b06037a2c99548437b800a1e8b0446f8a2510db88f1a114710e3:"
        }
      ]
    },
    {
      "id": "claim_1c77fc21e0224a199751fcd9323d9635",
      "statement": "A signed peer request carries source, target, timestamp, nonce, body-sha256, and signature headers; the signature is HMAC-SHA256 over a canonical string of the method, path, body hash, source, target, timestamp, and nonce.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L247-L269",
          "version": "repo-lines-v1:sha256:148a74f4d6038771d831e36339c48dd065bbcd873e6ef36611f10b03e916a2d7:"
        },
        {
          "resource": "repo://crates/celld/peer_auth.rs#L31-L36",
          "version": "repo-lines-v1:sha256:9a4589bb276a369fb844937cc611de7e060e0ad864c160c3a7b85d6c6540488a:"
        }
      ]
    },
    {
      "id": "claim_83fec4b68a7642cd9c5e8fe73bdb35a3",
      "statement": "Peer verification enforces a well-formed identity charset (a security fence), a 30-second clock window, a body hash matching the actual body, the protocol version header, and a bounded per-nonce replay cache that retains entries at least as long as their signatures stay acceptable.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L178-L245",
          "version": "repo-lines-v1:sha256:0bf5cd50758a1e76304da51312ea4afc3fa76d07304716841211bd49e425176e:"
        },
        {
          "resource": "repo://crates/logic/peer.rs#L1-L13",
          "version": "repo-lines-v1:sha256:a18e147bf9a65e9bff9eef51c9e1b6ab7c917db485fdc17a3a9869a346722000:"
        }
      ]
    },
    {
      "id": "claim_8175127058c5430191fd9cb009f34c65",
      "statement": "The fleet HMAC secret is stored at fleet/peer-auth.json in the bucket and the first current node creates it with a conditional write; it is versioned and its contents are never exposed.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L272-L292",
          "version": "repo-lines-v1:sha256:47e5f74a190776adc9f7a76e9129da4d34a195e2b77726fed9ba61e19937abec:"
        }
      ]
    },
    {
      "id": "claim_c3c2fcfec3544a1a8645252d8de8c019",
      "statement": "Every proxied cell call crosses inside one tunneled connection per peer that carries plain HTTP; establishment is an h1 upgrade on /peer/tunnel gated by the fleet HMAC, per-call control rides x-cells-* inner headers that the forwarding node overwrites and the receiving node strips, and idle tunnels are pooled and reused for sequential calls.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main/peer_tunnel.rs#L3-L70",
          "version": "repo-lines-v1:sha256:26ec7567ee8d23e796273b7a1dd22a7985662b5273988176fd6f68ed7efbaa8b:"
        }
      ]
    },
    {
      "id": "claim_a79c929a6c9b4fa289beee33e3c9462a",
      "statement": "The tunnel permits a request body to stream to the owner, so the fleet HMAC cannot sign an individual call; the establishment signature decides who can open a tunnel, and because a tunneled call can address a runtime class, every path to a runtime class demands the fleet secret.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L70-L76",
          "version": "repo-lines-v1:sha256:279ecefb31c67752e2a478f61cb25671d9f046dff315d818f6e873a53340d3ae:"
        }
      ]
    },
    {
      "id": "claim_7ee62873ab844199b8a00bcc32e6017c",
      "statement": "celld diagnose probes are challenge-bound: the diagnostic generates a 32-byte challenge and the node responds with an ed25519 signature over it, and each node advertises its probe public key in its lease so the proof names the exact node reached.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_probe.rs#L6-L50",
          "version": "repo-lines-v1:sha256:8a38769d32b261fb4e4251c2791bcef984547c2235e2fd4a5d60ac09ccec6c49:"
        }
      ]
    },
    {
      "id": "claim_46930ba2069e46a89f70523828e9f19b",
      "statement": "The internal operator API serves unauthenticated routes (/state, /cell, /evict, /do, POST /shutdown), and /do/<ID> refuses every reserved runtime class (D1, Workflows, KV, Queues), which must use the HMAC-authenticated /runtime/<SCOPE> route instead.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L82-L99",
          "version": "repo-lines-v1:sha256:1f028f9bb72bff4ba9020cf7273e76b9b39ae92b78218f8b24c1e4cbe428b621:"
        }
      ]
    },
    {
      "id": "claim_7ce6fcef297c4a30a6a47c663eaebda0",
      "statement": "X-Forwarded-Host and X-Forwarded-Proto are ignored unless --trust-forwarded-headers is set; celld always takes the path and query from the request target, validates the Host header with a celld.local fallback, and the public Worker listener and /do have a 1 GiB body limit returning 413.",
      "evidence": [
        {
          "resource": "repo://crates/logic/http.rs#L1-L13",
          "version": "repo-lines-v1:sha256:e3b507b46804bd318eac947fdccc9427cfcbfa257c45433ebb6c398b2c912d33:"
        },
