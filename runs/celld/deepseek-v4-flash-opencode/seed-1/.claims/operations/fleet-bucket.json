    {
      "id": "claim_ac81855aa11a41f09032a4aa27895d19",
      "statement": "celld dev uses a persistent local object store backed by SQLite in which a conditional update checks its ETag and installs the new object in one commit; it is local to one development machine, is not a shared-filesystem production mode, and a regular node or operator subcommand cannot select it.",
      "evidence": [
