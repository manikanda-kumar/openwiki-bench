    {
      "id": "claim_132cd23e74b8488488265241d5a8bc04",
      "statement": "Bucket is the engine's single object-store client holding the ObjectStore, a PaginatedListStore for bounded listings, and a dedicated cas_store; every Bucket::open builds its own HTTP transport, and the node-lease client is built on its own connection pool so lease traffic never queues behind ownership, deployment, or replica requests.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L140-L167",
          "version": "repo-lines-v1:sha256:1abaf077a212ef310d23fbfcd898cb565bc5e9b045a96dc1562041101674dbd7:"
        },
        {
          "resource": "repo://crates/celld/fleet.rs#L118-L131",
