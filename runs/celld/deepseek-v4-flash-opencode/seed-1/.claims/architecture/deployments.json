    {
      "id": "claim_d77fbe754b894b38bf48db87eda8b138",
      "statement": "celld deploy publishes in a careful order: queue attachments are read first, asset bodies finish before the asset index and manifest, attachments publish after the prefix is complete, and the named pointer deploy/<script>/current.json then the fleet-wide deploy/current.json move last; pointers are written with a compare-and-swap so a concurrent deploy produces a loser, not a lost write.",
      "evidence": [
        {
          "resource": "repo://crates/celld/deploy.rs#L561-L621",
          "version": "repo-lines-v1:sha256:59261e8c47d495d26029aca9416bc94485ce6396aa5519b7e85b737efc82a97d:"
