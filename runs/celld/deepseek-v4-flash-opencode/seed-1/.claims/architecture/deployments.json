        }
      ]
    },
    {
      "id": "claim_97b2e9eff0bb435597ec1b7e3155a6ed",
      "statement": "A push queue has exactly one consumer script, recorded at deploy/queues/<queue>/consumer.json as an attachment naming an exact deployment; the attachment is written conditionally after the deployment prefix is complete and a competing consumer script is a deploy refusal.",
