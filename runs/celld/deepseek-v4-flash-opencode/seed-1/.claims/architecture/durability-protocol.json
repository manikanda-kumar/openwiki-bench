        }
      ]
    },
    {
      "id": "claim_37d39a4d06fd44968894259eb99728b3",
      "statement": "fence_node sets NodeAuthority::Fenced and emits Effect::Halt with code 3; the fence stops each active cell, fails every uncompleted request with NodeFenced, and drains every output gate to a failed response atomically, writes nothing to the bucket, and is terminal until a restart.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L2810-L2817",
          "version": "repo-lines-v1:sha256:b14fbf93e3e005bc05bc1b37aebf69e668d3b0425c46f9084a0db08fa8826a68:"
