  "claims": [
    {
      "id": "claim_a731db6b845a4ed3a3673b2b1cc1ec30",
      "statement": "A cell scope names one Durable Object as `Class:instance`; `valid_cell_scope` admits only ASCII alphanumerics plus `_ - . : $`, at most 255 bytes, and rejects `.` and `..`, making the scope safe as a single path component and object-store key.",
      "evidence": [
        {
          "resource": "repo://crates/logic/cell.rs#L18-L51",
          "version": "repo-lines-v1:sha256:ca293fbf78885ec34d1065e08ea7228425be99e9f00ef74ce9d01e61d18fb803:"
        }
      ]
    },
    {
      "id": "claim_a6bdc7f654db4becadc00f91aa85e4bb",
      "statement": "The decision core maps cell phases onto Cloudflare Durable Objects states: Resident (active or idle in memory), Dormant (out of memory but still owned; hibernated when hibernatable sockets survive), and Inactive (out of memory and owned by nobody, the initial state of every cell).",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L98-L111",
          "version": "repo-lines-v1:sha256:76f2ef16c8ea598a67fa28e0466bd9b528e57ce4f5f724303e2e59c98999b8db:"
        }
      ]
    },
    {
      "id": "claim_b66118922f174c93b4fc6f776bad375b",
      "statement": "The full `Phase` enum adds the in-flight activation and eviction phases (WaitingActivation, ReadingOwner, ReadingNodeLease, RecoveringOwnerLog, ReadingCapacity, WaitingCapacity, Acquiring, ReconcilingAcquire, Restoring, Starting, Publishing, EnsuringDurability, Cleaning, Dormant, Adopting, Resident, Remote, Fenced), and `phase_name` publishes stable short names that `/state` and `celld diagnose` report.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L113-L190",
          "version": "repo-lines-v1:sha256:f68255aeb75be45c7dd346b0c6462df455938d814b2cc4b8d48dba818b166552:"
        },
        {
          "resource": "repo://crates/logic/lib.rs#L214-L240",
          "version": "repo-lines-v1:sha256:2784119a349944f22e98d6f9d9876e374a3e653c9d6c37709aefbc48538dff83:"
        }
      ]
    },
    {
      "id": "claim_bd65b09967e048469c4cc68fbbefdfe3",
      "statement": "A cell is hibernated exactly when it is Dormant and still holds a hibernatable WebSocket; `is_hibernatable` is a resident cell doing no work and holding nothing that must survive in memory, and such a cell is the only kind eviction will take.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L1410-L1438",
          "version": "repo-lines-v1:sha256:4e831a1adab9f531ebecd40f484383b0c975e0c15e4fe5eaa4d88e67a5bc2e47:"
        }
      ]
    },
    {
      "id": "claim_dd97167cfd404b0e945705ff3fa1bc0e",
      "statement": "Each cell has one ownership record in the bucket at `cells/<cell>/own.json` naming the owner node's session and a fencing epoch; a node acquires the cell with a conditional write so the object store accepts exactly one acquirer.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ownership_store.rs#L288-L420",
          "version": "repo-lines-v1:sha256:e934983f1db214fae113788119255b039e63217029245257e9aa51a03bddb451:"
        }
      ]
    },
    {
      "id": "claim_f515f966b3624004818bebb03d6188c8",
      "statement": "A request to a cell routes Local when the cell is resident, Remote when a cached owner record names another node, and otherwise queues a cold activation; a request on a node that is not node-authoritative fails with `NodeUnavailable`.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L2819-L2960",
          "version": "repo-lines-v1:sha256:3657164a45ae01d020183325086710e7edea4587805ae7b0d246b8c87607d701:"
        }
      ]
    },
    {
      "id": "claim_53d9386320fe40fba945b9d1b2df0d12",
      "statement": "A failed remote dispatch may be re-sent only when the connection was never established (`NeverConnected`) or the peer said it no longer owns the cell (`NotOwner`); every other failure is `Ambiguous` and fails the caller, because the owner may have run the request. Each recoverable class gets one retry.",
      "evidence": [
        {
          "resource": "repo://crates/logic/routing.rs#L20-L60",
          "version": "repo-lines-v1:sha256:420e80f21e58996724c447a1d08bb337f3e58238f9248d438143dd5a69e04675:"
        }
      ]
    },
    {
      "id": "claim_60842d58da674b569694403312fbb30c",
      "statement": "A top-level Worker fetch runs on a resident isolate only when that isolate is idle, and is otherwise rescheduled to the stateless Worker pool, never run nested; the core selects the resident by round-robin over idle non-quiescing resident cells.",
      "evidence": [
        {
