    },
    {
      "id": "claim_b4b9330e5c9544cdbb65d82e1ae73be7",
      "statement": "Cold activation is gated by `max_activations`: a cell that cannot take a permit joins a FIFO activation waiter queue, and waiters are admitted one per freed permit so no arrival pattern can starve a waiter.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L1578-L1635",
