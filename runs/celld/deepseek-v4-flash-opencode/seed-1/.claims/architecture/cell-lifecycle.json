    {
      "id": "claim_2b8022c1947146f982ba22e1cef8d3d5",
      "statement": "Residency admission is a hard cap: `has_capacity` is `occupied < max_resident && !shedding`, so a node at its cell cap refuses more work rather than shedding a live cell, and the only sampled fact that refuses admission is memory pressure.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L1369-L1377",
          "version": "repo-lines-v1:sha256:324a5af1f21248e75835f8599c364b284934ac55302a65d2043544c8e2605b68:"
        }
