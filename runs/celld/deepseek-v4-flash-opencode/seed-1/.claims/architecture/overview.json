    {
      "id": "claim_bf8e04d20af04ce9a8ac5283573dd475",
      "statement": "The workspace is split so that crates/logic owns all behavioral state and decisions while crates/celld is only an effect executor and adapter host; crates/celld depends on both celld-logic and celld-ltx, and the dependency direction is always toward the pure core.",
      "evidence": [
        {
          "resource": "repo://Cargo.toml#L1-L6",
          "version": "repo-lines-v1:sha256:9501701014fd210b5f13bbb744e253dbc7ff477b1a6521371b4a06dca1165019:"
        }
      ]
    },
    {
      "id": "claim_136d1caf1db4410b97b00ed38f6f3cd3",
      "statement": "celld-logic is a pure decision library with no async, I/O, clocks, randomness, locks, or dependencies — its manifest declares no dependencies at all.",
