    },
    {
      "id": "claim_110eaa70abe04460914f950b84639ff1",
      "statement": "celld-ltx is an in-process SQLite to object-store replication library vendored from Litestream and LTX and evolved by celld; it captures WAL data as LTX segments, reads and writes replica storage, restores databases, and compacts levels.",
