    {
      "id": "claim_c903fa701d0a4b8cb993667bcdc283f2",
      "statement": "Every asynchronous effect is versioned by an operation id, and completion events with an obsolete op are ignored, so late completions cannot corrupt a newer decision.",
      "evidence": [
        {
          "resource": "repo://crates/logic/types.rs#L737-L739",
          "version": "repo-lines-v1:sha256:a0cd7a81f010a3c22f88777ad5de371d239c0cca69b8302917489deedeea8502:"
        }
