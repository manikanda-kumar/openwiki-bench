  "claims": [
    {
      "id": "claim_1e0ca49bf88b436983517d3f2ba390f4",
      "statement": "celld is not safe for hostile multi-tenant use: one fleet runs one application, and celld trusts the application code, the fleet nodes, and the operators.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L3-L10",
          "version": "repo-lines-v1:sha256:931aa5e2f951044f306efed6d574a0c41d16abf6d2986fa756516fee848e2be4:"
        }
      ]
    },
    {
      "id": "claim_7bd972eb7b10448cb2ec3b6269dc200c",
      "statement": "celld depends on two external security boundaries: a trusted private network protecting the internal listener, and object-storage credentials that control the fleet.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L13-L18",
          "version": "repo-lines-v1:sha256:7db00d70deef36aa090e544202181f33fab53b28170a5b3883b0cdf86cfd6d69:"
        }
      ]
    },
    {
      "id": "claim_4e9e6a1e1a2c499db646b5b2f52989c1",
      "statement": "The public listener serves the deployed Worker and the internal listener serves the peer protocol and operator API (defaulting to 127.0.0.1:0); an explicit advertised address requires an explicit internal-listener address, and celld cannot verify a hostname or translated port.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L20-L38",
          "version": "repo-lines-v1:sha256:eb6ece37fc6d9e7f879fcf2b617c0fe4aac28a5db0a91fadcbb4f27997223d60:"
        }
      ]
    },
    {
      "id": "claim_186ba9968e9143b8aa49ed9c6818d315",
      "statement": "The internal listener has three request groups: unauthenticated operator routes, the /peer/tunnel establishment carrying the fleet HMAC with inner calls unsigned, and peer-control and reserved-cell /runtime/ routes authenticated with the fleet HMAC, a clock limit, and replay protection.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L55-L76",
          "version": "repo-lines-v1:sha256:0e556de591f2b9a319117c7a8f76b3ad91ac233187515a5fdc1cdf1e8fe88f3f:"
        }
      ]
    },
    {
      "id": "claim_0633fdb701fa4eda87fa74231306f60c",
      "statement": "Peer-control requests authenticate with an HMAC-SHA256 over a canonical request (method, path and query, body hash, source, target, timestamp, 16-byte nonce), and the fleet secret lives in the bucket at fleet/peer-auth.json, created by the first current node.",
      "evidence": [
        {
          "resource": "repo://README.md#L196-L200",
          "version": "repo-lines-v1:sha256:87a978db94dbec6e25c3bfb690e294d6cb1464e1e7b2a0357e6292407c13d3d5:"
        },
        {
          "resource": "repo://crates/celld/peer_auth.rs#L38-L63",
          "version": "repo-lines-v1:sha256:cd6f1e16228a9923c7cdeb4c71952f55a18aa3f8a2368f783df34207ad0cf3b2:"
        }
      ]
    },
    {
      "id": "claim_22ff449491d64e9982ec7a8e00b8d803",
      "statement": "Peer authentication enforces three pure security fences: an identity charset of ASCII alphanumerics plus _ - . at most 128 bytes, a two-sided clock window of 30 s, and replay-cache retention pinned at twice the clock window.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L23-L28",
          "version": "repo-lines-v1:sha256:d6671e1d41c5af8e0ff99a6f493dfee39a92913d3fc81e0b6c7ca8452e35c794:"
        },
        {
          "resource": "repo://crates/logic/peer.rs#L14-L23",
          "version": "repo-lines-v1:sha256:3dc093c5bb5f76dff0c82bd4d38797912e4659c1d45d408862a99e1110fced0c:"
        },
        {
          "resource": "repo://crates/logic/peer.rs#L25-L37",
          "version": "repo-lines-v1:sha256:44da0488196d5d9d46ee69cfac5fa69bf27874b64534a5059f1ab666e656e2ac:"
        }
      ]
    },
    {
      "id": "claim_a721008ecf8744ee856a435b2cc47fcc",
      "statement": "celld ignores X-Forwarded-Host and X-Forwarded-Proto by default, uses the last value in each header when a trusted proxy is configured, always takes the path and query from the request target, and does not make an unchecked hostname trustworthy for authorization.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L105-L124",
          "version": "repo-lines-v1:sha256:273eef26928edaa5fc2a833d89b5d7dca268cd1d18d881598ae597485c526117:"
        }
      ]
    },
    {
      "id": "claim_dc7581663913424cb9479f83283e3954",
      "statement": "The public Worker listener and /do/<ID> have a 1 GiB request body limit by default (CELLD_MAX_REQUEST_BODY_BYTES) and return 413 for an oversized body.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L126-L135",
          "version": "repo-lines-v1:sha256:ecb070d98423e69f8f9154c4b712e70c4ade512c2daea20b52e509050cadb05d:"
        }
      ]
    },
    {
      "id": "claim_37c99f08d3824bf0bd3ce3dedd9d8e96",
      "statement": "The fleet bucket is the root of authority: it stores deployments, cell state, ownership records, node leases, and the shared peer secret, and a holder of its credentials controls the fleet; per-cell epoch fencing protects storage consistency but does not isolate hostile applications.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L137-L155",
          "version": "repo-lines-v1:sha256:f99f26d0236d80d6e0f3e39e47e3c6bbed866df75f68a89863a971b99c88e4e6:"
        }
      ]
    },
    {
      "id": "claim_7e2943ee4575442c96c0aa60fcd92ea9",
      "statement": "celld does not terminate TLS on either listener.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L78-L80",
          "version": "repo-lines-v1:sha256:313dc5f41c68058ef5dfd3f4f1ab336fc82ed329893c9c8b641c8b383c83cf2f:"
