          "version": "repo-lines-v1:sha256:dfcd49adea08af097c5aa02060e6ec23ebf61f000fc809f8d69a303db0713e70:"
        }
      ]
    },
    {
      "id": "claim_e8d3f358816044bebffc45398504a721",
      "statement": "Adapter futures never borrow core state; they send versioned completion events back through the actor's mailbox.",
