        }
      ]
    },
    {
      "id": "claim_38156e8d5a2943f0814c3b3b313262d0",
      "statement": "The conformance harness runs each Workers and Durable Objects program twice, once on workerd and once on celld on identical bytes, and requires the outputs to be equal.",
