          "version": "repo-lines-v1:sha256:d48f3f630de3083d1f3b811813ee01751ba1cb7114cec00286e59f37d1b71530:"
        }
      ]
    },
    {
      "id": "claim_9880c2d4ce5f4dda8656ecc9d094120b",
      "statement": "Without a trusted proxy the Host header controls the hostname in request.url; celld accepts a hostname, IPv4, or bracketed IPv6 with optional port, rejects malformed values, and uses celld.local when no source gives a valid host.",
