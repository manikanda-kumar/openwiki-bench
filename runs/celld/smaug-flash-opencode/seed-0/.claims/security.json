  "claims": [
    {
      "id": "claim_d52ac93ec1064385906001f3e7dbf061",
      "statement": "celld trusts the application code, the fleet nodes, and the operators; it is not safe for hostile multi-tenant use, and security fixes apply to the latest release only.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L3-L12",
          "version": "repo-lines-v1:sha256:527aadab3085ed77e0ba1e9e86f6050df8460764231978cba9e21b0105358ef9:"
        }
      ]
    },
    {
      "id": "claim_8c9630e1a5b6401f8a18041955fa5311",
      "statement": "celld depends on a trusted private network and object storage credentials as its external security boundaries, and does not terminate TLS on either listener.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L13-L18",
          "version": "repo-lines-v1:sha256:7db00d70deef36aa090e544202181f33fab53b28170a5b3883b0cdf86cfd6d69:"
