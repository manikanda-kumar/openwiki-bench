        }
      ]
    },
    {
      "id": "claim_12a4cfad0316470191d70728f85642d5",
      "statement": "The peer-authentication identity charset restricts source and target to non-empty ASCII alphanumerics plus _ - . at most 128 bytes, so a target cannot smuggle a path segment past the WrongTarget check.",
      "evidence": [
        {
          "resource": "repo://crates/logic/peer.rs#L17-L22",
          "version": "repo-lines-v1:sha256:049d3cf81f89e85ba83d5b475dcdcd7de6c45a22fb9bf4a19a61a038a7b5f254:"
        }
      ]
    },
    {
      "id": "claim_951779c891004347a0d7b46ae3aa2e5d",
      "statement": "The unauthenticated internal operator routes are /state, /cell/<SCOPE>, /evict/<SCOPE>, /do/<ID>, and POST /shutdown; the /do/ route refuses every reserved runtime class, which instead route through the HMAC-authenticated /runtime/<SCOPE>.",
      "evidence": [
