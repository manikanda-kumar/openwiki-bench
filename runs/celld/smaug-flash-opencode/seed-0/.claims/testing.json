    {
      "id": "claim_a186b3e167d3468a8130145654c61852",
      "statement": "The project records its own failure edges instead of tuning them away, notably reserve headroom: a fleet full to its resident limit has no space for a lost node's cells, so a failure of more than one node at the limit degrades the service.",
      "evidence": [
        {
          "resource": "repo://docs/testing.md#L188-L199",
          "version": "repo-lines-v1:sha256:dbf3ae787dc0c28bd767382367dc5eb0df3b295ba2ade396b9589ae09bec8ef8:"
