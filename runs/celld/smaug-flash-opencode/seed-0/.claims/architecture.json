        }
      ]
    },
    {
      "id": "claim_07d12895a74f4d8a80f54e46f3470a11",
      "statement": "The output gate is one choke point every egress passes through, and it withholds a response until every write it can reveal is proven durable, which is the RPO=0 guarantee.",
