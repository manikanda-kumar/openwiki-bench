    {
      "id": "claim_31fb33984518495a9eff7a4bccba5368",
      "statement": "Fenced or lagged runtime operations are tracked by the core (retired_runtime_ops and timed_out_runtime_starts) so their late completion triggers compensating cleanup rather than being ignored.",
