    {
      "id": "claim_bff3968452f04991814d40541d31d550",
      "statement": "`Replica` drives two halves of replication: sync copies each new L0 LTX file up to the remote replica advancing the replicated position one TXID at a time, and restore downloads LTX files in TXID order, merges them with the compactor, and reconstructs the SQLite file to a temp file that is fsync'd and atomically renamed into place.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/replica.rs#L4-L16",
          "version": "repo-lines-v1:sha256:d3b07712730b28140b79a023830993b590a2447f08345dbca4ea354e43a4c716:"
        }
      ]
    },
    {
      "id": "claim_07d0176019714d22961f9b3c034312f0",
      "statement": "The restore-plan calculation honors a target TXID and probes the snapshot level first so it stays a faithful port that works when compaction is added; the current scope is L0-only and one-shot.",
      "evidence": [
        {
          "resource": "repo://crates/ltx/src/replica.rs#L18-L36",
