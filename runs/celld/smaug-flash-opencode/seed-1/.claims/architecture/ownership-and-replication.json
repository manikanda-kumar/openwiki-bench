    {
      "id": "claim_41577f0aecb747bf859e12ddbd1bfb5b",
      "statement": "A follower failure degrades the node to bucket-proof acks until a periodic re-recruit CASes a fresh ensemble; recovery gathers from every reachable sealed member and requires at least one.",
      "evidence": [
        {
          "resource": "repo://crates/celld/node_log.rs#L20-L23",
