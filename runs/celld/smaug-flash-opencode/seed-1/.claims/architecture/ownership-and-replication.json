          "version": "repo-lines-v1:sha256:9de8b9ec811eceab245bb8dd6056cb7030280a92b345a14f45fdd907a4488459:"
        }
      ]
    },
    {
      "id": "claim_ee3c5a6ed30c40339e1e336c2177797f",
      "statement": "Each node holds a self-lease in the bucket carrying the node, expiry, address, peer protocol, generation, folded node-log state, and published load; the node renews after one third of the TTL and a renewal that does not reach the bucket does not fence it.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ownership_store.rs#L32-L55",
          "version": "repo-lines-v1:sha256:2786f0103cbe1cf4e7c252ddd6586a13770c32502e1cfa5b01c1c4cb13a9cb58:"
