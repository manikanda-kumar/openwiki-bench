        }
      ]
    },
    {
      "id": "claim_8a6b69053644461fa823ebbc5680f21b",
      "statement": "Node authority is evaluated in the decision core (not the adapter) by `State::node_authoritative`, which compares the remembered monotonic clock against the record's expires_ms.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L723-L737",
          "version": "repo-lines-v1:sha256:de89841df3b60496418ce2ecfce0eb8879486320d98605a899a24d7e4e3dcad6:"
        }
