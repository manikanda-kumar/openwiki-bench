    },
    {
      "id": "claim_4462d44372bc4d07a9d7b4c7111cfd7b",
      "statement": "A node picks its followers from the other nodes in the fleet and never counts itself, so a fleet needs two running nodes before any node can complete a fleet proof; `CELLD_DURABILITY=fleet` is the default.",
      "evidence": [
        {
          "resource": "repo://docs/guarantees.md#L151-L167",
