    {
      "id": "claim_23b6bea24d424b2d92a22cb1a3a7e71e",
      "statement": "The fleet path in `crates/celld/node_log.rs` streams captured-but-not-yet-uploaded L0 LTX segments to a small follower ensemble; a write acknowledges when every member holds its segment on disk (write-all, ack-all) or when the ordinary bucket upload proves it first, whichever wins.",
      "evidence": [
        {
          "resource": "repo://crates/celld/node_log.rs#L3-L12",
