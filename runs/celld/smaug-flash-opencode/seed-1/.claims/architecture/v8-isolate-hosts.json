        {
          "resource": "repo://crates/celld/js/bootstrap.rs#L3-L17",
          "version": "repo-lines-v1:sha256:28af0d1860eeb23fcb5f4cb7e070bec293c228c4b4df4f5d01f7a2722459f982:"
        }
      ]
    },
    {
      "id": "claim_51edd66a580c4ac8a01fe543675792d2",
