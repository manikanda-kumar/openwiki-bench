        }
      ]
    },
    {
      "id": "claim_8cd3f904a699415bb9c2a1c46a53d5d5",
      "statement": "The eviction victim is chosen by `shed_candidate` preferring the isolate closest to empty, because only the cut that takes an isolate's last cell returns the whole heap; a cell with an imminent uncovered alarm or a live transport is not shed.",
      "evidence": [
