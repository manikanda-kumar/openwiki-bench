    {
      "id": "claim_ea0a98c5c9ec43d690b36b25b8b86574",
      "statement": "`CELLD_PRESSURE_OWNERSHIP` selects release (default) or sticky ownership on eviction and `CELLD_TTL_MS` (default 10000) sets the node-lease lifetime.",
