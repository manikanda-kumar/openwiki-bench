    {
      "id": "claim_d417b53f765d4bac9a3252ad88002f86",
      "statement": "The `/do/<ID>` route refuses every reserved runtime class (D1, Workflows, KV, Queues); their operator protocols use the HMAC-authenticated `/runtime/<SCOPE>` route instead.",
      "evidence": [
