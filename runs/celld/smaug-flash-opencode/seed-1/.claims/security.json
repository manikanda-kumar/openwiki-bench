    {
      "id": "claim_1b98d4c395e943318e6810b06374cb23",
      "statement": "The internal listener has three request groups: unauthenticated operator routes, the `/peer/tunnel` route whose establishment carries the fleet HMAC for opens and whose inner calls are plain HTTP and unsigned, and the peer-control and reserved-cell routes that use the fleet HMAC.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L55-L80",
          "version": "repo-lines-v1:sha256:c5c37472913b6b3b6162bbb87daf99fbb8b13d4a51956d59e787501df0909973:"
        }
      ]
    },
    {
      "id": "claim_daebfddfe3bc4d1aa55068ec51cff434",
      "statement": "`PeerAuth` signs a canonical request binding the method, path-and-query, body SHA-256, source/target node, a near-current timestamp, and a fresh nonce; verification applies a 30-second clock window and a replay cache of up to one million entries.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L136-L174",
