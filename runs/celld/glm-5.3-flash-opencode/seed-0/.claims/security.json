    {
      "id": "claim_fa5189fec5df48bb9e32727a1a4d9dbc",
      "statement": "celld is alpha, not safe for hostile multi-tenant use; it trusts its own application, nodes, and operators, and depends on exactly two external boundaries: a trusted private network over the internal listener and bucket credentials restricted to one fleet bucket.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L1-L19",
          "version": "repo-lines-v1:sha256:f1e8305f3fa73902f9482fedd3588d398570fa68100f05e6670910bc8b584b36:"
        }
      ]
    },
    {
      "id": "claim_b6722e91efe44e0cb65bf8c530483e21",
      "statement": "The fleet bucket is the root of authority (deployments, cell state, ownership leases, node leases, peer secret); whoever holds its credentials controls the fleet.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L135-L145",
          "version": "repo-lines-v1:sha256:116a3e114f0ef36f6928e9091f44b9ed7bf2a2af29edb51caa6a16369074f6f6:"
        }
      ]
    },
