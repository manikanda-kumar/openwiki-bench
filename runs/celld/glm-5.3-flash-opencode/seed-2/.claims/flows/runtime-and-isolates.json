          "resource": "repo://crates/celld/js.rs#L5-L14",
          "version": "repo-lines-v1:sha256:806abbdf0782d12bf6793844d633e373112eb34a02c3ac6221584df1aeef5ef6:"
        }
      ]
    },
    {
