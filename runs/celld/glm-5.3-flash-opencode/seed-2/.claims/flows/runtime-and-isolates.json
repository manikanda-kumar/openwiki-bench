    {
      "id": "claim_71c800f8611848a5b8c430480b412ddf",
      "statement": "RuntimeManager is the Actor's V8 cell-runtime boundary: it holds the generations lock (a reader takes one snapshot and never holds the lock across an await), the cell registry, the alarm reporter, a RemoteRequestRegistry whose tombstone and cell enqueue share one lock so a peer abort arriving before the forwarded fetch cannot lose cancellation, the data dir, replication, wake flusher, and admission limits.",
      "evidence": [
        {
          "resource": "repo://crates/celld/runtime.rs#L469-L507",
          "version": "repo-lines-v1:sha256:54909daec34c276c63d60fc47712c9eed4910279cea240f1adee15827ebd4356:"
        }
