  "claims": [
    {
      "id": "claim_43f96ab3d89f4989adf691d5eb3121a1",
      "statement": "celld deploy builds a Wrangler project and writes it to the fleet bucket; bundling is esbuild's job while deploy.rs handles config, identity, and durable publication, never shelling out to wrangler or speaking a Cloudflare API, and unmodeled config keys are refused rather than silently dropped.",
      "evidence": [
        {
          "resource": "repo://crates/celld/deploy.rs#L10-L16",
          "version": "repo-lines-v1:sha256:780edff0f616c4a45ab80a17cd5e65f9499782f1172fd5708c3ad02ad4dd0061:"
        }
      ]
    },
    {
      "id": "claim_6d93cbca90454f74920b4937860605ed",
      "statement": "Worker projects require esbuild on PATH; asset-only projects do not.",
      "evidence": [
        {
          "resource": "repo://crates/celld/deploy.rs#L193-L201",
          "version": "repo-lines-v1:sha256:f48fb5d8645b374f0abfdb9df791988949accb93d2f6d46eaf4b4fce7cb5dae7:"
        }
      ]
    },
    {
      "id": "claim_5c73b437d03843619a370a305e4f9de5",
      "statement": "The normalized deployment manifest manifest.json is the only interface between deployment tools and celld; protocol::Manifest carries schema_version, version, script_name, modules, DO classes and SQLite-backed classes, assets, cron expressions, and queue consumers.",
      "evidence": [
        {
          "resource": "repo://crates/celld/protocol.rs#L15-L44",
          "version": "repo-lines-v1:sha256:df569d5cfb4ac6dc43a5adab18a0ab5d1a10b4ccde66b014e676442e43e5939d:"
        }
      ]
    },
    {
      "id": "claim_b0361b0de55a4d2b9f1a5c3afc047397",
      "statement": "Deployment identity is defined by sorted module contents plus serialized metadata, never by raw upload framing, so identical code deploys as the same version identity regardless of transport.",
      "evidence": [
        {
          "resource": "repo://crates/celld/protocol.rs#L413-L415",
          "version": "repo-lines-v1:sha256:2cc8745e1051844438c29d3fd6d47d269f4ca00607d22b76d3d3053894288581:"
        }
      ]
    },
    {
      "id": "claim_86bbb4ab40ff4a579668343a55a5ae47",
      "statement": "deploy/current.json is the fleet-wide pointer a node reads on startup; changing it is a deploy and nodes converge on it.",
      "evidence": [
        {
          "resource": "repo://crates/celld/protocol.rs#L402-L412",
          "version": "repo-lines-v1:sha256:a55ea58e86c263c4c9f727557ba6a5b4b581eb2cc913ee0490551579a56a57c8:"
        }
      ]
    },
    {
      "id": "claim_94edacf4b01b406eaae34c0d6b3be518",
      "statement": "The per-node pointer watcher is the one reader of deploy/current.json after boot: it polls on a slow interval, a POST /reload or a managed notification only makes it look now, and a version that failed to build is remembered and not retried until the pointer names something else or a reload is forced so a broken bundle does not recompile on every node each interval.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main.rs#L653-L658",
          "version": "repo-lines-v1:sha256:7701a99050194240a9c310eeec47065a7d0c5409fd565881d0fd5cf3cabecb6a:"
        }
      ]
    },
    {
      "id": "claim_8c93fba2ab114ee4b50ede12c12dec72",
      "statement": "Deployment adoption is in place: the node sends Message::GenerationChanged so resident cells move to the new generation at their safe points, with reserved cells moving first so the cron arm reaches a cron cell already running the new schedule.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main.rs#L640-L647",
          "version": "repo-lines-v1:sha256:98b0585d612c2f5ca8eeab1551682fb07589d26729aafad5fb50287cb943e5cc:"
        }
      ]
    },
    {
      "id": "claim_0ff718a43f4146248457591d4705ef9c",
      "statement": "Deployment convergence is tunable: CELLD_DEPLOY_POLL_S controls how often a node reads the pointer (default 30s), and CELLD_DEPLOY_MAX_AGE_S (default 60, 0 forces at once) bounds how long a resident Durable Object may keep the previous deployment's code before celld forces the move.",
      "evidence": [
        {
          "resource": "repo://docs/README.md#L682-L685",
          "version": "repo-lines-v1:sha256:cd519543823ef57fc07112815d4f1816db23909f7a2b12db6024a55b9ec0b882:"
        }
      ]
    },
    {
      "id": "claim_ef5ddb9ec14c4bcdb6b1c0369b85b65d",
      "statement": "A Generation is everything a node derives from a deployment — compiled Worker configurations, isolate pools, the DO class registry, the service-binding graph, asset resolvers, and the cron schedule; a node serves exactly one current generation and reaches it through a snapshot, so a request started on one generation finishes on it even after the node adopts another.",
      "evidence": [
        {
          "resource": "repo://crates/celld/generation.rs#L7-L14",
          "version": "repo-lines-v1:sha256:a846fe7149a7d8ea1ebfd9026bb6614354b5ede62e1ab8cd8ea8196a0990ab51:"
        }
      ]
    },
    {
      "id": "claim_64edee971492461899ca0eccec6f9f80",
      "statement": "Boot and reload construct a generation through the same two functions, DeploymentGraph::load and Generation::build; nothing else reads a deployment manifest into runtime state, so a reload cannot miss what a boot did because there is no second path for it to miss.",
      "evidence": [
        {
          "resource": "repo://crates/celld/generation.rs#L16-L18",
          "version": "repo-lines-v1:sha256:68cb6b4630600c3ea496a399b75899721ffa4ad979a679f5d13961bb6083729e:"
        }
      ]
    },
    {
      "id": "claim_d80eb0f48e20481381d74b870395db88",
      "statement": "Generation ids are monotonic from one within a process, never reused, never persisted, and never compared across nodes — the fleet-wide identity of a deployment is its version string.",
      "evidence": [
        {
          "resource": "repo://crates/celld/generation.rs#L46-L52",
          "version": "repo-lines-v1:sha256:392b33e31ed473c722cafcae175f814b3d96f4e68faadaf79871ff7429cc0375:"
        }
      ]
    },
    {
      "id": "claim_d6cd52495df7473f8807a739d399b525",
      "statement": "StopCause::Swap moves a cell's runtime to an isolate of the new application generation at the same epoch: no ownership change, no restore, no replication release; the core answers the stop with StartRuntime instead of a terminal phase.",
      "evidence": [
        {
          "resource": "repo://crates/logic/types.rs#L947-L953",
          "version": "repo-lines-v1:sha256:26e79716ecad3c8fdbebb35c21d54090414122b76100ea298db615b913e4417b:"
        }
      ]
    },
    {
      "id": "claim_5fcb4d2a1b244c45b5eb389e0a0fd21d",
      "statement": "D1's reserved Durable Object class is __D1Database.",
