    {
      "id": "claim_cd25c65e95a34d378a8675c3f1e3b43b",
      "statement": "celld reserves the bucket key prefixes cells/, nodes/, node-cells/, fleet/, deploy/, deploy-blobs/, wake/, telemetry/, and probe/, and deletes objects under some of them; the document instructs that an application must not write under any of these prefixes.",
      "evidence": [
        {
          "resource": "repo://docs/guarantees.md#L74-L81",
          "version": "repo-lines-v1:sha256:ca99847ba698d2e8bcb0f663cc06a619f1de6d007d811dc40e4ec6cdcaa91e07:"
        }
      ]
    },
    {
      "id": "claim_f60f9574952147ed989460494011eac1",
      "statement": "crates/celld/dead_node_gc.rs exists as a compatibility garbage collector that retires historical node-cells/ index debris and expired node-session records from fleet buckets shared with other celld process generations.",
