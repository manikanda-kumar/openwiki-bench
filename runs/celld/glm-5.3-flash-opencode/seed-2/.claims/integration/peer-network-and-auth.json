    {
      "id": "claim_98cd488028004ea2b7b050a04704ab87",
      "statement": "Operator commands reach reserved cells by finding a live node from the bucket leases, signing a request with the fleet secret, and POSTing /runtime/<scope> which forwards to the cell's owner; they cannot instead write the bucket because a bucket write happens behind the fence and the owner's next flush overwrites it, and they cannot name one node because an operator's internal listener has an ephemeral port by default.",
      "evidence": [
        {
          "resource": "repo://crates/celld/operator_cell.rs#L5-L12",
          "version": "repo-lines-v1:sha256:6ce486c74e9d05297058d27e9b66a7bacc62bbcb957fd02442b7c114170494aa:"
        }
