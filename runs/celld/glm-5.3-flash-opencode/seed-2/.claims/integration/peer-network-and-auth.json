  "claims": [
    {
      "id": "claim_8e336877f87749abbd424b6f219f43ab",
      "statement": "Peer HTTP and the operator API use the internal listener; every advertised address must be on a trusted private network or an encrypted overlay such as WireGuard or Tailscale, the internal port is not published, and celld rejects a literal public IP unless CELLD_UNSAFE_PUBLIC_ADVERTISE is set; an explicit advertised address requires an explicit internal-listener address and routing to it.",
      "evidence": [
        {
          "resource": "repo://README.md#L189-L200",
          "version": "repo-lines-v1:sha256:bdb1590ef84c3c26ff42b4dc456dd336be8fd92935d7f08a4c470ad52a318e95:"
        }
      ]
    },
    {
      "id": "claim_832109908c7e4dac8496eb25d1a5bd8a",
      "statement": "The fleet peer-auth scheme is PEM-defined around two protocol constants: the secret key fleet/peer-auth.json at SECRET_VERSION 1 with domain cells-peer-request-v1, and the version response header x-cells-peer-version (protocol version 5: PROTOCOL_VERSION=5).",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L18-L22",
          "version": "repo-lines-v1:sha256:32369e2d0bf256795d42ccfd3e21bfa3835538257abe691bd7ad911c51d76ec1:"
        }
      ]
    },
    {
      "id": "claim_62272b1e04f74e76a811f924ee271290",
      "statement": "Replay protection: a signed request's timestamp must be within a 30-second clock window, a nonce is retained for twice the window (REPLAY_RETENTION_MS = CLOCK_WINDOW_MS * 2), a compile-time const assertion pins that a nonce is retained at least as long as its signature is acceptable, and the replay cache is bounded at 1,000,000 entries.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L24-L31",
          "version": "repo-lines-v1:sha256:26fb4ed000e5cc3a67bec482bef8ed819b92a90068354048cbe6b91aa2ef0801:"
        }
      ]
    },
    {
      "id": "claim_e36bca10e005403ebaf3a569b62f3804",
      "statement": "Signed peer requests carry x-cells-peer-source, x-cells-peer-target, x-cells-peer-timestamp, x-cells-peer-nonce, x-cells-peer-body-sha256, and x-cells-peer-signature headers; the signature is an HMAC whose canonical request binds method, path+query, body hash, source, target, timestamp, and nonce.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L33-L41",
          "version": "repo-lines-v1:sha256:8176d9775a0a3a347de6f6d78e1318725c41fc6b72c297c1b4a659865b89a2e2:"
        }
      ]
    },
    {
      "id": "claim_51f1c5da1299472785fcacc1bdeb5934",
      "statement": "Peer discovery comes from bucket node leases, not a join service: nodes/<node>.json carries addr (where peers POST) and probe_public_key; diagnose and peer routing read these leases.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ownership_store.rs#L27-L55",
          "version": "repo-lines-v1:sha256:02bddc01c2bcc62031fd9ea5a9df9dd0569242e5455e89aa7590f3b71613df37:"
        }
      ]
