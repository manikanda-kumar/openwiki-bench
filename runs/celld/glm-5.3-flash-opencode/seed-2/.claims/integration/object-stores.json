  "claims": [
    {
      "id": "claim_9021798c88e34c029f2aefb5e9e7a20b",
      "statement": "bucket.rs unifies two conditional-write dialects: S3 (and Azure az://) use the etag as CAS token sent via If-Match/If-None-Match with SigV4 credentials (Put Blob honors both headers on Azure), while gs:// speaks the Cloud Storage XML API dialect using the object generation as CAS token sent as x-goog-if-generation-match with OAuth credentials — because GCS accepts S3-style requests on the same host but does not apply If-Match to a PUT, only the generation dialect can fence there.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L8-L16",
          "version": "repo-lines-v1:sha256:7eddf3483f1106120b7227db19b5580aebaf819c537c727fdd2497f7a7413543:"
        }
      ]
    },
    {
      "id": "claim_c10c5a78d2dc4626ad4bce3df325af41",
      "statement": "The bucket backend enum is StorageBackend with variants S3, Gcs, Azure, and Local, mapped to scheme strings s3, gs, az for diagnostics.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L76-L88",
          "version": "repo-lines-v1:sha256:53fa132adf4da36f347594d8c37e5f59649a8bb461ba53e26955dab6f88d3d57:"
