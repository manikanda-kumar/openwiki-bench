    {
      "id": "claim_a8998928100c4e3694146283fc84fcb7",
      "statement": "The CAS read answer depends on dialect: ETag for S3/Azure/Local, x-goog-generation for GCS, and the update precondition maps to If-Match/If-None-Match or x-goog-if-generation-match; the header name is included in error messages because a message naming only one header risks sending half the fleet to the wrong diagnosis during probe failures.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L100-L138",
          "version": "repo-lines-v1:sha256:363cf4f552bb0de37faf6f1495817acc27dfff64cb19413b7f68565f02279329:"
        }
      ]
    },
    {
      "id": "claim_eaef000c00644b66a86b58c40c8573c0",
      "statement": "Provider conflict mappings: Azure reports a failed If-None-Match as Precondition while some stores report the same create conflict as AlreadyExists; both are treated as a clean conditional-write conflict rather than an ambiguous error.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L172-L179",
