        }
      ]
    },
    {
      "id": "claim_f5e155cda5d742b19eb1926b46de5483",
      "statement": "The pressure threshold (default 80% of available memory, set via CELLD_MAX_RSS_MB) uses the greater of the allocator-adjusted RSS and the allocator-adjusted active cgroup working set; the working set is memory.current minus inactive_file from memory.stat with measured allocator slack removed, including active kernel charges RSS does not report and excluding file and allocator pages shedding cannot return; the /state route reports all four input measurements.",
      "evidence": [
        {
          "resource": "repo://README.md#L267-L282",
          "version": "repo-lines-v1:sha256:64b83e31d833fe1d642942f2be03ba6d43c78eb936a9bcdb6a6c521ca17d92b7:"
        }
      ]
    },
    {
      "id": "claim_e4e938c4e3fe42f6b63bfc5a3d6dd942",
      "statement": "memory.rs samples all four pressure inputs into Sample: rss_bytes, in_use_bytes (RSS minus allocator slack), cgroup_working_set_bytes, and cgroup_current_bytes, with resident_bytes reading RSS and cgroup_memory reading the cgroup files per platform.",
      "evidence": [
        {
          "resource": "repo://crates/celld/memory.rs#L14-L30",
