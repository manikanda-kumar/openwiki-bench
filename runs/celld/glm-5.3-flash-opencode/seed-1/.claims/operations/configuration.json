    {
      "id": "claim_0f9ec1992ecf4fcf9e228cf6c0a4a1f7",
      "statement": "Environment parsing is strict: an unset variable selects its caller's documented default, a supplied variable must be valid (a typo cannot silently change configuration), a boolean accepts only 0/1, and celld exits during startup on invalid input.",
      "evidence": [
        {
          "resource": "repo://crates/celld/env_vars.rs#L3-L8",
          "version": "repo-lines-v1:sha256:659b779fbef4e2889c1649b6c55457564394919e2f392d99b534641d5bef3807:"
        },
        {
