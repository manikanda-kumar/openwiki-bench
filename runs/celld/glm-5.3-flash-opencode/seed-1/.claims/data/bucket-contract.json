  "claims": [
    {
      "id": "claim_65da4e715c8a4fb1814479ee8282792c",
      "statement": "The bucket contract requires three properties — conditional create, conditional overwrite, read-after-write consistency — and is qualified on S3, R2, Tigris, GCS, and Azure Blob Storage; a store without working conditional writes breaks celld (two nodes can own one cell), so B2/Hetzner/Spaces cannot run a fleet.",
      "evidence": [
        {
          "resource": "repo://docs/guarantees.md#L16-L34",
          "version": "repo-lines-v1:sha256:ba4417465d008614904352ba5acf5ceae298452b5f5617937290605df8a4994e:"
        }
      ]
    },
    {
      "id": "claim_929d367ae86b443b8dba0016d7f038eb",
      "statement": "bucket.rs is the engine's single object-store client (object_store crate, one bucket, replacing aws-sdk-s3, in-memory Bytes) with two conditional-write dialects: the etag dialect via If-Match/If-None-Match for S3/Azure, and the generation dialect via x-goog-if-generation-match for GCS, because GCS does not apply If-Match to a PUT.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L1-L24",
          "version": "repo-lines-v1:sha256:548b73d9644f7f186cf90d007654b807d80acd5dcc5ef0ac62e2080916ba9c55:"
        }
      ]
    },
    {
      "id": "claim_b418306a22c84dab856a0fe5ddc44729",
      "statement": "put_cas maps None→PutMode::Create and Some(token)→PutMode::Update, returning Ok(Some(token)) on apply, Ok(None) only for a clean Precondition/AlreadyExists rejection, and Err for every other failure because the write may have committed; an applied result without a usable token is also an Err, contract relied on by the self-fence.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L179-L186",
          "version": "repo-lines-v1:sha256:72cb8de73d429a574c00ab1d67d86f36ed657adf9cf0e04a81735ab689b9bb76:"
