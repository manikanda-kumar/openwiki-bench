  "claims": [
    {
      "id": "claim_764d0fb2ce6148c6b71d5469d1069895",
      "statement": "Each cell has one ownership record at cells/<cell>/own.json naming the owner node session and a fencing epoch; acquisition is a conditional write — CasGuard::Absent create or CasGuard::Match(etag) compare-and-swap — so the bucket accepting one write is what makes two owners impossible.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ownership_store.rs#L401-L420",
          "version": "repo-lines-v1:sha256:9bdbbe13a62b4c9797188e72905829c2c4f920543857c2bcf62561f8a693a580:"
        },
        {
