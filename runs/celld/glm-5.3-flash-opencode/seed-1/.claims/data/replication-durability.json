    {
      "id": "claim_961354d1bcc641bcba3c7b40e75d4b4f",
      "statement": "The replication object layout is cells/<cell>/ltx/e<epoch>/ in the bucket mirroring the local <watch>/<cell>/ltx/e<epoch>/db.sqlite tree; ltx_repl builds its own object-store clients (not bucket::Bucket) so it carries the fleet key prefix itself, and epoch-in-prefix is the data-path fence — a stale owner writes a dead prefix.",
      "evidence": [
        {
          "resource": "repo://crates/celld/ltx_repl.rs#L12-L17",
          "version": "repo-lines-v1:sha256:bbef10559c5f6ef69b3e158b42fb57f3c7422bc82e4b87d309ef8eb6a0f62c76:"
