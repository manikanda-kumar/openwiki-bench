    {
      "id": "claim_a8cc0f8d12824498a65b41a1e2f92a34",
      "statement": "CELLD_DURABILITY selects the proof posture: the default `fleet` sends each write to one or two other nodes and answers once they hold it on disk or the bucket upload finishes, whichever first; a single node has no peer so every write waits for the bucket; `bucket` always waits for the bucket.",
      "evidence": [
        {
