        }
      ]
    },
    {
      "id": "claim_ee2c0229e47f457a9e972db935d736f5",
      "statement": "Verification enforces protocol version compatibility, valid identities (ASCII letters/numbers/dot/dash/underscore), a 30-second clock window, body-hash match, target match, signature match, and nonce replay rejection with a cache bounded at 1,000,000 entries, expired after a 60-second retention window.",
      "evidence": [
