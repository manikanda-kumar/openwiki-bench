        }
      ]
    },
    {
      "id": "claim_070b741a8f354ee5897b70de6d388c13",
      "statement": "Peer request authentication is HMAC-SHA256 over a canonical string binding DOMAIN ('cells-peer-request-v1'), protocol version 5, method, path_and_query, body SHA-256, source, target, timestamp, and nonce, transmitted as x-cells-peer-* headers; the signature does not encrypt transport.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L159-L176",
          "version": "repo-lines-v1:sha256:be54a40defadfb4f3784bccddd0a4b62d81223776cde75fdc68a9aefe835cec8:"
        },
        {
