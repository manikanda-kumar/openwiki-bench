    {
      "id": "claim_0a331f542949414d92a60713639aebfc",
      "statement": "Internal-listener advertise addresses are guarded: a literal public IP in `--advertise` is rejected unless `--unsafe-public-advertise` is supplied, and an explicit non-loopback public listener without an explicit internal listener is rejected; a loopback advertise address is documented as reachable from the same host only.",
      "evidence": [
        {
          "resource": "repo://README.md#L189-L196",
          "version": "repo-lines-v1:sha256:79975e40d72deb5f32236a4c026819aa33d7790bcb4fc1e0558b2eb92274a609:"
