    {
      "id": "claim_c93d2406b671414398daba0914228185",
      "statement": "A celld node is one `celld` process per machine; nodes sharing one bucket form a fleet, embed V8, execute Wrangler bundles, and discover peers through the bucket rather than a.join protocol or fixed membership list.",
      "evidence": [
