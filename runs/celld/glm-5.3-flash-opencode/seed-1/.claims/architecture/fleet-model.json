    },
    {
      "id": "claim_104ac6f84edf4bb08768b4ef129fb670",
      "statement": "Every fleet node binds two listeners: a public Worker ingress listener (bind_ingress_listener for `--listen`) and an internal peer/operator listener (bind_internal_listener for `--internal-listen`/`--advertise`) that carries peer tunnels, peer probes, log transport, and the operator routes (/state,/reload,/shutdown).",
      "evidence": [
