    },
    {
      "id": "claim_9175e62d7d8b440c974f248f7e9a9667",
      "statement": "celld-logic is a sans-IO decision core whose on_event(&mut State, Event) -> Vec<Effect> is the only way behavioral state advances; both the production executor and a deterministic simulator feed it events and perform the returned effects, and no adapter may mutate State directly.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L3-L8",
