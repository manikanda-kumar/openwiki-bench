  "claims": [
    {
      "id": "claim_e9e1d848588e4f1199e0ab3446689a58",
      "statement": "The core's Phase enum maps to the named Durable Objects lifecycle states: Resident is active-or-idle in memory, Dormant is out of memory but still owned by this node (hibernated when Hibernatable sockets survive), and Inactive is owned by nobody; celld's 'evict' means out-of-memory to Dormant, while publishing unowned is shedding.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L98-L113",
          "version": "repo-lines-v1:sha256:8711c8f91327e3e74ab72a0535684ce9e5274ef1cd972ed58c01cc50ed844a40:"
        }
      ]
    },
    {
      "id": "claim_006c44e2a9884acabbeeb26ea5b0df69",
      "statement": "Hibernation keeps only the sockets: a dormant hibernated cell preserves no memory, so its next event reruns the constructor exactly like a cold start, with the surviving WebSocket clients the whole difference from Inactive.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L1411-L1422",
          "version": "repo-lines-v1:sha256:8b27632e3089cb9a187fe539b0403b11cd0631d7fb59b9bd95d94f8734cb164c:"
