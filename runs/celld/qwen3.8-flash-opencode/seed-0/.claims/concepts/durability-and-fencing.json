    {
      "id": "claim_079108b204954839974ee2420fbeb1ce",
      "statement": "Ownership correctness requires conditional create, conditional overwrite, and read-after-write from the store; one opaque-token client speaks S3-etag, Azure Put Blob, and GCS generation dialects, with only S3/R2/Tigris/GCS/Azure qualified, and stores that lack real conditional writes can end up with two owners of one cell.",
      "evidence": [
        {
          "resource": "repo://crates/celld/bucket.rs#L8-L19",
          "version": "repo-lines-v1:sha256:89b673cc214b7fc172fcb281c96d9fe902c0cf578d90dcca14ce150c586b6172:"
