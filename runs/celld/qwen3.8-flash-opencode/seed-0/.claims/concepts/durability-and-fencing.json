    {
      "id": "claim_22fe263a8982419db5d89b41c13538ae",
      "statement": "The node-log membership record is folded into the node lease: nodes/<node>.json carries {state: open|recovering|sealed, epoch, ensemble, tiered, active}, a session is identified by the record's generation, live sessions write only through the core's lease chain, and recovery writes dead sessions' fields by CAS that can only fence, never revive.",
      "evidence": [
        {
          "resource": "repo://crates/celld/node_log.rs#L235-L246",
          "version": "repo-lines-v1:sha256:bf3b0a4262bda43bbddb10f2f4cdf098d354db234eb9147f14a5cc8eed6608d4:"
