    {
      "id": "claim_6ebf6ee60cdb4cfa9a42d225eb524daa",
      "statement": "The core fences on lease continuity: a renewal whose round trip outlived the prior expiry triggers fence_node, while an initial lease acquisition that lands expired never becomes authoritative and merely retries at the fleet's renewal cadence.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L1861-L1899",
