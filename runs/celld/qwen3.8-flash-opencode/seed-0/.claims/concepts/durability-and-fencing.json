        }
      ]
    },
    {
      "id": "claim_6ac090697ca5461d9e23d76794213674",
      "statement": "A takeover consults the prior owner's folded log state before reading the bucket: absent or sealed means the bucket is complete, anything else gates the activation on recovery, which refuses a revived lease, CASes open to recovering, seals reachable followers, uploads retained segments and bundles into per-cell prefixes, and CASes to sealed; every step is a CAS or idempotent upload so a lost CAS converges on the rival's outcome, and a store error leaves the session unsealed.",
      "evidence": [
        {
          "resource": "repo://crates/celld/node_log.rs#L3489-L3535",
          "version": "repo-lines-v1:sha256:abc31cf140501735eeb9d021d35ad9584bb2c988cd1e7a4b871ed1e8002c3fb0:"
