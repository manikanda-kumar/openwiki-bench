    {
      "id": "claim_1fe869e2579a440da4eaa2f745ce2437",
      "statement": "One cell has one bucket ownership record at cells/<cell>/own.json carrying {node, epoch, etag}; node=None is a deliberately released record whose epoch never resets, and acquisition is a conditional create or CAS so the bucket accepts at most one winner.",
