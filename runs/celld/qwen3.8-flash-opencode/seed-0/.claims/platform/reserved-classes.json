          "version": "repo-lines-v1:sha256:64ccde005d7eb544c10cb9f639f390034bfaf3c3ee17868ff6207f98ce783e27:"
        }
      ]
    },
    {
      "id": "claim_2f13e474b84f44e98f47ff7946165152",
      "statement": "A D1 database is addressed as __D1Database:<id> where the id hashes the binding's database identity under the fleet-wide namespace key cells:v1:d1:__D1Database, and the harness supplies the __D1Database class.",
