    {
      "id": "claim_6b21fca3b5174833b97cf78836826588",
      "statement": "KV refuses rather than truncates upstream limits (512-byte keys, 25 MiB values, 60s minimum TTL, 100-key bulk, 1000-key list pages), and values above 1 MiB move to the fleet bucket with a row reference because inline bytes are paid twice in SQLite and LTX, with the crossover measured by fleet A/B.",
      "evidence": [
        {
          "resource": "repo://crates/logic/kv.rs#L37-L55",
          "version": "repo-lines-v1:sha256:612b397cb87d6a35a1cd4a3b64a71d07d0d29a60037662365b0823416ce48c13:"
