  "claims": [
    {
      "id": "claim_c0ac2e6e9f764a1f9c080fa00fb6b445",
      "statement": "celld-logic is a dependency-free pure decision core: on_event is the only way behavioral state advances, production and simulation both feed it events and perform returned effects, and no adapter may mutate State directly.",
      "evidence": [
        {
          "resource": "repo://crates/logic/Cargo.toml#L8-L11",
          "version": "repo-lines-v1:sha256:f35bd628b74f4b5b7b185b65a0e58c23ebefc4f1b1ef49a27a8c89167bfc58b4:"
        },
        {
          "resource": "repo://crates/logic/lib.rs#L3-L8",
          "version": "repo-lines-v1:sha256:5a37221a4a1e3133fb069765572a5109ad4c023932a3425f370bd9be139b4eb2:"
        }
      ]
    },
    {
      "id": "claim_e4dc9d0279ef41b7980adec966b1b501",
      "statement": "The core's vocabulary is data-only: Event is the sole input (requests, timers, adapter completions), Effect the sole output (owner reads/CAS, node-lease CAS, restore, runtime start/stop, publish, await-durable, release, halt, timers), and types.rs itself makes no decisions.",
      "evidence": [
        {
          "resource": "repo://crates/logic/types.rs#L3-L8",
          "version": "repo-lines-v1:sha256:b2962f85d7b07bd947e344a7364b6297d63b20451ddc1c71611fc70bfeb6ee1f:"
        },
        {
          "resource": "repo://crates/logic/types.rs#L402-L402",
          "version": "repo-lines-v1:sha256:c1752cf7e07a8553e1e29d7a75b531cd3160e557bc10c31fa71e737c750c092d:"
        },
        {
          "resource": "repo://crates/logic/types.rs#L740-L740",
          "version": "repo-lines-v1:sha256:d1fb9e52a9fd361a5521ae01607581f02a7f999711dfc98729853eb5f5b4cb66:"
        }
      ]
    },
    {
      "id": "claim_c5a8c2b7cb3b43c69dceeca9b708d032",
      "statement": "The core never reads a clock: on_event folds caller-supplied timestamps into the state's notion of now by monotonically maxing them.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L5215-L5222",
          "version": "repo-lines-v1:sha256:38ed7fe580b519476d157404c6a83a17b1f8423b158f78f49850126dcdc8b38a:"
        }
      ]
    },
    {
      "id": "claim_de50ce963a134055b70917287a8610e5",
      "statement": "State keeps lifecycle bounds inside the replayable machine: explicit activation and eviction permit sets, output-gate barrier map, and a FIFO capacity-waiter queue that bounds admission in a count of releases rather than probabilistic racing.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L486-L555",
          "version": "repo-lines-v1:sha256:28769eef044f07f07d7afc41f9fc28ba0b1161f3af4fa94a5e2d553ed0aa217a:"
        }
      ]
    },
    {
      "id": "claim_17deff1a03bc4cc788ebcc55c1ce59d0",
      "statement": "Management-facing presence and activity counters are projections of the same decision state, carrying each cell's epoch so callers identify the exact fenced runtime, not a shell-maintained second inventory.",
      "evidence": [
        {
          "resource": "repo://crates/logic/types.rs#L19-L46",
          "version": "repo-lines-v1:sha256:2dbf40c60d1cc75d110ceaf374c63c6d666d9fb891aa63cc23d27e1ab8b48248:"
        }
      ]
    },
    {
      "id": "claim_a45c9232dcdb4d9db75027a4f5985145",
      "statement": "State::validate asserts lifecycle ceilings (resident bound, eviction-permit bound with the draining release ceiling), and debug actor builds run this full check after every event.",
      "evidence": [
        {
          "resource": "repo://crates/celld/actor.rs#L2792-L2795",
          "version": "repo-lines-v1:sha256:d058036d62d0198ee2e2ddcf1de93848d7a5f8ceaa88bacccf3d455290093ccb:"
        },
        {
