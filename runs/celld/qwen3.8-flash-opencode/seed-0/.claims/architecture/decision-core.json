        },
        {
          "resource": "repo://crates/logic/peer.rs#L3-L37",
          "version": "repo-lines-v1:sha256:d3eb80f69500ebd2fd7876f773034574146954f050361e2401203ba97a10a317:"
        }
      ]
    },
    {
      "id": "claim_dc15f0201d0e491094e8964efc05fb2a",
      "statement": "Alarm retry policy is exponential from a 2 s base doubling to a 64 s cap, abandoned at 6 limit-counting failures, while excused failures such as pressure-shed back off without counting.",
      "evidence": [
