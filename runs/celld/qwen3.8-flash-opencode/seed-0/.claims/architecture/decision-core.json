    {
      "id": "claim_4b97dc784bad4af3ab00c53ef4c8587d",
      "statement": "Wake-entry reconciliation and the wake/<minute-bucket>/<cell> key scheme live in the core so production's async flusher and a deterministic executor obey the same ordering rules.",
