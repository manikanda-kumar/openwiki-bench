  "claims": [
    {
      "id": "claim_d68069eeee8a470eab197f01634498f5",
      "statement": "celld opens two plain-HTTP listeners and terminates no TLS: the public listener serves the Worker plus only /.well-known/celld/health, and the internal listener (default 127.0.0.1:0) carries the peer protocol and an operator API whose unknown paths are answered 404 instead of reaching the Worker.",
      "evidence": [
        {
          "resource": "repo://docs/security.md#L20-L45",
          "version": "repo-lines-v1:sha256:9e548deb841291798cf14a070b256e28aa37856a52530558101b290d8d05ff3c:"
        }
      ]
    },
    {
      "id": "claim_c053a8be386e46e19f5967c27c0c33d6",
      "statement": "Once draining, the public listener refuses new non-health requests with 503 plus Retry-After: 1 and Connection: close while admitted requests finish and versioned peer traffic keeps flowing to un-handed-off cells.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main.rs#L2572-L2597",
          "version": "repo-lines-v1:sha256:a3f647134dfc205bdfdc34ecb119d22883596d535c5610a0929548d653e58ec1:"
        },
        {
