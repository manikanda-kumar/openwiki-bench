          "version": "repo-lines-v1:sha256:77e9a464a17f9aa107937bb22aa355b3c69a4e0124797bc29e65d51afd526795:"
        }
      ]
    },
    {
      "id": "claim_bf7e00d37dc949da96b988fc3517c2f7",
      "statement": "request.url construction ignores X-Forwarded-* unless explicitly trusted, takes the last value of multi-valued headers, validates shape per source so a malformed forwarded value falls through to Host, defaults to celld.local, and takes path/query only from the request target, because a structurally invalid authority would make every Worker throw inside new URL().",
      "evidence": [
        {
          "resource": "repo://crates/celld/main.rs#L1628-L1686",
          "version": "repo-lines-v1:sha256:fa3c1b72619bd0abe677be2d0f429091e43c11c6b4bfae7dbed8dab4dd72cdf0:"
        },
        {
