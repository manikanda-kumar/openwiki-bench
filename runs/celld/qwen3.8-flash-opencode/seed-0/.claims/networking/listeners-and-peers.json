          "version": "repo-lines-v1:sha256:f96a282d9c96d5a692224a9d40336489b1efbb6a9b3eda2ad02b86e76b7296f2:"
        }
      ]
    },
    {
      "id": "claim_cb49cf7ba94345829e28a909c5431854",
      "statement": "Request bodies are capped at CELLD_MAX_REQUEST_BODY_BYTES (default 1 GiB, 413 on declared overflow and on reading past the limit), and non-GET /do bodies of at least 1 MiB or unknown length stream instead of being collected.",
      "evidence": [
        {
          "resource": "repo://crates/celld/actor.rs#L1128-L1130",
          "version": "repo-lines-v1:sha256:3b31f1b27b65c25cdeb267093d6e46fdcd9e06acc31f0b97e69d9c52e0cef862:"
        },
        {
