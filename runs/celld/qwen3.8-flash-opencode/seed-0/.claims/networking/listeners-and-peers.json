          "version": "repo-lines-v1:sha256:3b49f146effc39a10dea4707b856c2ffdf7708678185eaeae11b405f56c850b7:"
        }
      ]
    },
    {
      "id": "claim_5ea00d5963324149861a07cb185fe112",
      "statement": "The fleet's 32-byte peer secret is stored as fleet/peer-auth.json: the first node creates it with a conditional write, and a lost create race loads back the winner's key.",
