    },
    {
      "id": "claim_f53f0eb823ad4772a590c4db5b495296",
      "statement": "Every scope entering a network route passes valid_cell_scope first because the scope becomes a filesystem component and a bucket key; the charset fence excludes path separators and . / ...",
