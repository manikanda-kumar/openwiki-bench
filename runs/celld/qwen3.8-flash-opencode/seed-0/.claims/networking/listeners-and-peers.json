    {
      "id": "claim_6e57873dbd034ae7b0fccf9a748e0124",
      "statement": "The internal listener routes are exact: peer paths (/peer/probe, /peer/handoff, /peer/log/, /peer/abort/, /peer/tunnel), operator paths (/state, POST /reload, POST /shutdown with handoff=preserve, /cell/, /evict/), /do/ for ordinary Durable Objects, and /runtime/ reserved for runtime classes.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main.rs#L2624-L2692",
          "version": "repo-lines-v1:sha256:422881effcbb78f6b46fb05e8b4b9ceb9ec52596296cb68b978c08d70bb20cd7:"
        }
      ]
    },
    {
      "id": "claim_1d43aa5ac1e7489da4250ceb3c73dfa6",
      "statement": "/runtime/<SCOPE> is deliberately the single authenticated entrance for reserved classes: /do/ refuses every reserved scope and /runtime/ refuses every non-reserved one, so a newly added reserved class inherits both the entrance and the refusal instead of relying on per-class routes.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main.rs#L2658-L2712",
          "version": "repo-lines-v1:sha256:3c48f6fdcef3c40fa7dc3e3e8c52d71adcaa75691c03c0908f0eb0f847b6f585:"
        }
