    {
      "id": "claim_8dbb6b64a33d4398a6fcfe5f22fe5320",
      "statement": "Activation branches on the ownership read: absent record is a conditional create treated as fresh epoch one, self-owned advances the epoch with a CAS on the etag without takeover, a released (null) record is claimed with takeover at epoch+1, and a foreign owner consults that node's lease before routing remote or authorizing takeover.",
      "evidence": [
        {
          "resource": "repo://crates/logic/lib.rs#L3186-L3256",
          "version": "repo-lines-v1:sha256:41a8db774a8b5a3ffc9c4c5e2055063ba433fa79030df3a7e87066690865ae68:"
        }
