        }
      ]
    },
    {
      "id": "claim_2a8553a95988468dba0e0d613eb5a1b5",
      "statement": "The fleet HMAC (domain cells-peer-request-v1 over method, path, body SHA-256, source/target, timestamp, nonce in x-cells-peer-* headers) enforces a 30-second two-sided clock window with 60-second nonce retention (twice the window so no signature outlives its replay entry) at PROTOCOL_VERSION 5, with the well-formedness, window, and retention predicates living in celld-logic::peer while signing stays in the adapter.",
      "evidence": [
        {
          "resource": "repo://crates/celld/peer_auth.rs#L17-L36",
          "version": "repo-lines-v1:sha256:77037d650f2f06600ed08372f9dfc976b4031eac72bd1f5bffe0e7c03b9d1834:"
        },
