        }
      ]
    },
    {
      "id": "claim_7a8e1a28f63a4311be8c09b248697de6",
      "statement": "celld does not terminate TLS and peer traffic crosses the internal network as plaintext HTTP authenticated (not encrypted) by the fleet HMAC, so confidentiality must come from a trusted private network or encrypted overlay, and the internal listener's unauthenticated operator API must not reach the public internet.",
      "evidence": [
        {
          "resource": "repo://docs/README.md#L417-L425",
          "version": "repo-lines-v1:sha256:cd76de787118dbd14a3951c55b638fcdf2f7523a024b6e3b8673ebfacb7897f1:"
