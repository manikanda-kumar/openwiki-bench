    {
      "id": "claim_28c4e43b337049be922c271c2a4c1373",
      "statement": "The internal listener serves /peer/probe, /peer/handoff, /peer/log/*, /peer/abort/<scope>, /peer/tunnel, /runtime/<scope>, /state, POST /reload, and POST /shutdown (with ?handoff=preserve selecting the same-node preserve mode); /state keeps serving during a drain.",
