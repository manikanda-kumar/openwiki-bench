        }
      ]
    },
    {
      "id": "claim_78dcef328a284dcdafd100fb5a04d548",
      "statement": "Fleet durability is write-all/ack-all over the leader's follower ensemble at its fragment epoch, and each process session creates its conditional log record before its first fleet-durable acknowledgement.",
