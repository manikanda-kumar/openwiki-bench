    {
      "id": "claim_5ff4733de2a847f7b24a04853dd615a7",
      "statement": "A fleet of two or more nodes is required before any node can complete a fleet proof; a node recruits up to two followers and keeps acknowledging while one remains, degrading to bucket-proof acks until a periodic re-recruit CASes a fresh ensemble, and the session's log state is folded into the nodes/<node>.json lease record.",
      "evidence": [
