    {
      "id": "claim_7e9363d8cf9044f1a9582ca67c087d42",
      "statement": "The node runs one serial Actor that polls its mailbox, timers, and in-flight effect futures together, because monotonic lease ticks must fence the node even while a storage operation remains hung, without spawning a task per effect.",
      "evidence": [
        {
          "resource": "repo://crates/celld/main.rs#L8-L15",
          "version": "repo-lines-v1:sha256:a26203427490e9d8aff3a2518ed50465a8867345df20004cab357aa5fceafeb3:"
        }
      ]
    },
    {
      "id": "claim_5402cc8a6cb8431d861692a65924dc5a",
      "statement": "Actor::run selects unbiased over exactly three inputs (mailbox messages, FuturesUnordered effect completions, and a DelayQueue of versioned timer arms), while deterministic callers can drive Actor::start and Actor::step directly without the raw Tokio select.",
