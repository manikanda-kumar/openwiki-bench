        {
          "resource": "repo://crates/celld/cli_output.rs#L9-L50",
          "version": "repo-lines-v1:sha256:4d49f97d3eb57797a32c7ec624edbf0a73b3c27d74932a463aee1fb4781e4213:"
        }
      ]
    },
    {
      "id": "claim_743f1367f1af468a8f07705df022483c",
      "statement": "--bucket/--endpoint/--region and their CELLD_* environment fallbacks are parsed in one shared module so provider rules (like gs:// and az:// endpoint handling) cannot diverge between operator commands.",
      "evidence": [
        {
          "resource": "repo://crates/celld/cli_options.rs#L5-L12",
