    {
      "id": "claim_dc13323839064d528eb161ab9fee8513",
      "statement": "Operator commands never read or write bucket objects directly — that writes behind the ownership fence and the owner's next flush overwrites it — instead resolving live nodes from nodes/*.json leases and posting signed requests to /runtime/<scope>, which /runtime/ refuses unsigned because reserved cells answer arbitrary SQL over operator protocols.",
      "evidence": [
        {
          "resource": "repo://crates/celld/operator_cell.rs#L45-L50",
          "version": "repo-lines-v1:sha256:b8c7f63f5a0b9213e2c3f27a6e7373ebab01619e651152363aebae9516714fbd:"
        },
        {
