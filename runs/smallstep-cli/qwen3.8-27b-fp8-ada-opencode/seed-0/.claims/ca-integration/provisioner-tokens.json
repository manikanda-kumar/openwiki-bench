    {
      "id": "claim_cf6c121d38a542ceb2752b44f2ffd347",
      "statement": "generateOIDCToken execs the CLI's own 'step oauth --oidc --bare' with the provisioner ConfigurationEndpoint, ClientID, ClientSecret, scopes and auth params, optional --console, and --listen from the provisioner ListenAddress unless STEP_LISTEN is set, returning the token on stdout; generateK8sSAToken reads the service account token from --k8ssa-token-path (default /var/run/secrets/kubernetes.io/serviceaccount/token) and returns it unchanged.",
