  "claims": [
    {
      "id": "claim_aed6790b7cf3470e9c82b603114e4fad",
      "statement": "The token package defines DefaultIssuer 'step-cli', DefaultAudience 'https://ca/sign', validity bounds MinValidity 10s / DefaultValidity 5m / MaxValidity 1h / MaxValidityDelay 30m, and the Step CA claim names sha (root SHA256), sans, step, user, and cnf (confirmation/proof-of-possession).",
      "evidence": [
        {
          "resource": "repo://token/token.go#L11-L40",
          "version": "repo-lines-v1:sha256:81115704e34d944ab313ce8feeb8b7de3d43a3c3c016e624b3f88506b566d4fc:"
        }
      ]
    },
    {
      "id": "claim_b895b05ea91e4cf3aad739b98d91142f",
      "statement": "Claims wraps jose.Claims with ExtraClaims/ExtraHeaders; DefaultClaims seeds issuer, default audience and a 5-minute validity from time.Now(); Sign builds a JOSE signer with kid set to the SHA-256 JWK thumbprint of the public key (GenerateKeyID) and compact-serializes the JWT, forcing aud to a string for single audiences.",
      "evidence": [
        {
          "resource": "repo://token/token.go#L47-L130",
          "version": "repo-lines-v1:sha256:b2071e419a6c5560d44af55da67159b4767068bcf7d5d6f089c0f4748f323745:"
        }
