          "version": "repo-lines-v1:sha256:a82e82e2466a222e7845b6932b709cad64543312306bdc2ad8473be29f9b01c9:"
        }
      ]
    },
    {
      "id": "claim_c695bcbaae7a483da09cc053dcd7c8c1",
      "statement": "Auth() builds the authorization URL with response_type=code plus PKCE S256 (code_challenge is base64url(sha256(verifier))), scope (default 'openid email'), prompt, state, nonce, login_hint, and --auth-param pairs; Exchange POSTs the code with code_verifier set to the original verifier and grant_type authorization_code, and token-endpoint POSTs set Accept: application/json (noted as required by GitHub).",
      "evidence": [
