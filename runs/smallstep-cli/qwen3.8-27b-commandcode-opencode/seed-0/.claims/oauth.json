    {
      "id": "claim_1403dadcebb84f3ea4bca86b111d4e1e",
      "statement": "--account accepts a JSON file in the installed format (auth_uri, token_uri, client_id, client_secret) or a Google service_account format (private_key_id as client ID, private_key PEM as client secret, client_email as issuer), the latter selecting the two-legged flows.",
      "evidence": [
