  "claims": [
    {
      "id": "claim_f0d33d3fc88640faa021bebe587864dc",
      "statement": "oauthCmd dispatches by mode: a service-account --account with --jwt calls DoJWTAuthorization (issuer=client_email, aud=scope), otherwise DoTwoLeggedAuthorization; --console or --console-flow device runs DoDeviceAuthorization, --console-flow oob runs DoManualAuthorization, and the default is DoLoopbackAuthorization; output is 'Authorization: Bearer <token>' with --header, the bare token (ID token with --oidc) with --bare, or the full token as indented JSON.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L351-L538",
          "version": "repo-lines-v1:sha256:069a5a2c03a7903459d037b72cf1db8a56624d7e807f317dae851f0709ee4f32:"
        }
      ]
    },
    {
      "id": "claim_559dca6599914912933d24293b47b49b",
      "statement": "step oauth ships built-in public Google installed-app client credentials (defaultClientID/defaultClientNotSoSecret, with a separate pair for the device flow) used when --client-id is absent, and static endpoint tables for the google and github known providers; all other providers must be https URLs.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L47-L66",
          "version": "repo-lines-v1:sha256:6654627b377cb9975f76c587f8523c7d704c213e92c328829eac61bfe53b1734:"
