    {
      "id": "claim_49a04e56acdc4ca8afe3d3b2bed5c588",
      "statement": "DoLoopbackAuthorization starts a local HTTP server (httptest.NewServer on a random 127.0.0.1 port by default, or net.Listen on --listen with empty host defaulting to 127.0.0.1 and a 15s ReadHeaderTimeout), uses --listen-url or the server URL as redirect_uri, opens the browser via exec.OpenInBrowser (STEP_OPEN_BROWSER=0 prints the URL instead), and waits on the token/error channels with a 2-minute timeout.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L728-L763",
          "version": "repo-lines-v1:sha256:6ded68d1438acbbd6451dc156c2a799366c80378deb71e016122c41a6ab485fd:"
        },
        {
          "resource": "repo://command/oauth/cmd.go#L765-L814",
          "version": "repo-lines-v1:sha256:da934dee1de07f2e9efc825044763e9d016add12b6d41fc21ac35decb261e19f:"
        }
      ]
    },
    {
      "id": "claim_1599be7ab9304a9ba5196491ed1a72e8",
      "statement": "DoManualAuthorization (OOB flow) sets the redirect URI to urn:ietf:wg:oauth:2.0:oob, prints the authorization URL, prompts 'Enter verification code:' on STDIN, and exchanges the entered code at the token endpoint.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L816-L846",
          "version": "repo-lines-v1:sha256:66ab37d3e0f20332730e64eb40ed45dfacd2cfbe84ad72c83f037337b10aefdb:"
        }
      ]
    },
    {
      "id": "claim_fe60a14b8f5c4eaeb5e3d8c59f4b43cc",
      "statement": "DoDeviceAuthorization posts client credentials and scope to the device authorization endpoint, accepts Google's non-spec verification_url and prefers verification_uri_complete (suppressing the code prompt), then polls the token endpoint with grant_type urn:ietf:params:oauth:grant-type:device_code every interval (default 5s), treating HTTP 4xx as not-yet-authorized until the expires_in deadline (default 5 minutes) which yields 'device authorization grant expired'.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L848-L920",
          "version": "repo-lines-v1:sha256:6aeb40cc558a5d402b362d7aefb1432009799dabe30484898977acf4dad7273e:"
