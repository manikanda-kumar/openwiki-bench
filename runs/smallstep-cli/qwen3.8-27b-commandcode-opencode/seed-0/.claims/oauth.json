    },
    {
      "id": "claim_1e93bea8d7af4f5f842271d706ac3375",
      "statement": "DoTwoLeggedAuthorization signs an RS256 JWT (kid=private key ID, aud=token endpoint, iss/sub=client_email, exp=now+3600, scope) with the PKCS8 key from the account and exchanges it with grant_type urn:ietf:params:oauth:grant-type:jwt-bearer, while DoJWTAuthorization signs the same shape with aud=scope and returns the JWT itself as the access token without any HTTP exchange.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L1044-L1088",
          "version": "repo-lines-v1:sha256:92c6a49bfffe07ef746d8c67ee16aebf7648b573378ae2d70cee2358055a3261:"
        },
        {
