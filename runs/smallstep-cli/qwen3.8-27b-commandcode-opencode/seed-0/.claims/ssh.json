    {
      "id": "claim_8dc07b43883a4ff8ad7c11818346d04c",
      "statement": "step ssh login requires a running ssh-agent, skips re-signing when a key with the same comment signed by a CA user root already exists (unless --force), backdates validAfter by one minute to avoid not-yet-valid clock skew, uses the OIDC token email as the subject when present, and adds the signed certificate (and add-user provisioner certificate) to the agent with non-fatal error reporting.",
      "evidence": [
        {
          "resource": "repo://command/ssh/login.go#L114-L302",
          "version": "repo-lines-v1:sha256:122edc5b58f63f4347ae9b781c9e4d68498f08da00bc507b11ef9bc56759244b:"
        }
      ]
    },
    {
      "id": "claim_d2e63defeb2c491688fd6e2399282528",
      "statement": "step ssh logout removes all agent keys with --all and no argument, or only keys matching the identity comment (or all certificates when no identity is given) that are signed by CA user roots, falling back to certificate-only filtering when roots cannot be fetched.",
      "evidence": [
        {
          "resource": "repo://command/ssh/logout.go#L78-L151",
