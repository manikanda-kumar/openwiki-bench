    {
      "id": "claim_9d0f3d4f233d4211ab317d2bdbb7cbb0",
      "statement": "step ssh certificate writes the private key at 0600 (OpenSSH format), the public key at <key-file>.pub and the certificate at <key-file>-cert.pub (both 0644), switches user/host certificate types via --host, defaults user principals from the sanitized subject plus email local-part and original subject, and gates --no-password (requires --insecure), --token vs --provisioner-password-file, --host vs --add-user, --host-id requiring --host, and single-principal --add-user.",
      "evidence": [
        {
          "resource": "repo://command/ssh/certificate.go#L221-L310",
          "version": "repo-lines-v1:sha256:e524caa4c4229988c9d5e294639861b2431b5ef005ea44c4f6877091a0747187:"
