      "id": "claim_3addc86c054c4ed59b55159404297666",
      "statement": "The step ssh group registers the subcommands certificate, check-host, config, fingerprint, hosts, inspect, list, login, logout, needs-renewal, proxycommand, rekey, renew, and revoke.",
