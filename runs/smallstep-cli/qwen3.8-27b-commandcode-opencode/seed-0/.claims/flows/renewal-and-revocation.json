    {
      "id": "claim_4793bf90f37349309bdd14c1d03f5e97",
      "statement": "step ssh rekey generates a fresh default key pair, posts SSHRekey with the new public key, and writes the private key in OpenSSH format at 0600 (password-prompted unless --no-password with --insecure or --password-file), plus the public key and certificate at 0644; --out X produces X, X.pub, and X-cert.pub, otherwise files are overwritten in place.",
