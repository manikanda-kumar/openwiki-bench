    {
      "id": "claim_d0f2df5082684f5097513aef2a1b2280",
      "statement": "Renewal defaults to mTLS: the client certificate is attached to the shared http.Transport only while not expired and passed to client.Renew (offline, OfflineCA.Renew reads it from tr.TLSClientConfig.Certificates[0]); --mtls=false or an expired certificate forces the token path, where RenewWithToken builds an x5c renewal token (audience <caURL>/renew, issuer step-ca-client/1.0, subject CN), clears the transport certificates, and closes idle connections before client.RenewWithToken.",
      "evidence": [
        {
          "resource": "repo://command/ca/renew.go#L425-L479",
          "version": "repo-lines-v1:sha256:f94795a55a4fb20a047ed5cb5308c531dadb577037762612ecca1986202331dd:"
