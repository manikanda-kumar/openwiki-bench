    {
      "id": "claim_8b966ec67c0841c793efc08b89c565d8",
      "statement": "pkiOpts map the init flags: WithAddress, WithCaURL (--with-ca-url written to defaults.json), WithDNSNames, WithDeploymentType, with WithProvisioner and WithSuperAdminSubject for standalone, WithAdmin for linked or --remote-management, WithSSH for non-linked --ssh, WithNoDB, WithHelm, and WithACME only for standalone (linked CAs must add the ACME provisioner later).",
      "evidence": [
        {
          "resource": "repo://command/ca/init.go#L597-L633",
          "version": "repo-lines-v1:sha256:8c09e90c786f5dbcac7637d064a2c721b34e25197867659e91ecd37249c26ec9:"
        }
