    {
      "id": "claim_413bb78e7f5849bbb5b9990cfc92e1d2",
      "statement": "initAction validates flags in a switch: --root requires --key and vice versa, --ra must be StepCAS or CloudCAS, --kms must be azurekms and is incompatible with --ra, --pki is incompatible with --no-db and --helm, --remote-management and --acme are incompatible with --no-db (Admin API and ACME need a DB), and --admin-subject requires --remote-management and is incompatible with --helm.",
      "evidence": [
        {
          "resource": "repo://command/ca/init.go#L240-L279",
          "version": "repo-lines-v1:sha256:1f4064ce3a6b6a95df71941344d875a5e69aa67ca62b4c7f2a87c2f1a6951364:"
        }
      ]
    },
    {
      "id": "claim_0051a9f6c4fd4db096b88450d8303e92",
      "statement": "step ca init starts by calling assertCryptoRand, which reads 64 bytes from crypto/rand and aborts with 'crypto/rand is unavailable' before generating any PKI material.",
