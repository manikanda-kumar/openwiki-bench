    {
      "id": "claim_ceaf8416a6874e898398f7a01e1a7dcd",
      "statement": "bootstrapAction selects between team and direct bootstrap: --team with --ca-url or --fingerprint is rejected; --team plus --team-authority calls BootstrapTeamAuthority(team, teamAuthority); --team alone calls it with the default authority sub-domain \"ssh\"; --team-authority without --team errors; otherwise --ca-url and --fingerprint are both required and BootstrapAuthority runs.",
      "evidence": [
        {
          "resource": "repo://command/ca/bootstrap.go#L85-L111",
          "version": "repo-lines-v1:sha256:9233088e1d6b59adda81887d92d0e867322f64b15dddaffc7f86ff7f8b6fc0fa:"
        }
      ]
    },
    {
      "id": "claim_b6ff67c356c843d18795a75533107260",
      "statement": "BootstrapTeamAuthority queries https://api.smallstep.com/v1/teams/<team>/authorities/<teamAuthority> by default, or a --team-url endpoint with <> placeholders replaced by the team ID, using an unauthenticated HTTP GET that maps 404 to 'authority not found'.",
      "evidence": [
