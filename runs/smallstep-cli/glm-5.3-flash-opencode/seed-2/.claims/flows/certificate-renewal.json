    {
      "id": "claim_fc369827b2f94c4fb71f2bf1330cd35d",
      "statement": "step ca renew loads the certificate chain with pemutil and the private key via internal/cryptoutil.CreateSigner (honoring --kms and --password-file), then builds a renewer over the offline CA (--offline --ca-config) or an online client whose transport carries the certificate as mTLS client certificate with TLS 1.2 minimum.",
      "evidence": [
        {
          "resource": "repo://command/ca/renew.go#L425-L480",
          "version": "repo-lines-v1:sha256:33a946aa7797b12818ee4247cbe7f3f5ea0f6174ea66a69cec015ff70832392f:"
        },
        {
          "resource": "repo://command/ca/renew.go#L656-L679",
          "version": "repo-lines-v1:sha256:dc4f47665c749786f32ce06dccd6dfd6a4243c75bf4dce9efeb757fc1eac02f4:"
        }
      ]
    },
    {
      "id": "claim_6cf1ff90c1204897aa475be667c3314f",
      "statement": "In renewer.Renew, mTLS (default) calls client.Renew with the certificate attached to the transport, and the certificate is attached to the transport only while it is still valid.",
      "evidence": [
        {
          "resource": "repo://command/ca/renew.go#L444-L446",
          "version": "repo-lines-v1:sha256:a5fb656fbb43352094ff279ebfaf40c9dc0d43fe1e33b4db4f058732da0c7bf7:"
