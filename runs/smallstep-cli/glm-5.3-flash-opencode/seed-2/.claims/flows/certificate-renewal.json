        }
      ]
    },
    {
      "id": "claim_2bc2ca2459c840449836b14c1e92cd4d",
      "statement": "Without --daemon, renewal is skipped (exit 0, printing 'certificate not renewed: expires in ...') when the remaining lifetime exceeds --expires-in plus a duration/20 jitter.",
      "evidence": [
