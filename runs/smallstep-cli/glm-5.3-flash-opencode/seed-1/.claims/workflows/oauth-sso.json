        }
      ]
    },
    {
      "id": "claim_43333857bea44c67925080560969dfda",
      "statement": "Device polling terminates with 'device authorization grant expired' after the provider's expires_in or the 5-minute default.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L928-L951",
          "version": "repo-lines-v1:sha256:0a5e0e15890e2d3221cd3b1c17c7cddfff77f0be99bed1c23dcdef39b0ffccc8:"
        }
