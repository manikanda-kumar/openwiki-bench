    },
    {
      "id": "claim_9d427f0893ae473890a82e10d9fee37d",
      "statement": "Provider validation accepts only google, github, or https-prefixed discovery URLs, and --provider requires --client-id unless the provider is google with no custom authorization endpoint.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L330-L349",
          "version": "repo-lines-v1:sha256:2648622d3267b8311941cf25fb8ec859ccec7dbecf0d30347589dabe57f24614:"
