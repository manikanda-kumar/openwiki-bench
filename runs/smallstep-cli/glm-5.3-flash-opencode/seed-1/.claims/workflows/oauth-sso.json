    {
      "id": "claim_5566dfef074a4585a638fc392994e8e3",
      "statement": "The oauth command only obtains tokens and does not verify them; the token struct models access_token, id_token, and refresh_token, and OIDC token verification is performed by step crypto jwt verify against the provider JWKS.",
      "evidence": [
