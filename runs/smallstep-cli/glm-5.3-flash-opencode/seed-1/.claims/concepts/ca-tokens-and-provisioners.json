    {
      "id": "claim_54b9ac53fc3f4f7bb8a7500d3b2b44bc",
      "statement": "Online token audiences are derived from --ca-url with operation-specific paths (/1.0/sign, /1.0/renew, /1.0/revoke, /1.0/ssh/sign, /1.0/ssh/revoke, /1.0/ssh/renew, /1.0/ssh/rekey) and reject non-https URLs; the offline CA derives the same audiences from the first DNS name in ca.json without the 1.0 segment.",
