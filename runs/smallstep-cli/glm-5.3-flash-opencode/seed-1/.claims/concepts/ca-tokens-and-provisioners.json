    {
      "id": "claim_7acd4a9551ef46c3b6f79e518fb198e6",
      "statement": "When parsing, AWS tokens get their instance identity document unmarshaled, and Azure tokens are detected by issuer prefixes such as sts.windows.net and login.microsoftonline.* with the xms_mirid claim parsed into subscription/resource fields.",
