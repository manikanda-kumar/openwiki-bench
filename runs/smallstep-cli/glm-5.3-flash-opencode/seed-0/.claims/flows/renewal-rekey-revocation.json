    {
      "id": "claim_672fa7f4cf9c44099572dfe1c79abbdd",
      "statement": "Revocation reasons accept RFC 5280 names (unspecified, keycompromise, cacompromise, affiliationchanged, superseded, cessationofoperation, certificatehold, removefromcrl, privilegewithdrawn, aacompromise) or numbers, mapped through RevocationReasonCodes.",
