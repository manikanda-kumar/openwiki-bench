        }
      ]
    },
    {
      "id": "claim_32be45274f534870a0149ac1fab79a14",
      "statement": "renewer.Rekey creates a CSR with an empty subject signed by the new key, calls client.Rekey, writes the new chain to --out-cert (default overwriting the input), and writes the new key to --out-key unless it was KMS-provided.",
      "evidence": [
