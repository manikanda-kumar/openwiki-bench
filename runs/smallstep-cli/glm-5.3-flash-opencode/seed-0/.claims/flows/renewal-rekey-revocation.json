    {
      "id": "claim_7c9da128a17544928f8cad378be874fe",
      "statement": "step ca revoke authenticates either with a one-time token (OTT in the request) or via mTLS built from --cert/--key, with the root falling back to pki.GetRootCAPath() and required unless --token; the api.RevokeRequest always sets Passive true.",
      "evidence": [
