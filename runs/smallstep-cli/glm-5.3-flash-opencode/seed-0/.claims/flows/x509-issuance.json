        }
      ]
    },
    {
      "id": "claim_bb0f545c596841b790297a3787d5e61e",
      "statement": "step ca certificate takes two or three positional arguments (the third omitted only with --attestation-uri for TPM attestation), rejects --offline with --token because the token must be generated after the offline CA starts, and rejects --attestation-uri with --kms.",
