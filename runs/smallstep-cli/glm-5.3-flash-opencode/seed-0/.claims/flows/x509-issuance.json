    {
      "id": "claim_906006e4585c4032857798eca4fbc3be",
      "statement": "cautils.CaClient is the common interface for online and offline CA clients (Sign, Renew, RenewWithToken, Revoke, Rekey, SSH operations, roots/config/bastion/version); cautils.NewClient selects offline when --offline is set (requiring --ca-config) or online ca.NewClient with ca.WithRootFile and the root defaulting to pki.GetRootCAPath().",
      "evidence": [
        {
          "resource": "repo://utils/cautils/client.go#L29-L74",
          "version": "repo-lines-v1:sha256:4b050a3ee6f5b50d8e156dd76c0856353952096be91258fb2d408ba25bb01969:"
        }
      ]
    },
    {
      "id": "claim_679c8b2f403a4ab99937f7a5e605d68c",
      "statement": "OfflineCA wraps an in-process step-ca authority.Authority built from the local ca.json; it is a process singleton because double initialization can deadlock on the database lock (badgerDB), requires at least one provisioner in the config, accepts --password-file for provisioner key decryption, and mirrors the online audience scheme (/sign, /renew, /revoke, /ssh/sign).",
      "evidence": [
        {
          "resource": "repo://utils/cautils/offline.go#L140-L158",
          "version": "repo-lines-v1:sha256:ee9b4dede4de1de1f3c37381cdf6ea061e8d3bf872bfd2c6fe876b0f09e0e125:"
        },
        {
