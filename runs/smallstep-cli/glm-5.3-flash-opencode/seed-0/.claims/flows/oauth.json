          "version": "repo-lines-v1:sha256:1d007e267533182b007423b4544bb8f029766221060620af24057f7e0ad8ce4a:"
        }
      ]
    },
    {
      "id": "claim_72f8d46b0c8c48998115481655ae2ae6",
      "statement": "The default Google installed-app client ID/secret pair and a separate device-flow client pair are baked into the source, with a comment explaining the app has no APIs or services enabled and that Google distributes the same values in its Cloud SDK.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L35-L56",
          "version": "repo-lines-v1:sha256:9abb81202b3232defad52a10d5148904bcd66169f93ff85c7bbf5819a86f7e70:"
