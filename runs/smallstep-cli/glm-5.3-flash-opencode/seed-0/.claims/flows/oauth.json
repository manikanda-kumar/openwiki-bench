        }
      ]
    },
    {
      "id": "claim_e3f0860db584445b915f94da99aa1888",
      "statement": "The authorization URL is built with response_type=code, PKCE S256 (code_challenge_method=S256 with SHA-256 of a random 64-character verifier), a random 32-character state, a 256-bit nonce, scope defaulting to 'openid email', optional prompt, login_hint from --email, and extra --auth-param values.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L1198-L1231",
          "version": "repo-lines-v1:sha256:be6325d7259e55dbd1bb0b4eafb8100ddf53cf79dfc4db850c2ee3698c580b1e:"
