    {
      "id": "claim_a0c8392e470147f9b55dc83d48517e99",
      "statement": "The browser is opened via exec.OpenInBrowser unless STEP_OPEN_BROWSER=0 (then the URL is printed), and on launch failure the URL is printed with manual instructions; OpenInBrowser maps darwin to open, linux/android to xdg-open (WSL detected via /proc/sys/kernel/osrelease and routed through rundll32.exe), and windows to rundll32, erroring on other platforms.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L787-L803",
          "version": "repo-lines-v1:sha256:0950959367169874fc1c8ffb029670773dd16d382de0aec9889d370a941395b1:"
