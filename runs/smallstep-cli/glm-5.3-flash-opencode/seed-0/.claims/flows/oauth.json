    {
      "id": "claim_48aca92ba9b0427cae72c310bda42755",
      "statement": "DoTwoLeggedAuthorization parses the PKCS#8 private key in the service account's secret, signs an RS256 JWT with aud=token endpoint, iss=account issuer, and scope, and posts it as assertion with grant_type urn:ietf:params:oauth:grant-type:jwt-bearer.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L65-L65",
          "version": "repo-lines-v1:sha256:9129fd68a30f118f4702bf0339fca55ac37efad41cc0335199c148d9d13b0039:"
