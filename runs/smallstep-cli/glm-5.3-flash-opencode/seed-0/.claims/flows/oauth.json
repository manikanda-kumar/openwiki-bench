    {
      "id": "claim_ef46eefd66d94ec9a59224a01c3a323e",
      "statement": "The loopback flow waits at most 2 minutes on token/error channels before timing out; the hidden implicit flow (--implicit, requires --insecure and --client-id) serves a JavaScript page that copies the URL hash fragment back as query parameters (urlhash=true) and validates state before accepting the token.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L1152-L1195",
          "version": "repo-lines-v1:sha256:74cf358bc74bb6907064438da2e8117a14f411af4a8d57276fdcc6fbb15c1785:"
