        }
      ]
    },
    {
      "id": "claim_0c7a28449da347bc8833f90921d3856c",
      "statement": "ServeHTTP serves only the callback path (default /), passes OPTIONS through, rejects an error query parameter, validates code+state against the generated state (missing values print a hint that an app or browser plugin may need to be disabled), exchanges the code, then 302-redirects to --redirect-url or serves the SVG success page and delivers the token over an internal channel.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L1090-L1150",
          "version": "repo-lines-v1:sha256:473d71b4f1eca21e206c91cada8467c2c44756d86ec4e73e981445c8aa54bc95:"
        }
      ]
    },
    {
      "id": "claim_7f421ab379dc4009ba10161799a3bf34",
      "statement": "Code exchange posts grant_type=authorization_code with the PKCE code_verifier, and all POSTs go through postForm which adds Accept: application/json because GitHub otherwise responds application/x-www-form-urlencoded.",
      "evidence": [
        {
