    {
      "id": "claim_e1ee618092ef4ff6a98986ef5985765b",
      "statement": "The loopback flow starts an httptest.NewServer (random port on 127.0.0.1) unless --listen is given, in which case it listens on that address with the host defaulting to 127.0.0.1 and rewrites the server URL; --listen-url overrides the redirect URI sent to the provider while keeping the local listener.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L728-L763",
          "version": "repo-lines-v1:sha256:6ded68d1438acbbd6451dc156c2a799366c80378deb71e016122c41a6ab485fd:"
        },
        {
          "resource": "repo://command/oauth/cmd.go#L765-L778",
