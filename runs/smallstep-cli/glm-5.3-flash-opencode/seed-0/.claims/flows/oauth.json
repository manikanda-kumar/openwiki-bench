        }
      ]
    },
    {
      "id": "claim_a8af537f0f684b83847e13fabbf3978b",
      "statement": "In the device flow, HTTP 4xx from the token endpoint is interpreted as authorization pending (errHTTPToken) and polling continues; other statuses fail.",
