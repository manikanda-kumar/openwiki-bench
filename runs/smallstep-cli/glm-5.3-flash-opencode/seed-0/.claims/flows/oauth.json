  "claims": [
    {
      "id": "claim_76945ba39f7f48c29830d16b012537f9",
      "statement": "oauthAction selects exactly one of four flows: --account with --jwt uses DoJWTAuthorization, --account uses DoTwoLeggedAuthorization, --console or --console-flow device uses DoDeviceAuthorization, --console-flow oob uses DoManualAuthorization, and the default is DoLoopbackAuthorization.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L495-L509",
          "version": "repo-lines-v1:sha256:53cce19dcc0281811189a0ffa46c55533301f273ff252fd61f23e3d0f2efc238:"
        }
      ]
    },
    {
      "id": "claim_8127d8e062414e4fb82edd3e5693c34d",
      "statement": "Two providers (google, github) are hardcoded with authorization, device-authorization, token, and userinfo endpoints; any other --provider value is treated as an OIDC discovery URL, fetched as <provider>/.well-known/openid-configuration, from which authorization_endpoint, device_authorization_endpoint (device flow only), and token_endpoint are extracted and validated.",
      "evidence": [
        {
          "resource": "repo://command/oauth/cmd.go#L573-L586",
          "version": "repo-lines-v1:sha256:4927c0bf42e4dadf0b17563e2f3ef9f81f34427850660914cfa8a6ca54c6d63a:"
        },
        {
