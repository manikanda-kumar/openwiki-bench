          "version": "repo-lines-v1:sha256:eaf6ce7a013f1fee5d1798b4b30a454c0908927d015d879563dc54beed108011:"
        }
      ]
    },
    {
      "id": "claim_a1ce4ae220f14d2d8d9ce9ab53b1bade",
      "statement": "The device flow posts to the device-authorization endpoint, prefers verification_uri_complete (suppressing the user-code prompt), tolerates Google's spec-violating verification_url key, polls the token endpoint every interval seconds (default 5) until a token or expiry (default cap 5 minutes, shortened by a smaller expires_in).",
      "evidence": [
