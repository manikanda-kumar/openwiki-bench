    },
    {
      "id": "claim_fdaeda26f7f44c1cab40dd9385dcaa71",
      "statement": "The bootstrap core fetches and validates the root by fingerprint via client.Root(fingerprint) under an insecure transport (the fingerprint check is the trust anchor), then in context mode registers the context from --context/--authority/--profile with flow defaults and saves/sets it as current, warning about contexts otherwise.",
      "evidence": [
        {
          "resource": "repo://utils/cautils/bootstrap.go#L104-L113",
          "version": "repo-lines-v1:sha256:939535ef6f951facbf7472eaeeffa3804afc1a98ec9ba220fbdfdeafb198c170:"
