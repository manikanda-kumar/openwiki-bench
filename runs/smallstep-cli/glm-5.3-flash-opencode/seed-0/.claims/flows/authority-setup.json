    {
      "id": "claim_022e59ca06bd4b0ea5ed26a9d51354f0",
      "statement": "BootstrapTeamAuthority resolves authority metadata from https://api.smallstep.com/v1/teams/<team>/authorities/<authority> (or a custom --team-url with <> replaced by the team name); the response carries url, fingerprint, redirect-url, provisioner, and min-password-length; --redirect-url overrides the returned value, which defaults to the Smallstep SSO success page; the context name defaults to <authority>.<team>.",
      "evidence": [
        {
          "resource": "repo://utils/cautils/bootstrap.go#L226-L294",
          "version": "repo-lines-v1:sha256:98559df6bd24bf9ca0ebe9eed14cf67dff2ce8a73135b5065e7e72ef16560dc6:"
        }
