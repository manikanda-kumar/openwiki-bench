    {
      "id": "claim_5427eb5bdebe4190956403b3cd5dd8cc",
      "statement": "step ca bootstrap routes --team (optionally with --team-authority) to cautils.BootstrapTeamAuthority and otherwise requires --ca-url plus --fingerprint for cautils.BootstrapAuthority; --team is incompatible with --ca-url and --fingerprint.",
      "evidence": [
