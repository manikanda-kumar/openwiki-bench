    {
      "id": "claim_f4076de8da064c67a3313db290f11dd1",
      "statement": "Output: the private key is serialized OpenSSH-style with password encryption (prompt, --password-file, or plaintext only with --no-password --insecure), public and certificate files are written 0644, --add-user produces a <base>-provisioner key triple, and user certificates are added to the agent via agent.AddCertificate unless --no-agent.",
      "evidence": [
