    {
      "id": "claim_e2d6bff6951f460ea04425f52b015edf",
      "statement": "step ssh certificate takes <key-id> <key-file>, derives fixed output suffixes <key>.pub and <key>-cert.pub, defaults the comment to the subject, and selects SSHHostCert/SSHHostSignType with --host versus SSHUserCert/SSHUserSignType otherwise, with default principals derived from the subject (whole subject for hosts, parsed parts for users).",
      "evidence": [
        {
          "resource": "repo://command/ssh/certificate.go#L221-L301",
          "version": "repo-lines-v1:sha256:3baa6f090339946d841e5fa6be74a4d97b8e76c697265c089212c111bf852f33:"
        }
      ]
    },
    {
      "id": "claim_da0d3ad43adb4bc7a47928788ffe2ed0",
      "statement": "The certificate flow parses an existing authorized key with --sign (optionally --private-key) or generates a keypair from --kty/--curve/--size, obtains a token via flow.GenerateSSHToken (provisioner dispatch per the token machinery) unless --token is given, and submits SSHSign with public key, OTT, principals, cert type, key ID, validity, add-user key, identity CSR, and template data.",
      "evidence": [
        {
          "resource": "repo://command/ssh/certificate.go#L318-L356",
          "version": "repo-lines-v1:sha256:259b5da48ba7f1efb4b892deafd6aac084b9374d0f613a6b5d32ede397c61fd9:"
