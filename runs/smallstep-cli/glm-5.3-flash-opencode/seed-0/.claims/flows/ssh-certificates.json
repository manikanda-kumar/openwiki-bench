    {
      "id": "claim_e56d094622c74985a6f69ba9490d67e9",
      "statement": "step ssh login requires an ssh-agent (sshutil.DialAgent fails otherwise) and without --force is idempotent: it fetches the CA's user roots and returns early when the agent already holds a valid CA-signed key with the requested comment, removing expired certificates as a side effect of the check.",
      "evidence": [
        {
          "resource": "repo://command/ssh/login.go#L114-L159",
          "version": "repo-lines-v1:sha256:4998733b354b7f4eb31af30d9c71358f228ef6b6e85fffab3ef6df3da5069db2:"
        }
      ]
    },
    {
      "id": "claim_2cc3910b9c1845b19d1ed1e1071827eb",
      "statement": "login back-dates validAfter by one minute to avoid 'Certificate invalid: not yet valid' clock-skew errors, overrides the subject with the OIDC token email when present, and otherwise falls back to the token subject when no identity argument was given.",
      "evidence": [
        {
          "resource": "repo://command/ssh/login.go#L190-L248",
