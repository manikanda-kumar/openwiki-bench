    {
      "id": "claim_f5cde1d926914931ac00e2b47f6fdeac",
      "statement": "step certificate bundle is minimal concatenation: it reads each input, PEM-decodes only the first block, and writes leaf-then-issuer with mode 0600; there is no chain building or relationship validation, and the only flag is --force.",
      "evidence": [
        {
          "resource": "repo://command/certificate/bundle.go#L50-L83",
          "version": "repo-lines-v1:sha256:781fc922e21af947e68e326c45ccd4a524fa9cb6527ce260166de7244f65b205:"
        }
      ]
    },
    {
      "id": "claim_b253f899fb744da9b5a7e02e93e45504",
      "statement": "step certificate inspect accepts a file, STDIN (the default with no argument), or a remote URL; text format uses certinfo.CertificateText/ShortText (--short rejected for json/pem), json re-parses with zcrypto zx509 and JSON-encodes, pem re-encodes; only the first certificate is shown by default with --bundle showing all, and a CSR file falls through to CSR inspection.",
      "evidence": [
        {
          "resource": "repo://command/certificate/inspect.go#L195-L247",
