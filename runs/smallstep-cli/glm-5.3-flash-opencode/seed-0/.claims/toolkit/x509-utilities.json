    {
      "id": "claim_021fb17491ac4c04a931c70bee2dfaa8",
      "statement": "step certificate fingerprint defaults to SHA-256 with --sha1 gated behind --insecure, supports --format hex/base64/base64-url/base64-raw/base64-url-raw/emoji via flags.ParseFingerprintFormat, hashes raw certificate bytes, works on CSRs and remote URLs, and prints indexed lines with --bundle.",
      "evidence": [
