    {
      "id": "claim_0934f7bd274c4bfc9c4652bfb8c4ad75",
      "statement": "step certificate lint parses the certificate with zcrypto's zx509 and runs zlint.LintCertificate, printing the ResultSet as indented JSON; input is a local file (first PEM block only) or a remote URL with the shared --roots/--servername/--insecure flags.",
      "evidence": [
        {
          "resource": "repo://command/certificate/lint.go#L100-L141",
