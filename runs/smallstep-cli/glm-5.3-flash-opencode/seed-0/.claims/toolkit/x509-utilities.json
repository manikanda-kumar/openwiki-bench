    {
      "id": "claim_f2abe965a77a42f4a5e6d6aaa631595a",
      "statement": "crl inspect reads the CRL from file, STDIN, or HTTP(S) URL, verifies signatures by matching the CRL's AuthorityKeyID to candidate CAs' SubjectKeyId (requiring KeyUsageCRLSign), and outputs text (crlutil.PrintCRL), json, or pem; internal/crlutil parses PEM or DER and implements CRL.Verify covering nextUpdate freshness, CA validity, and ECDSA/RSA PKCS1v15/RSA-PSS/Ed25519 signatures.",
