    {
      "id": "claim_1c79e44a15be438fbdd0212010a580bd",
      "statement": "step certificate verify performs local RFC 5280 path validation: the first CERTIFICATE block is the leaf and subsequent blocks feed the intermediates pool (so bundled input works without a --bundle flag); --roots loads the root pool from file/list/directory, --host adds DNS checking, and KeyUsages is ExtKeyUsageAny.",
      "evidence": [
        {
          "resource": "repo://command/certificate/verify.go#L195-L244",
          "version": "repo-lines-v1:sha256:d411f00a195412a6bf88f7dab2c225cfe6efc14045e977778940dd6e1193b4f6:"
        }
