    {
      "id": "claim_02d9a3205e1d4a76a334a0c22c4b62d0",
      "statement": "jwt verify parses the token from stdin; with --jwks the kid comes from --kid or the token's own header and ReadKeySet with WithKid selects the member; without --insecure it adds jose.WithNoDefaults(true) to prevent algorithm guessing, requires iss/aud unless --subtle, gates --no-exp-check behind --insecure, rejects multiple signatures and crit headers, and reports signature failures as 'validation failed: invalid signature'.",
      "evidence": [
