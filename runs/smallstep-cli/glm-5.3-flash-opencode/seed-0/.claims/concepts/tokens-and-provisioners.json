    {
      "id": "claim_d14895f0b0e641c69d5310e486302d8a",
      "statement": "Token audiences map token type to CA endpoint paths under the CA URL: sign /1.0/sign, renew /1.0/renew, revoke /1.0/revoke, SSH user and host sign /1.0/ssh/sign, SSH revoke /1.0/ssh/revoke, SSH renew /1.0/ssh/renew, SSH rekey /1.0/ssh/rekey, with the scheme forced to https.",
