    {
      "id": "claim_ccf7c2ea8353468fbb4a92b7dfe757e8",
      "statement": "Claims.Sign builds the JWT with typ JWT, a kid header derived from the signing key's JOSE thumbprint (GenerateKeyID), any extra headers, and forces a single-element audience to a plain string rather than an array.",
