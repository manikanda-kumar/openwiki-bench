    {
      "id": "claim_c338f526454a435985fc91eeeed373bd",
      "statement": "Token options encode CLI intent as claims: WithRootCA/WithSHA set the sha claim, WithSANS/WithStep/WithSSH/WithUserData set sans/step/user, and WithConfirmationFingerprint/WithFingerprint build the cnf claim with key x5rt#S256 (the latter accepting a CSR or SSH public key and computing the base64url SHA-256 fingerprint); SignToken applies the fingerprint automatically when a CSR or fingerprint is in the shared flow context.",
      "evidence": [
        {
          "resource": "repo://token/options.go#L45-L144",
          "version": "repo-lines-v1:sha256:19d2fa96c4088c8377d3f0afd11776f4a464a78a144debb92366ef3b460a6c10:"
