    {
      "id": "claim_8a5688f1a1df47a294f181240b516d8e",
      "statement": "Token defaults are issuer 'step-cli', audience 'https://ca/sign', iat/nbf = now, and exp = now+5m (DefaultValidity); smallstep extension claims are sha (root SHA-256), sans, step (custom certificate info including SSH options), user (template data), and cnf (proof-of-possession).",
