    },
    {
      "id": "claim_d41e77cd82dc49ba9a1f0c2fe5f6bbc0",
      "statement": "Payload.Type() sniffs the token type from content: google payload = GCP, amazon = AWS, Azure payload with xms_mirid = Azure, issuer kubernetes/serviceaccount = K8sSA, presence of sha or sans = JWK, otherwise a complete iss/sub/aud/exp/iat set = OIDC, else Unknown.",
      "evidence": [
