    {
      "id": "claim_48268b56e1da4005aeba61dc303a7f11",
      "statement": "Header-embedding token options attach certificates: WithX5CFile/WithX5CCerts set the x5c header after validating the chain-key match, WithX5CInsecureFile/WithX5CInsecureCerts set the x5cAllowInvalid header, WithNebulaCert sets the nebula header after verifying the nebula cert matches the key, and WithSSHPOPFile sets the sshpop header.",
      "evidence": [
        {
          "resource": "repo://token/options.go#L231-L362",
          "version": "repo-lines-v1:sha256:d9a9176e3f9463090d37ab27f7c231b00c4d79c037f10f5e8c0f9462a0660948:"
        }
