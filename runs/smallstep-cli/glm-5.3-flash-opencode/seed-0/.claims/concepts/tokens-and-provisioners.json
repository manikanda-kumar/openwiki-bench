    {
      "id": "claim_ac4afedecdb542829b9a9566c633a988",
      "statement": "step ca token selects the token type constants (SignType, RevokeType, RenewType, SSHUserSignType, SSHHostSignType, SSHRevokeType, SSHRenewType, SSHRekeyType) based on --renew/--revoke and SSH flags.",
