    {
      "id": "claim_2612c90465a54b7c9cd00b59b1ada74b",
      "statement": "token.WithValidity enforces the token validity contract at construction: expiration must not precede not-before, not-before may be at most 30 minutes (MaxValidityDelay) in the future, and validity must be between 10 seconds (MinValidity) and 1 hour (MaxValidity).",
      "evidence": [
        {
          "resource": "repo://token/options.go#L146-L168",
