    {
      "id": "claim_a2552c06aa064911aef953cba949d33b",
      "statement": "Command actions follow a strictly sequential guard-clause pattern: positional-argument validation first via errs helpers (e.g. errs.MinMaxNumberOfArguments, errs.EqualArguments), then flag reads into locals, then cross-flag validation with errs combinators such as RequiredWithFlag, InvalidFlagValue, IncompatibleFlagValues, and IncompatibleFlagWithFlag.",
      "evidence": [
        {
          "resource": "repo://command/certificate/create.go#L495-L543",
          "version": "repo-lines-v1:sha256:61dc1e1925c664067595785ca2239cbd22d9f4547a374ed3fada3a1c19fce714:"
        }
