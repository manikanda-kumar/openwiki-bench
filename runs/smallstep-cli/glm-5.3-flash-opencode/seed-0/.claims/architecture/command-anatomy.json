    {
      "id": "claim_b8b9d13f10e649c583d41c11d996a6b3",
      "statement": "Every command package registers its cli.Command in a package-level init() by calling command.Register from github.com/smallstep/cli-utils/command, and top-level command packages are activated by blank imports so their init() runs.",
