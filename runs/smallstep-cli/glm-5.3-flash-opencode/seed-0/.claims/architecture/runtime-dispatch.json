    {
      "id": "claim_30ffc98f59804eda89bc8208bf68b103",
      "statement": "run() implements the process lifecycle: deferred panicHandler, step.Init() for the $STEPPATH environment (failure exits 1 before any command), app.Run(os.Args), and error printing where errors implementing Message() print errs-style messages with a STEPDEBUG=1 hint and plain errors print err; any error yields exit code 1, success 0.",
      "evidence": [
        {
          "resource": "repo://internal/cmd/root.go#L50-L85",
