        }
      ]
    },
    {
      "id": "claim_ee29409c630f457c8bb6485f2bfa3900",
      "statement": "provisionerPrompt gates new provisioner types in two places: auth-flag pre-narrowing filters (allowX5C/SSHPOP/Nebula/K8sSA) and an explicit allow-list of provisioner.Type values; a type absent from the allow-list can never be selected.",
      "evidence": [
        {
          "resource": "repo://utils/cautils/token_flow.go#L291-L319",
          "version": "repo-lines-v1:sha256:507fd1a3e0b73938e11524d2fc7be83aecddf9da7bcb3acb1c42604f27f97e12:"
        }
