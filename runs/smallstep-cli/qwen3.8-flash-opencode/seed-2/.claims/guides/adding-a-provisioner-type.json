    },
    {
      "id": "claim_85371db3a15f47649805c1e129349465",
      "statement": "generateNebulaToken is the reference pattern for credential-header provisioners: read <type>-cert/<type>-key flags with errs.RequiredWithProvisionerTypeFlag, load the JWK, build the audience as <endpoint-audience>#<provisioner GetIDForToken()>, and pass a token option embedding the credential through the tokType switch.",
      "evidence": [
