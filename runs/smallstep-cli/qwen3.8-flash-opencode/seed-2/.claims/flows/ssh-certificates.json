    {
      "id": "claim_eb3d8dfb284f432086e26568f10a004d",
      "statement": "step ssh login requires a running ssh-agent and is idempotent: unless --force it queries the CA's user signing keys via SSHRoots and exits early when the agent already holds a non-expired key signed by them.",
      "evidence": [
        {
          "resource": "repo://command/ssh/login.go#L154-L183",
          "version": "repo-lines-v1:sha256:fad10f6a43bfaf008809c01f2f91467922408c23b33474dbb0d2639e8dfeb84e:"
        }
      ]
    },
    {
      "id": "claim_792201df42ab4855b4ffdf66bd3dfe8a",
      "statement": "SSH login reuses the CA token flow with SSHUserSignType, defaulting validAfter to one minute in the past to tolerate clock skew, and overriding the subject with the OIDC token email (or the token sub for other types); SSH sign tokens encode cert type, key id, principals, and validity windows in the step.ssh claim.",
      "evidence": [
        {
          "resource": "repo://command/ssh/login.go#L186-L248",
          "version": "repo-lines-v1:sha256:6b63975ecb47c5edc74c18c1abd25a3d262a5bda6674fab5fb04e81c4866d234:"
