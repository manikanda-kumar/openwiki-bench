    {
      "id": "claim_5b3dcd4650364e8ca2578722840b6ce6",
      "statement": "step ssh check-host asks the CA SSHCheckHost, signing the request with the stored default identity key when the CA requires client authentication, and exits 0/1 for scripting; step ssh needs-renewal defaults to a 66%-of-lifetime threshold.",
