    {
      "id": "claim_b78a70eeb5a84e3d933d361af2ce7b17",
      "statement": "NewTokenFlow dispatches per provisioner type: JWK signs a client JWT, OIDC execs step oauth, AWS/GCP/Azure return the cloud identity token, K8sSA reads a service-account token, X5C/SSHPOP/Nebula embed the credential in a JWT header, and ACME/SCEP return typed errors (ACMETokenError/SCEPTokenError) that route callers into those protocols.",
      "evidence": [
        {
          "resource": "repo://utils/cautils/token_flow.go#L160-L185",
          "version": "repo-lines-v1:sha256:da9a025b71962aee5665a2364695555d04e9a22d674d6f2ca3f1286842bc6e7f:"
        }
