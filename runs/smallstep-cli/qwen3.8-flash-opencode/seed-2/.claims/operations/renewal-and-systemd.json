    {
      "id": "claim_4002ff483e7c4a8da236ad6ca2d9ed24",
      "statement": "The templated cert-renewer pair fires every 15 minutes (OnCalendar=*:1/15) with Persistent=true catch-up and 5m randomized jitter, running a oneshot that gates on step certificate needs-renewal, renews with step ca renew --force against /etc/step/certs/%i.{crt,key} under STEPPATH=/etc/step-ca, and try-reload-or-restarts the service named by the same instance.",
      "evidence": [
