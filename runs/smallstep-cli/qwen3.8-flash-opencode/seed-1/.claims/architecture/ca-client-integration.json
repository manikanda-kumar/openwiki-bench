    {
      "id": "claim_197ea5240656459b97d5169a0e3cb05d",
      "statement": "OfflineCA.Sign authorizes the one-time token through authority.Authorize with the provisioner.SignMethod context and returns the authority-produced chain in the same api.SignResponse shape used by the online client.",
