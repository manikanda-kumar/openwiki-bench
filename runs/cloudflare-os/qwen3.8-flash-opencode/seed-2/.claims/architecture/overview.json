    {
      "id": "claim_52634bbda06f40fdaeb472194e4cab5b",
      "statement": "Workshop-backend persists blueprint metadata in the BLUEPRINTS KV namespace, avatars in AVATARS KV, blueprint content in the BLUEPRINT_CONTENT R2 bucket, and loads gadget dynamic workers through the LOADER worker-loader binding.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/wrangler.jsonc#L66-L83",
          "version": "repo-lines-v1:sha256:79e7e61e5c193344529291c07bd4410b8aceb41414627c22741a0a41cb412fda:"
        }
