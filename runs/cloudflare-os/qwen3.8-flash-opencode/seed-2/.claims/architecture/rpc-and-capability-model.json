    {
      "id": "claim_7286fec8fe8a407fa30f4b55c68cb1fa",
      "statement": "On RPC breakage the frontend publishes an RpcPromise that a probe-verified reconnect resolves, relying on Cap'n Web promise pipelining to queue outage-period calls, and adopts each new stub candidate only after a successful ping because unproven stubs would fail all pipelined work at once.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-frontend/src/main.tsx#L112-L151",
          "version": "repo-lines-v1:sha256:cd0af380243748f8cd2d3f7f13aa978a6f71554d11a4215de4b86115c16c2a87:"
        }
      ]
    },
    {
      "id": "claim_f281a945099a4dd89d6a677d4a017d8f",
      "statement": "The client probes the connection with ping() on tab-visible and network-online events because passive close detection misses sockets killed during sleep or tab throttling.",
