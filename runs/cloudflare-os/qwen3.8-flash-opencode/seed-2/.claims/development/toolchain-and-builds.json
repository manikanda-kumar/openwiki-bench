          "version": "repo-lines-v1:sha256:41ace801e004a58f9b0aa2bd6f9b77080dc1f77d20cb1e3226de80f12e479480:"
        }
      ]
    },
    {
      "id": "claim_3aa738a3f4954ac1ac76c7ed62405c06",
      "statement": "workshop-frontend's build task declares env: ['VITE_*'] so flags like VITE_CF_ACCESS_MODE and VITE_FRONTEND_ERROR_REPORTING both reach the build and participate in the cache key, and scripts/env-passthrough.test.ts fails on unaccounted build-time env reads.",
      "evidence": [
