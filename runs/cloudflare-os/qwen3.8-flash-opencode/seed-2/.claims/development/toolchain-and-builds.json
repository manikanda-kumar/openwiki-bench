  "claims": [
    {
      "id": "claim_00b62559311d419ead5e79e0d9cfaedc",
      "statement": "pnpm build and pnpm clean are 'vp run -r' invocations, so each package's build runs as a Vite+ task cached against its tracked inputs and unchanged packages replay their previous output instead of executing.",
      "evidence": [
        {
          "resource": "repo://package.json#L17-L17",
          "version": "repo-lines-v1:sha256:b09505652f802a7ae846953ea60a841ada15c1a27338952348c40fc606945248:"
        },
        {
          "resource": "repo://package.json#L8-L8",
          "version": "repo-lines-v1:sha256:e2f108bae7f1e9aff288e75f4aadcc9ecfce3c624cf5a3b939fb5a86bd5e1553:"
        }
      ]
    },
    {
      "id": "claim_e761ed90bb6043c18bf27d808deb3633",
      "statement": "Vite+ forbids a task and a script from sharing a name, and a plain script runs with a stripped environment invisible to the cache fingerprint — so any build step that reads an environment variable must be declared as a task, and scripts must not duplicate task commands.",
      "evidence": [
        {
          "resource": "repo://scripts/gatekeeper-configurator-vite-config.ts#L33-L43",
          "version": "repo-lines-v1:sha256:5aa5a43eafe4932eb30c909ebd6fbc8f13155b7831dc42387436c8834bca7b79:"
