    {
      "id": "claim_458a3a3e0c9b46899b6eea8e0d6cf83c",
      "statement": "The app opens one persistent Cap'n Web WebSocket RPC session to the backend at startup and reconnects on loss; connection management is hoisted into module-level globals in src/main.tsx rather than React state to avoid duplicate sockets in dev-effect double runs.",
