          "version": "repo-lines-v1:sha256:66c3528498492615ef31a8063ac947ef8317a34945b3ead157444a82cc5218f8:"
        }
      ]
    },
    {
      "id": "claim_4258be507dc8469daddbc7f1a71a0221",
      "statement": "For observations made after a user becomes an observer, a gatekeeper names observers who must not see an observation via ObservationDescription.excludeObservers; the overseer blocks the observation unless every named observer has already lost access in the sharing graph, in which case it deletes that observer record and best-effort removeObservers.",
