    {
      "id": "claim_7d06c21eb7f2450aaea9aff5ae97f3b6",
      "statement": "run-dev-server.ts loads a root .dev.vars file, discovers gatekeeper packages by scanning packages/gatekeeper-* for a wrangler.jsonc, and generates dev wrangler.dev.jsonc files: the dev router gets GATEKEEPER_* bindings for every gatekeeper, each OAuth gatekeeper gets CLIENT_ID/CLIENT_SECRET seeded from shared shell vars, and the backend gets GATEKEEPER_* service bindings with entrypoint GatekeeperVendor (gatekeeper-context with sharingDomain 'dev') plus optional feature vars passed through.",
      "evidence": [
        {
          "resource": "repo://scripts/run-dev-server.ts#L385-L534",
          "version": "repo-lines-v1:sha256:1742f58dbca1bb8342d0dac056a232cdbbbed25d2f95097bcbbfd80ae6fdfdb7:"
