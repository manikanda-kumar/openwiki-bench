    {
      "id": "claim_d4a7137b96b9469d88ea9d8db832433e",
      "statement": "Approved MCP calls are applied at most once: the action is claimed in storage before the call is sent, the record is settled before the result is attached, failures whose outcome is unknown (anything but a 401/403 refusal) close as failed and non-retryable, and a stale 'applying' claim from an interrupted activation is closed as may-or-may-not-have-taken-effect rather than released for another attempt.",
      "evidence": [
        {
          "resource": "repo://packages/mcp-shared/src/action-store.ts#L130-L199",
          "version": "repo-lines-v1:sha256:e1e80d49341516d36421212821ba2a36dae5cb3d851b05710e7a509dba8b61f1:"
