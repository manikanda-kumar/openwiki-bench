    {
      "id": "claim_164ef4351bd145a7ab77a6da9ef49401",
      "statement": "A Worker-scoped binding prepends an immutable $metadata.service filter and re-checks the result: a dropped event proves the filter was ignored, so the provider's own count is withheld (the whole account's count is exactly what the binding must not disclose), statistics is kept, and pagination cursors come from the provider's raw events rather than the surviving ones.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/observability-api.ts#L393-L407",
          "version": "repo-lines-v1:sha256:5d773aa25bd3729aaf95d308bb29694a617fcae29e6dae9fd5d29632d0092b4a:"
        },
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/observability-api.ts#L513-L536",
          "version": "repo-lines-v1:sha256:efe6a107312fde9fe7a5ae300fc905bd0c6796b0e1e1117d4a91c4ce0f59bc13:"
        }
      ]
    },
    {
      "id": "claim_1af7339e78ff4efc9eede8398e70a16a",
      "statement": "Trace summaries are available only from an account-scoped binding, since their shape describes a whole cross-service trace; a Worker binding can still fetch its own events for a known trace id via getTrace, which re-scopes every page.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/observability-api.ts#L563-L574",
          "version": "repo-lines-v1:sha256:758eb3f665b9c58de8163b1ccba28f608cd951dc6cec4f80a10f816722e6a05f:"
