        }
      ]
    },
    {
      "id": "claim_12fefa5962844601999cbd4087c7b62f",
      "statement": "The OAuth client is a minimal authorization-code + PKCE flow against the hardcoded Cloudflare dashboard endpoints, using HTTP Basic client auth and a PKCE verifier stored in the per-connection UserAccount Durable Object.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/oauth.ts#L107-L121",
