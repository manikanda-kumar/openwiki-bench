    {
      "id": "claim_81182f1926974a089f76f10d7d344d26",
      "statement": "The observability code is strictly layered: observability-api.ts is the only module that talks HTTP (bounded responses, timeframes, limits, one retry), observability-parse.ts validates every provider response before any caller or filter touches it, observability-session.ts funnels every read through #observe onto the approval queue, and observability-discovery.ts derives field names/values from a filtered sample.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/observability-api.ts#L301-L376",
          "version": "repo-lines-v1:sha256:6cb992838ecf13d6b11776d730f1578447b3de58d4b12e599b4c9dba3d9332d9:"
        },
