    {
      "id": "claim_b2251635d2f64b25b49bd1849a36eac7",
      "statement": "The /telemetry/keys and /telemetry/values endpoints ignore the filters they are sent (verified against the live API), so any discovery call that must be constrained is answered from a service-filtered events sample instead; and since a log's own fields are indexed under their bare name but returned nested under source, observabilityFieldKey accepts the source. alias wherever a caller names a field.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/observability-api.ts#L467-L511",
          "version": "repo-lines-v1:sha256:fcf369b63e1331b36c3991e067389e4cf1f4d7a616cccb8ace6858e46b951792:"
