          "resource": "repo://packages/workshop-backend/src/git-migration.ts#L1-L40",
          "version": "repo-lines-v1:sha256:9bda036b0286a0a35d97ee46e3bf8dd2628be8189f35f51d2a6daee620f3b910:"
        }
