    {
      "id": "claim_b65d5274302144b8a01a0349dd74dc43",
      "statement": "threeWayMerge never throws on conflict: conflicted files get inline diff3-style markers and are reported in conflictPaths (delete-vs-modify keeps the modified content); it deliberately replaces both Yjs CRDT merging (nonsense across divergent bases) and isomorphic-git's merge (throws on both-sides-added before any merge driver), with the common ancestor always known explicitly as the chat's last merged commit.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/git-store.ts#L452-L510",
          "version": "repo-lines-v1:sha256:b308f714ef9aebadd856359a1ad21c28a6e62436a68b41ec1ed9c16bc9eda233:"
