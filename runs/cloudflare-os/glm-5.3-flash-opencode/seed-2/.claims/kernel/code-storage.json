        }
      ]
    },
    {
      "id": "claim_7263d13e89e443a8a2b2c4d571da7990",
      "statement": "GitStore provides tree-diff changedPaths (memoized per call site in the agent replay), readCommitLog walking ancestry in git-log order, tree writing with git's canonical entry ordering, and flattened file-map reads restricted to modes 100644/100755 (anything else throws), keeping the two views (oid map and file map) in agreement about which paths exist.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/git-store.ts#L283-L398",
          "version": "repo-lines-v1:sha256:945ae395b0a9f2ba5721d4d0c2b3e692cd00f53d32985b8102eb4d39ca26af74:"
        }
      ]
    },
    {
      "id": "claim_6b506039c6594bf6b4b01830f049a6e9",
      "statement": "code-change.ts is the single owner of the code-change invariants: a chat's uncommitted state is a sequence of CodeChanges carrying no base content (only 'a change relative to revision N'), TextChange sections tile the entire original text so before/after lengths are known by construction, FileChange is exactly one of edit/set/remove (remove composable even against an absent file), and per-gadget entries are a LIST of [path, change] pairs because paths like __proto__ would be dropped from path-keyed objects by Cap'n Web deserialization.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-shared/src/code-change.ts#L1-L23",
          "version": "repo-lines-v1:sha256:d7ea7b6f28e759176dd0997862ae9643ebcefdfd1568922c79d07b272552a874:"
        },
        {
          "resource": "repo://packages/workshop-shared/src/code-change.ts#L55-L99",
