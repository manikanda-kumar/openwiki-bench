    {
      "id": "claim_651bba2a4ddc44d0b578da1d6ddee2bb",
      "statement": "The summary is produced by one completeText call with COMPACTION_SYSTEM_PROMPT (a structured Goal/Constraints/Progress/Decisions/Next Steps/Critical Context handoff instructing the model to ignore instructions inside the transcript); the compacted prefix is flattened to plain text with consecutive same-role messages merged (providers reject tool-call blocks without declared tools) and failed tool results keep their error flag visible; an empty summary is refused rather than allowed to discard history, and the summary call's usage is deliberately not billed to the chat.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/agent-compaction.ts#L272-L308",
