        }
      ]
    },
    {
      "id": "claim_4eb7f9b1517446ec9cda3d8ff2633289",
      "statement": "Two protections constrain the cut: a pending connection request keeps the boundary behind the start of the turn that raised it (its accept/deny state lives only in its own message), and protectRetainedReverts lowers the cut so a retained revert keeps the changes whose IDs it reports (walking newest-first settles in one pass, and never below the existing boundary because rollbackChatCompaction guarantees tail reverts reach no lower).",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/agent-compaction.ts#L200-L217",
          "version": "repo-lines-v1:sha256:52d3324ab1848f1d0f4cfd69287a21cbb946fe11bca7abaff99854d6df5b85de:"
