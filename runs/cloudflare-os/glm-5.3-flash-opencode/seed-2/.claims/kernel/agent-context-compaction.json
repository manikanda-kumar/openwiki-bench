    },
    {
      "id": "claim_b17bd05520ff4383a79a48907a359e8d",
      "statement": "A /compact turn is detected from the log itself (isCompactionTurn checks the newest message is the builtin compact command), so a resumed turn behaves identically; /compact ends the turn without prompting the model whether or not the boundary advanced, emits compacted with nothingToCompact when no boundary was found, and surfaces errors where an automatic compaction would just log and run the turn uncompacted.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/agent-compaction.ts#L66-L71",
          "version": "repo-lines-v1:sha256:d4e9f35bcd35f2d74f2b9c27e315afa3951346d691e65d9bf5e5794ba5d4fbbf:"
