    },
    {
      "id": "claim_4d352e2883924d82a696331a75dc0896",
      "statement": "findCompactionBoundary walks the projection backward until retained messages fill the target budget, then moves the cut to a record boundary (canCut marks the first model message a chat record contributes, so a tool result always keeps the call it answers and a record is never split); a boundary that cannot advance past the previous checkpoint returns undefined and the turn runs uncompacted.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/agent-compaction.ts#L219-L235",
          "version": "repo-lines-v1:sha256:950b3c2205db4c67a573b1629bc397c053599e02d882e35404939d44b4152c42:"
