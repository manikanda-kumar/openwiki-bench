  "claims": [
    {
      "id": "claim_a67d396aa3294b97a5f55c268deeea92",
      "statement": "Compaction triggers when the prompt reaches 85% of the model's input budget and targets a 30% retained tail; the budget is the SUGGESTED_MODELS context window minus the model's output limit (128k assumed for unknown models, WORKERS_AI_OUTPUT_LIMIT for hand-configured Cloudflare models), and the reserved response capacity is both withheld from the prompt budget and sent as the request's response cap.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/agent-compaction.ts#L19-L37",
          "version": "repo-lines-v1:sha256:8a7288f08dc91ce6486282fc99fe76591b0b71ab7aae3c326bb9dd7dc4a75a03:"
        },
        {
          "resource": "repo://packages/workshop-backend/src/agent-compaction.ts#L8-L17",
          "version": "repo-lines-v1:sha256:981a09e7aee80f75ea963a97762e44433363aa190afb48d9231605b3a974fe92:"
        }
      ]
    },
    {
      "id": "claim_c416353f4633414791ee9d1be47cb6ae",
      "statement": "Context size uses provider usage from the last measured step plus an estimate of what was added since (attachment payloads replaced by a marker because model cost depends on content, not bytes), falling back to a characters-divided-by-4 estimate of the whole projection plus the system prompt; the character weights only decide where the cut lands, dividing the measured token count among messages.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/agent-compaction.ts#L237-L249",
          "version": "repo-lines-v1:sha256:25363708c2bf50dc7119c33977a8b994a944e125e63ff379457529f2b79524b2:"
