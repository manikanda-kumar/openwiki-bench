        }
      ]
    },
    {
      "id": "claim_54fc2166b0734f39a9dbd53e25682ac9",
      "statement": "Reconnection only adopts a candidate connection after it answers a ping() probe within a deadline, with jittered backoff (1s initial, 10s max) between attempts; visibility/network-online wake events trigger probes because passive close detection misses sockets killed during laptop sleep.",
      "evidence": [
