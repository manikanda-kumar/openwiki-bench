      "id": "claim_60ecc593a2ac472ea50c57c532e15d44",
      "statement": "The backend serves its entire client API as a Cap'n Web RPC service at /api, accepting HTTP POST batch requests or WebSocket upgrades; batch responses set Access-Control-Allow-Origin: * because the WebSocket transport already permits cross-origin use and the API relies on in-band authorization rather than origin checks.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/server.ts#L816-L869",
          "version": "repo-lines-v1:sha256:44696fee42ae62e87d5d44eec1174baaeb33ae02022ff6ad51b8c8040bd418a9:"
        },
