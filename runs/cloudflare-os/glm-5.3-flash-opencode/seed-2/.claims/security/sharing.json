          "version": "repo-lines-v1:sha256:8dda1fa251224ad000c85ec2b794176d5b153a4eda560290adf2da43e21142e6:"
        }
      ]
    },
    {
      "id": "claim_60c6661f844546da9bd3709d7e56bdcf",
      "statement": "keepUsers is optional re-root sugar: after the edge is severed, each kept user who would otherwise lose access or be downgraded gains a fresh user edge from the caller at their prior role bounded by what the caller can grant — pure convenience layered on the lazy model.",
