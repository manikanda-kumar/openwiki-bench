  "claims": [
    {
      "id": "claim_441b3a78daab4994a44d00a7cbe6c37d",
      "statement": "The observer mechanism enforces the core security invariant that a gadget which reads restricted information cannot be interacted with by someone who cannot read that information themselves: non-owners supply their own connected account per gatekeeper binding, each gatekeeper verifies via addObserver that the person could directly read everything historically read through it (denying the open otherwise), and later observations an observer lacks privileges for are blocked or forward-excluded.",
      "evidence": [
        {
          "resource": "repo://docs/observers.md#L126-L130",
          "version": "repo-lines-v1:sha256:f012493900acef857900a16a680a8b3546dd00a45eb45111f36d17697839e859:"
        },
        {
          "resource": "repo://docs/observers.md#L25-L40",
          "version": "repo-lines-v1:sha256:c5bf1c9dd0fc7dcdca50a108c2edd3af68af99d8d9471eb358b9cc8319a60f56:"
        }
      ]
    },
    {
      "id": "claim_177e925107824fe0a7bffe02ba0fdd7e",
      "statement": "ensureObserver runs on every non-owner open after the role is confirmed and before any capability is handed back (so it never reveals gatekeeper metadata to an unauthorized caller), loading or creating the observer record (a random opaque observerId — deliberately not the profile id, so gatekeepers can't parse identity out of it) and a working copy of its account choices.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L7859-L7880",
          "version": "repo-lines-v1:sha256:675b8f802c1e4106d5a9ed3865b7856fa57f573e611943a34b9e153aa8fc3b40:"
        },
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L8352-L8360",
          "version": "repo-lines-v1:sha256:f53c2de74e17bb1f595bd55bccb3ac570f4604c3e6c699925b5dbe0a855d184d:"
        }
      ]
    },
    {
      "id": "claim_56a0adb2094a4becace33fd57a691fbb",
      "statement": "Verification scope is role-based: build collaborators are verified against every gatekeeper that has a vendor, while use collaborators are verified only against gatekeepers reachable through visible binding edges of non-provisional gadgets (provisional gadgets and pending edges bring nothing into scope) since that is all the use-role UI can invoke.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L7764-L7785",
          "version": "repo-lines-v1:sha256:7d8f1af074d0e7c2e9f17a4182d2c99ac2d0e94122c20f9b147e29406391e76a:"
        }
      ]
    },
    {
      "id": "claim_eda775495cc145adbb70220a1fde410e",
      "statement": "Ambient bindings are auto-filled from the collaborator's matching provided singleton account — the exception to account SELECTION, not verification: the gatekeeper's normal addObserver check still runs against that account.",
      "evidence": [
        {
          "resource": "repo://docs/observers.md#L77-L80",
          "version": "repo-lines-v1:sha256:8f62acc026e1146ce88024bde893010d28d7c81ab92ec842462fc181adec5fcd:"
