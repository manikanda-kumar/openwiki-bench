    {
      "id": "claim_e62fe13a2beb4f1194c929cdee5ddfa5",
      "statement": "Google keeps two frozen lists for backwards compatibility: LEGACY_GRANTED_RESOURCE_URL_PATTERNS (what pre-scope-tracking accounts implicitly received — adding an entry would make ensureResources report an unmade grant as held) and SCOPE_DERIVED_RESOURCE_URL_PATTERNS (grants inferable from held scopes for accounts that never recorded one — frozen because scope inference cannot distinguish a resource the user chose from one that merely shares a scope, e.g. drive.metadata.readonly is requested by the Docs/Sheets pickers).",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-google/src/resources.ts#L100-L129",
          "version": "repo-lines-v1:sha256:393de2e227bf273972081c9599639d56142d878e0f50bf096e31b2ae2f84b738:"
        }
