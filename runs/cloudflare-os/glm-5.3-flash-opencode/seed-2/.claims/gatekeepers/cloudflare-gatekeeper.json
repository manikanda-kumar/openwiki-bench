    {
      "id": "claim_966ce94f69854773af7d991cd929f5fa",
      "statement": "The Cloudflare gatekeeper serves three purposes from one connected account: verified-email sign-in, AI Gateway billing (the Workshop reads a usable token via getUsableAccessToken), and read-only Workers Observability bindings; unlike other auth gatekeepers' transient auth-scope sign-in grants, Cloudflare sign-in persists a billing-only connection because the backend passes {scopes:'full', resourceUrlPatterns:[]} for it specifically.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/README.md#L1-L19",
          "version": "repo-lines-v1:sha256:cc869e85b6393e01a95d6fa60f004cae2a452965948d01d9a99e9ae336fca28a:"
        },
        {
