    {
      "id": "claim_4d13310c46da4e309ca33bba73e32d2a",
      "statement": "Every observability read funnels through one #observe wrapper that fetches first and records the read (with a bounded description) on the approval queue before returning anything — a read reaching the agent but not the queue would be an unaudited disclosure — and summarizeFilter renders filter keys/operations but never filter values, keeping caller text out of the audit trail.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/observability-session.ts#L1-L6",
          "version": "repo-lines-v1:sha256:a79719137015fb62e8503589c873c6e431b980f406b9bb52fc6d5827bb700fa4:"
