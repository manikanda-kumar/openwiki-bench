    {
      "id": "claim_79fb2c0789874cb6968077b7f69872a0",
      "statement": "Worker-scoped observability bindings prepend an immutable $metadata.service filter and re-filter results on the way out, because a filter the provider accepted is not evidence it applied it; a single dropped foreign event proves the filter was not applied, so the provider's count is withheld (it would count the whole account), the drop is logged at error, statistics is kept (it describes query cost, not match volume), and the pagination cursor is derived from the provider's raw events so a fully-foreign page cannot stall pagination.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/README.md#L34-L60",
          "version": "repo-lines-v1:sha256:252f9c71e28eea2d1fc36717efc851b3bcda9c3c1e02652cafc356b79389226c:"
        },
        {
