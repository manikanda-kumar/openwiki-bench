    {
      "id": "claim_109c13fea6b548648e424fb2da5d9273",
      "statement": "Cloudflare OAuth endpoints are hardcoded in the gatekeeper (dash.cloudflare.com/oauth2/auth and /token, overridable for staging); BILLING_SCOPES are offline_access, aig.read, aig.run, user-details.read, account-settings.read; AUTH_SCOPES for the transient sign-in grant are offline_access + user-details.read; openid is deliberately not requested because the dashboard OAuth client is not permitted it, so identity comes from the /user API.",
      "evidence": [
        {
          "resource": "repo://packages/gatekeeper-cloudflare/src/oauth.ts#L1-L39",
          "version": "repo-lines-v1:sha256:f92dea6a8d026bb06342b1a9033c1e20af868e1ba09f88068e1a9ee21389f7b1:"
        }
