    {
      "id": "claim_6f3614fd5c764f1eac36be57440ab3fa",
      "statement": "Approved MCP tool calls are applied at-most-once, not exactly-once: the approval is claimed in the facet's SQLite store before the call is sent (preventing double application), the record is settled in its own write before any result is attached, a fresh DO activation closes every 'applying' claim as failed/non-retryable with an outcome-unknown message, and callMayHaveTakenEffect fails safe — only a not-dispatched error or an auth-required (401/403-class) rejection proves the call never ran, everything else counts as possibly performed and is closed as failed and non-retryable.",
      "evidence": [
        {
          "resource": "repo://packages/mcp-shared/src/action-store.ts#L1-L55",
          "version": "repo-lines-v1:sha256:d0218b5a8eebabaca829b4ff2a5b4c3cf83936e7abeda9f1c2f3b2f3e4a17300:"
