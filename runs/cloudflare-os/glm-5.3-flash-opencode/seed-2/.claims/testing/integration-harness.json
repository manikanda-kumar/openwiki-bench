    {
      "id": "claim_2d1f62e03d064b11bf4e5fbcdc65af6b",
      "statement": "The NetworkInterceptor patches globalThis.fetch (enough because the harness routes Worker subrequests back through the Node process), passes loopback through untouched, and THROWS on any request a handler did not claim — an unmocked call fails the test instead of silently reaching the internet — with getUnmockedCalls() backing the nothing-escaped assertion; vendor endpoint answers live in pluggable handler modules separate from the mechanism.",
      "evidence": [
        {
          "resource": "repo://packages/integration-tests/src/network-interceptor.ts#L1-L90",
          "version": "repo-lines-v1:sha256:94692b8d56f6230718a89b423865838d0319efb0b25365dab23261ccaf8a1f88:"
        }
