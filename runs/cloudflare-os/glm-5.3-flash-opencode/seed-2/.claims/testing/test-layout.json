    {
      "id": "claim_7263f8b3ade74dd297fe4d9c36b2027e",
      "statement": "scripts/assert-workerd.ts is a setupFiles entry in every workerd-pool package and throws unless navigator.userAgent is 'Cloudflare-Workers', because when vitest-pool-workers cannot start vitest silently falls back to Node — and packages like router and typed-storage import neither cloudflare:test nor cloudflare:workers, so they would stay green while testing the wrong runtime; removing it to make a suite green is a review rejection.",
      "evidence": [
