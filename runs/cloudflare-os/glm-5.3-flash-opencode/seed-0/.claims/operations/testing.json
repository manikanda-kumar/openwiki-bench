    },
    {
      "id": "claim_9eb7a494eb3d4551bbf8f41f3efa3a7c",
      "statement": "The watchdog exists because nothing else bounds a wedged run: vitest's timeouts are enforced inside the test worker that died, Vite+ has no task timeout, and vitest-pool-workers imports Miniflare without onWorkerdCrashRestart so a dead workerd leaves the pool awaiting a reply that never arrives; silence (not wall clock) is the primary detector since a healthy vitest run prints a line per completed file.",
      "evidence": [
        {
          "resource": "repo://scripts/with-timeout.ts#L1-L28",
          "version": "repo-lines-v1:sha256:48af54997541dc3211f3ebe5ac0153fb0889ffcf4d0b774fee4dc6ff4ec9cac7:"
        }
