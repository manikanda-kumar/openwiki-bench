    {
      "id": "claim_b39eb09b617142cebfbca257067e8524",
      "statement": "pnpm dev-server's pre-flight runs three concurrent builds: the format-blueprint generator, vp run -r --cache build:configurator --dev, and vp run -r --cache build:app:dev (the unminified app build so its src/generated/app.txt matches what the watchers' unskippable initial build will write, avoiding a mid-startup Wrangler restart); vp run takes one task per invocation, and a gatekeeper without one of these tasks is never built here.",
      "evidence": [
        {
          "resource": "repo://scripts/run-dev-server.ts#L255-L285",
          "version": "repo-lines-v1:sha256:5c505398904d9c95aabe3bd6391c15ea7965b680efab348363a82ad36e2624d4:"
