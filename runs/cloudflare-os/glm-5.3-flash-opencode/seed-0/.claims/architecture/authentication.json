    {
      "id": "claim_080e512ab3ae4c188718191a5a874ec5",
      "statement": "`DISABLE_PASSWORD_AUTH=true` disables password login only when at least one auth gatekeeper is allowlisted; otherwise password auth remains enabled so a deployment can never lock out all sign-in.",
