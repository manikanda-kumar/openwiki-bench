    {
      "id": "claim_f606da1b1f484d2c88ed4a0841db5fd9",
      "statement": "Auth provider configuration is env-var driven in `packages/workshop-backend/src/auth/config.ts` (`DISABLE_PASSWORD_AUTH`, `AUTH_GATEKEEPERS`, and CF Access variables), deliberately separate from the admin-editable `AdminConfig`, which owns only the `signupsEnabled` gate consulted by every account-creation path.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/auth/config.ts#L1-L33",
          "version": "repo-lines-v1:sha256:e2814308ecc0a7504324aea2c892c1e12da342c46d375258d3730d58386b4c19:"
