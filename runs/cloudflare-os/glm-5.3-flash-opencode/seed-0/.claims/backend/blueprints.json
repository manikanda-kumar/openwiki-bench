    {
      "id": "claim_bec7c95a19b74d9e9123c74bafd45440",
      "statement": "A blueprint captures a gadget's code snapshot and binding requirements (shape only, never credentials or live connections) plus metadata, but not chat history, SQLite storage, or credentials; each instantiated gadget gets its own bindings, storage, and chat history, and a gadget can have multiple blueprints at different versions with old versions retained on update.",
      "evidence": [
        {
          "resource": "repo://docs/blueprints.md#L1-L33",
          "version": "repo-lines-v1:sha256:4853b64e83a6e89c223b8e4fe0ff66a5c4674ad31ec4bd09e67f7fe500c5ba4a:"
        }
      ]
    },
    {
      "id": "claim_9079016c806b4de7a5bec7130e472743",
      "statement": "Blueprint data propagates one way — Gadget DO (authoritative, with a dirty flag that survives propagation failures until retry) -> User DO (denormalized listing copy) -> Workers KV (public lookup store) — with code content stored separately in R2.",
