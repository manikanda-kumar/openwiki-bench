    {
      "id": "claim_e33e0ac6e98f452c8b33c1b0285658b7",
      "statement": "The .gadget archive format is a 24-byte prefix (8-byte magic 0xec2e2d3a2300e317, 4-byte version, 4-byte metadata length, 8-byte content length) followed by UTF-8 JSON metadata and gzip-compressed content; the parser validates magic, version, a nonzero metadata size up to 64 KiB, and a safe content length up to 32 MiB before handing the content tail back as a lazily-pulled stream.",
      "evidence": [
        {
