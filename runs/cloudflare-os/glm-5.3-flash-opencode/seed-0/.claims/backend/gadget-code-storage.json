    {
      "id": "claim_8f4f22fa0ba240acb2f2a6131527f9f0",
      "statement": "The legacy migration replays the pre-git Yjs code log once, synthesizing per-gadget commit chains at merge-message versions, versions followed by >=1-hour gaps, the final version, and persisted pinned versions (resolved to the last code version at or below it); each permanent gadget's chain is rooted at a version-0 empty-tree commit so every permanent gadget ends with a head, and records referencing code-log versions are rewritten to reference commits.",
      "evidence": [
