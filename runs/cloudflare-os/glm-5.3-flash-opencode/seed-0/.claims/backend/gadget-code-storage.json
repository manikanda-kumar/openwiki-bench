  "claims": [
    {
      "id": "claim_4669c33cf8234b00937d264320d9d9f3",
      "statement": "Each workspace's Overseer DO holds a real git object database — SHA-1, zlib-deflated loose objects byte-identical to what git writes — in the gitObjects typed-storage collection keyed by oid, with no ref layer (no branches/tags/HEAD): the refs are gadget records' commitIds, blueprint records, and chats' pinned commits managed by the overseer's workflow.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/git-store.ts#L1-L36",
          "version": "repo-lines-v1:sha256:561e34821b644f47788ccff3959b10693497ef2d4edffa6086bdb38a15581927:"
        }
      ]
    },
    {
      "id": "claim_d835a08caac8476cb027b64811e90036",
      "statement": "The object store has no GC: dangling objects are created only by accepted merges, imports, and migration (never in-flight chats) and are cheap; if GC is ever needed its roots are enumerable (gadget/blueprint records, live chats' pins and compaction checkpoints, and chats' observedCommit stamps).",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/git-store.ts#L30-L36",
          "version": "repo-lines-v1:sha256:2c90724cc7ce25e4537703089c5bbd79aa51102474ba1f794db9e304898e23cd:"
        }
      ]
    },
    {
      "id": "claim_c55e0861be654ab5839e243d75fd8ca5",
      "statement": "No stored object exceeds ~2 MiB today (single source files, small trees, commit headers); large blobs would require chunking records or spilling to R2, a change local to the fs shim.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/git-store.ts#L23-L29",
          "version": "repo-lines-v1:sha256:5119bec95034a8a88ce29aac5e9cd0b18792a9ccad2c17d6a93f6e5b7987bda3:"
        }
