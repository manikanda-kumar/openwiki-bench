    {
      "id": "claim_2bdfca157ee64aac90815d111536f6b4",
      "statement": "threeWayMerge() merges base/ours/theirs file maps and never throws on conflict: conflicted files carry inline diff3-style markers and appear in conflictPaths; it deliberately replaces Yjs merging (nonsense across divergent bases) and isomorphic-git's merge/mergeTree (which throw on both-sides-added conflicts), with per-file semantics of one-side-wins, identical-both-clean, delete-vs-modify keeping modified content as a conflict, and both-side changes merged by diff3.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/git-store.ts#L452-L522",
          "version": "repo-lines-v1:sha256:716d52204eea3af72d4ab81bbaee4266f4582ea00b00e8c1d0db0bdaec281dc4:"
        }
      ]
