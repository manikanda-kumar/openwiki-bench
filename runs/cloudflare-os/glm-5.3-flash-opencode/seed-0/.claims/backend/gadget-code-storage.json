    {
      "id": "claim_25c7328245ed4c5697694a499005b987",
      "statement": "submitCodeChange() is the only way to edit code — committed code cannot be written directly and gadget heads advance only via mergeChanges(); the server transforms each submission over changes accepted since, answers retries (clientId+seq) with the recorded result instead of double-applying, and requires retries to carry the same seq and identical payload because OT does not tolerate double-application.",
      "evidence": [
