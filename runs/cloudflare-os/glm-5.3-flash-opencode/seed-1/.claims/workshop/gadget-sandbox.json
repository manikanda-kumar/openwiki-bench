          "version": "repo-lines-v1:sha256:46839a7714666f841e230be078906949e883ee7cd60c530e89b10f63334d4652:"
        }
      ]
    },
    {
      "id": "claim_52f2462827e24980a2c4ebf6ab8db5fa",
      "statement": "The restore-forger capability is handed only to executeCode runs — never to gadget workers — as a transient stub argument scoped to the execution, with binding names resolved against the execution's own binding map overseer-side, so the capability conveys no authority beyond the env it accompanies.",
      "evidence": [
