    {
      "id": "claim_af00aafb9d1d4ca08e30ec39a52a569e",
      "statement": "The gadget client iframe is generated with a strict CSP (default-src 'none', connect-src 'none', frame-src 'none', object-src 'none', base-uri 'none', form-action 'none', script/style from data: and inline only, img/media from data:), so the iframe cannot open any network connection; the injected code speaks RPC by postMessageing a handshake with one end of a MessageChannel and running newMessagePortRpcSession on the other end, with the Cap'n Web bundle injected as a doubly-nested data: URL because the sandboxed iframe cannot load regular script sources.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-frontend/src/GadgetUI.tsx#L105-L116",
          "version": "repo-lines-v1:sha256:75811c2a413cb90401b91808266ee271b8bb915bd68f8675a2f1033263a0b915:"
