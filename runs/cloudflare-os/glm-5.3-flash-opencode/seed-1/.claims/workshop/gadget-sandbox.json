    {
      "id": "claim_6a4a571e7e23435a848e89a42a148a74",
      "statement": "executeCode runs its own dynamic worker with a stricter def: the built-in CODE_MODE_HARNESS wires PARAMS_<n> callback resolvers ({args, resolve, reject}) into env, grafts the restore symbol onto service-binding stubs of this execution's own bindings, runs the agent's code as agent.js with (self, env, ctx), uses disallow_importable_env (which also disallows importable ctx.exports to prevent self-calling loops) plus allow_irrevocable_stub_storage, globalOutbound null, a CodeModeTailLoopback tail, and verifies startup before running.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L69-L106",
          "version": "repo-lines-v1:sha256:f9807446c5c1580fd8ed00f6d0d9324fbab68956ff0407c18e16b6ba4af17f96:"
