    {
      "id": "claim_3da8f22b20e94242ba7de322d8835a3c",
      "statement": "Gadget worker cache invalidation is deliberate: every merge bumps codeVersion (invalidating committed loads), chat-context loads key on the chat's snapshotted sequence so a mid-load merge cannot flip the content, switching between chats or back to mainline aborts the gadget facet via ctx.facets.abort, and a change to a chat's proposed changes restarts any facet running that chat.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L2798-L2805",
          "version": "repo-lines-v1:sha256:bc1cc3d7491efacaa2da54463a09a1742bf865e68a85b52d9a3581ea2e87a06d:"
