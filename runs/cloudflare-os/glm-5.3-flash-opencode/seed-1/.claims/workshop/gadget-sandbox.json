  "claims": [
    {
      "id": "claim_a192b7f7a2b3481fb066637a72da02d5",
      "statement": "Gadget server code runs in a dynamic worker loaded through the LOADER binding: modules are the gadget's .js files from its head commit or a chat's snapshotted content, mainModule is server.js, globalOutbound is null (no internet at all), the compatibility flag allow_irrevocable_stub_storage enables ctx.restore(), the env carries GADGET plus every visible binding edge as gatekeeper loopbacks, and a GadgetTailLoopback streams console logs to the UI.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L2734-L2742",
          "version": "repo-lines-v1:sha256:de25234799ed7b865db21fb215a16049bf20f5dbfefb7a8496d7947d1ec70bb5:"
        },
