          "resource": "repo://packages/workshop-backend/src/overseer.ts#L187-L211",
          "version": "repo-lines-v1:sha256:65c3a32a850f8164a6549cb5440b33bb4d9f324b085c5966f1dd944e7e8878d1:"
        }
