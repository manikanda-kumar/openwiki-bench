    {
      "id": "claim_19a01dc943cf47e2a8b06f49d6d740b1",
      "statement": "A caller may never grant a role higher than their own effective role, and re-adding an edge from the same sharer upgrades (never silently downgrades) the existing edge's role to the maximum.",
      "evidence": [
        {
