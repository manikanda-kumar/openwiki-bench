    {
      "id": "claim_3a0efb05ae814126855f5f6ab9ff6be2",
      "statement": "Authorization is enforced at open(): the caller's effective role is computed from the permission graph (no role means WORKSPACE_ACCESS_DENIED without workspace metadata), and a removal or downgrade that actually changed someone's access schedules a DO restart — flushing storage first with ctx.storage.sync() (because ctx.abort() does not respect the output gate), waiting ~100ms so the triggering response reaches the caller, then aborting so every client reconnects and re-runs open() against the changed graph; pure no-op removals do not restart.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L4998-L5002",
          "version": "repo-lines-v1:sha256:902814dbe4d39635eac8b44a59d7ec5dfa71e03f679304571cee5060524c4906:"
