    {
      "id": "claim_4808d76bd7ee403ebe0bba580b14f84b",
      "statement": "keepUsers re-roots spared dependents after a removal or revocation: for each kept user who would otherwise lose access or be downgraded, a fresh user edge is appended from the caller at their prior role, bounded by what the caller can grant.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L676-L689",
          "version": "repo-lines-v1:sha256:f3dc0ad27d67e7d5ffbac54c0df6c2230d469d39a3d9f3b3d31ea177103d2be5:"
