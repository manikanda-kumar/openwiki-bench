  "claims": [
    {
      "id": "claim_c90750bd714e4c76a00c5876c82b65ad",
      "statement": "SharingManager owns all manipulation of the collaborators and shareKeys collections and the permission graph linking them, deliberately performing no RPC itself — anything requiring a User DO stays in the Overseer — and the prohibitAllSharing lockdown flag intentionally does not live here: it is a broader communication policy enforced by the Overseer, which only asks hasAnyShares().",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L1-L22",
          "version": "repo-lines-v1:sha256:77626ebae0e6ecf726f951f198a5c9f1071abf26947f0d29010a117a0af5d5f4:"
        }
      ]
    },
    {
      "id": "claim_8d55c0b5703d48ceb22def79fcc0ff10",
      "statement": "Share keys are stored only as HMAC-SHA-256 hashes of the raw random keys under a fixed 256-bit domain-separation key (not secret, only personalization); a link record is keyed by its first key's hash and carries creator, role, and a soft-revocation flag, while later copies are ShareKeyAliasRecords pointing back at the link id — the raw key is never stored server-side.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L47-L65",
          "version": "repo-lines-v1:sha256:24f724d81d234d071c46b47347fec81fd9ffff4876e063aa94868324c3c0503e:"
        },
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L81-L119",
          "version": "repo-lines-v1:sha256:cb37e5e8b47dcd0f84546321accad42d2f00fa5af0348641d8ec551d013669cf:"
        }
      ]
    },
    {
      "id": "claim_1f70f6d684ed43ad89186ca8eca26623",
      "statement": "Share-link edges reference the link, not individual keys, so a link's keys collapse into one grant: redeeming a second key of the same link is a no-op, and a revoked link's keys behave like unknown keys for redemption while the record stays so graph edges keep resolving.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L228-L250",
          "version": "repo-lines-v1:sha256:71fdd10bc32994b57bb069f3213dfcd529abba0243ae1a38b9a1d4c52832dfea:"
        }
      ]
    },
    {
      "id": "claim_fb13980e4a904aa0b612610810b04737",
      "statement": "computeEffectiveRoles is the single source of truth for access: it iterates to a fixed point where each edge grants min(edge role, sharer's effective role) — the owner is the implicit build root, share-link edges grant min(link role, link creator's role) — and each collaborator's role is raised to the maximum across valid edges; roles only increase so the loop converges, and absence from the map means no access.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L567-L639",
          "version": "repo-lines-v1:sha256:407ae9fa187e89a2767b12a59b8b815aa53d7953f61c56c885b710c45f64f9f8:"
        }
      ]
    },
    {
      "id": "claim_47955ed6210b496d8c9b12359a93ed3d",
      "statement": "Effective role is never denormalized into storage: it is recomputed live at every open(), which is what makes lazy revocation safe — severing an edge is enough to deny access at the next open even though unreachable collaborator records and revoked links linger in storage.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L203-L205",
          "version": "repo-lines-v1:sha256:6269e05f12ed3d2b6eb427839e852531889ce89d5883315ac01354df7ea54d50:"
        },
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L9-L11",
          "version": "repo-lines-v1:sha256:f4e635e2e713babb32870657c9295164de70fce24a5a95187bb3f8fb1e1fe3e7:"
        }
      ]
    },
    {
      "id": "claim_5c0d2e8b3fff4a319714a38ee4272f88",
      "statement": "Revocation is preview-confirmed and lazy: preview methods recompute effective roles with a hypothetical removal/revocation and diff against the baseline to report AffectedCollaborators (old role to new role or null), removal severs only the edges granting the target access (a non-owner can sever only their own user edge), listings return only currently-reachable collaborators, and nothing is destructively pruned so re-adding a removed party restores them and everyone downstream.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/sharing.ts#L269-L287",
          "version": "repo-lines-v1:sha256:8f0bda7010690c709e9beedc6854c8c7bc41ed056c339c55981ee4583212ef8d:"
