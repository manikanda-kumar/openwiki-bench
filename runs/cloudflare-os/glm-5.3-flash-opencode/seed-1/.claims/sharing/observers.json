    {
      "id": "claim_7c9dd12d5f1e4e909cdb9b4625c346ef",
      "statement": "Each configured non-owner observer gets an ObserverRecord: profileId as the primary key, a random opaque observerId deliberately not derived from the profile id (so gatekeeper authors cannot parse identity from it — identity is conveyed only via the verifier), and accountChoices keyed by gatekeeper id pointing at ConnectedAccountRecord ids in the observer's own User DO.",
      "evidence": [
