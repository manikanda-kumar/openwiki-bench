    {
      "id": "claim_f2b755774bf34532ae18a3bbbe294f91",
      "statement": "ensureObserver scopes by role (build verifies against every gatekeeper; use only gatekeepers bound to non-pending gadgets, since provisional gadgets and edges are invisible to use collaborators), auto-fills ambient bindings from the collaborator's matching provided singleton accounts, and leaves a failed ambient binding uncovered on a re-prompt so the client can explain the failure rather than silently retrying.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L7852-L7920",
          "version": "repo-lines-v1:sha256:094c8db412a6536b46acd678dcbe818baa3d708ce21e04872bc52dc413dcf1ed:"
        }
      ]
    },
    {
      "id": "claim_a1100bc0b2354eb7917229324d3adf90",
      "statement": "Uncovered bindings are resolved through the ObserverConfigCallback.configure(needs) capability the client passed to openGadget — the common case (owner or already-configured observer) never round-trips; each ObserverBindingNeed carries a failure reason on re-prompts, a non-interactive open denies when no callback was supplied, and the client must return a valid choice for every uncovered binding.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L7922-L7957",
          "version": "repo-lines-v1:sha256:a828d3691b96674faad4f92b7c43fa36c43d265ba18f347711fd9c19bbd50140:"
