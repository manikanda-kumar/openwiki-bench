        }
      ]
    },
    {
      "id": "claim_e2524215d48444cf971ecc0204bead83",
      "statement": "Verification resolves each chosen account's verifier via clientUser.getVerifier(accountId, vendorId), which throws on a vendor mismatch (only reachable by bypassing the UI) and returns null when the account is gone, then calls gatekeeper.addObserver(observerId, verifier) for every in-scope binding in parallel, collecting all failures rather than only the first.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-backend/src/overseer.ts#L7959-L7994",
          "version": "repo-lines-v1:sha256:a053877ef17661837a644428dfd0d767e7950c1a3b6915cded0399f584dbc07d:"
