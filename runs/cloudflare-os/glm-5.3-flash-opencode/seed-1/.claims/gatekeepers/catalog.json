    {
      "id": "claim_93d051ffe58b4c0a9cefdb4b4116d480",
      "statement": "MCP tool trust is tiered: byo (user-typed URL) honors only readOnlyHint for read classification and can never auto-apply a write, while vetted (deployment-asserted, requiring MCP_PORTAL_TRUST_ANNOTATIONS=true for the portal) lets destructiveHint:false + idempotentHint:true drive auto-approval; nothing outside tools.ts reads a tool's annotations, and unannotated tools are always approval-required actions on either tier.",
      "evidence": [
        {
          "resource": "repo://packages/mcp-shared/README.md#L11-L27",
          "version": "repo-lines-v1:sha256:bd79a4c8e22b0f42c3e0d8d070a20c1028ee69a096d2d22001cc49c251a3e94f:"
        }
      ]
    },
    {
      "id": "claim_ccb09a9d975a4f38adf1538e36a69cab",
      "statement": "MCP action application is at-most-once rather than exactly-once: an approval is claimed in storage before the call is sent and settled before the result is attached, and any failure not positively identifiable as server-side refusal (only 401/403 proves refusal) is closed as failed and non-retryable because the write may already have happened.",
      "evidence": [
