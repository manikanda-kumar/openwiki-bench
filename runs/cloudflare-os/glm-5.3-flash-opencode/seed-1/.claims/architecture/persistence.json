    {
      "id": "claim_96390c8fb0784260a15725d0b847cd05",
      "statement": "The workspace uses a custom threeWayMerge rather than git's merge machinery; git porcelain is off-limits because git.commit requires HEAD/index/config and git.merge cannot represent the merge behavior the workspace wants.",
