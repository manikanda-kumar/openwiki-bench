        }
      ]
    },
    {
      "id": "claim_77dff4b4aadd44248e51fba5d9cd525d",
      "statement": "The frontend reconnects by publishing an RpcPromise wrapping the next connection on onRpcBroken, so calls pipelined during an outage queue in order; a replacement stub must pass a ping() probe before taking effect, and the PublicApi stub is stored wrapped in an object to avoid React's callable-state-setter behavior.",
      "evidence": [
        {
          "resource": "repo://packages/workshop-frontend/src/RpcContext.tsx#L7-L9",
