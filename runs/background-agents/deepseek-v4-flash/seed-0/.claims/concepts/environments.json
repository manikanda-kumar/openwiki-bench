    {
      "id": "claim_30deae58a76c4e8fb5f46c0cbc356667",
      "statement": "An environment's member list inherits the session repository list contract exactly: non-empty, deduplicated by owner/name and by repoName (checkout paths are /workspace/{repoName}), and capped at MAX_TARGET_REPOSITORIES — so an environment is a prebuildable repository set with the same list rules as a session.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/types/environments.ts#L22-L29",
          "version": "repo-lines-v1:sha256:709c94bc246d3662a1ac3e2e10179572b3a44128086ca680eb790bb44c16c084:"
