    },
    {
      "id": "claim_38074f7098c5483dafc5e716378955de",
      "statement": "Spawn-time image selection for an environment session matches the environment's image against the session's own repository snapshot fingerprint and never falls back to a repo image (it would bake that repository's setup and secrets); multi-repo ad-hoc sessions never use prebuilt images, so both miss straight to the base image.",
      "evidence": [
        {
          "resource": "repo://packages/control-plane/src/sandbox/lifecycle/manager.ts#L541-L561",
          "version": "repo-lines-v1:sha256:0f0d674d11e0549402cc7eb72f9d61bb4e1fa5407e8bfc7cf7510453299b9dfe:"
        }
