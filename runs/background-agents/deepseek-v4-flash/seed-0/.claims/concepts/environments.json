    {
      "id": "claim_1693b243a1b8430f8bd9df0207e0c413",
      "statement": "GitHub-bot session-target resolution fails open: a repository's repo_metadata.default_environment_id opts sessions triggered from it into that environment's full workspace, but the bot falls back to the repo-bound session whenever the metadata lookup fails, the environment no longer exists, or it no longer contains the trigger repository — the session must always be able to check out the PR under review.",
      "evidence": [
        {
          "resource": "repo://packages/github-bot/src/session-target.ts#L187-L225",
          "version": "repo-lines-v1:sha256:26d878aa4214c3ef8045f47656e5c08956cb2983a92110347acca06c365348d1:"
