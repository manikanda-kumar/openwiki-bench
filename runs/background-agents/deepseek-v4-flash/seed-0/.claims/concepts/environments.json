    {
      "id": "claim_2e2fc685f7134b16a36341f695956ed8",
      "statement": "An environment is a named, prebuildable repository set: its stable identity is env_<id> (validated by isEnvironmentId, the single gate for environment-id shapes), while its display name is a user-editable label made unique case-insensitively by the idx_environments_name index.",
      "evidence": [
        {
          "resource": "repo://packages/shared/src/types/environments.ts#L11-L20",
          "version": "repo-lines-v1:sha256:5459c9005d837c03079a7d9353f31dbf437f2e5494f7c7f27194bdfdc6237613:"
        },
        {
