        }
      ]
    },
    {
      "id": "claim_b1c0e5ae44044de18373fcd8ac54bd42",
      "statement": "Environment persistence follows an ownership/cascade model: environment_repositories and environment_secrets are owned children with ON DELETE CASCADE and are deleted atomically with the parent row, while image_builds and sessions.environment_id are deliberately FK-less so deleting an environment supersedes its live images for the reaper and leaves sessions with a benignly dangling provenance id.",
      "evidence": [
        {
          "resource": "repo://packages/control-plane/src/db/environments.ts#L205-L219",
          "version": "repo-lines-v1:sha256:c70fc24b18473f005998ea09daae516d7931ddc74c1d00a3598f7b3264e89199:"
        },
        {
          "resource": "repo://terraform/d1/migrations/0033_environments.sql#L9-L14",
          "version": "repo-lines-v1:sha256:a4bdfe31c219c2dc992ddfd07329f76618ed0a8b22fecb14467a68b42a665f34:"
        }
      ]
    },
    {
      "id": "claim_d9f60941bd6d4dd889173889dca11d41",
      "statement": "EnvironmentStore performs CRUD as atomic D1 batches: create inserts the environment plus its repository rows together; update merges mutable scalar fields with a wholesale repository-set replacement (undefined leaves the set untouched) and always bumps updated_at, returning null when the environment vanished concurrently; delete is idempotent.",
      "evidence": [
        {
          "resource": "repo://packages/control-plane/src/db/environments.ts#L171-L194",
          "version": "repo-lines-v1:sha256:446f2b989e623862e6c4d24dc7f964a57e3c664c379a8b593db951b019467bec:"
