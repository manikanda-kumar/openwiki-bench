    {
      "id": "claim_8ee06eb30b694014aa6391224ff11fef",
      "statement": "The control plane is a single Cloudflare Worker with three platform entrypoints: fetch (HTTP API plus WebSocket upgrades forwarded to the SessionDO), scheduled (a per-minute tick for automation recovery and overdue runs plus image-build and abandoned-draft sweep crons), and queue (image-build finalization and GitHub Autofix consumers).",
      "evidence": [
        {
          "resource": "repo://packages/control-plane/src/index.ts#L32-L90",
          "version": "repo-lines-v1:sha256:8ca352a1b11f9fc0a5c59bcb173d47c2b17b7f796d3c32a8d175e99a076f6314:"
        }
