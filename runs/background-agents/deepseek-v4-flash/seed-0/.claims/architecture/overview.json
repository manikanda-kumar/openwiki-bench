    {
      "id": "claim_ed43b065617446a1bd08f7c6a91a4365",
      "statement": "Open-Inspect is a background coding agent system that runs sessions in sandboxed cloud environments independent of the user's connection; it is single-tenant only, with all users trusted members of one organization and sharing repository access via a single GitHub App installation.",
