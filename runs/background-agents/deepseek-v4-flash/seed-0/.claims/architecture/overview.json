    },
    {
      "id": "claim_a7bf7638a17a4505bdf24d7d99ddb7c3",
      "statement": "The control plane composes a router (router.ts) with per-route authentication policies and an instrumented D1 database handle; an ESLint rule forbids reading env.DB outside composition roots so handlers use ctx.db and every query is timed.",
      "evidence": [
        {
