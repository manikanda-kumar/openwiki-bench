    {
      "id": "claim_b36dcbca63ab4194bccffb60b905b363",
      "statement": "HallucinationDetector scores fields against document text using the formula contradicted fields / total fields, with per-field scores from the LLM check (is_contradicted, 0.0-1.0 score, reasoning) or heuristics; None and metadata fields (doc_id, metadata, confidence) are skipped, lists and dicts recurse, unhandled types score 0.5, and a field counts as hallucinated at score >= threshold (default 0.7).",
      "evidence": [
