    {
      "id": "claim_e60ea606995f4ce0b09647400472276b",
      "statement": "The extract_thinker package root exports the supported API (Extractor, Process, LLM, DocumentLoader base plus concrete loaders and config dataclasses, splitters, Contract, Classification, strategy enums, BatchJob, MarkdownConverter) and calls filter_pydantic_v2_warnings() at import time.",
      "evidence": [
        {
          "resource": "repo://extract_thinker/__init__.py#L1-L90",
