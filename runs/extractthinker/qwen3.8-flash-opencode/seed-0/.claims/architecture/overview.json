  "claims": [
    {
      "id": "claim_2ff49df3fd944539b2ce2c198e458ba2",
      "statement": "The extract_thinker package exposes its entire integration surface from __init__.py: Extractor, Process, LLM, the DocumentLoader base and roughly seventeen concrete loaders with Config dataclasses, splitters, model/strategy types, BatchJob, and MarkdownConverter; importing the package also applies filter_pydantic_v2_warnings().",
      "evidence": [
        {
          "resource": "repo://extract_thinker/__init__.py#L1-L38",
          "version": "repo-lines-v1:sha256:a262f4d051d37e5a1e29ebc2c873697d274da634ca7a7236690e79cab2bf763c:"
        }
      ]
    },
    {
      "id": "claim_74b733f9707c4de58a20ea8a39b9b6f7",
      "statement": "Extractor.extract validates dependencies, loads content through a selected DocumentLoader, normalizes it via _map_to_universal_format into {content, images, metadata}, builds a fixed system/user prompt, and dispatches to the LLM, making it the central facade of the single-document pipeline.",
      "evidence": [
        {
          "resource": "repo://extract_thinker/extractor.py#L1115-L1147",
          "version": "repo-lines-v1:sha256:49a45047cfeb47c81fff51efd6f765f6e6f8f016e855d0755c8c669bab5397ee:"
