    {
      "id": "claim_1bdf9fd8574c4db085cfc6675a717002",
      "statement": "FieldComparisonConfig implements EXACT (stripped strings or key-sorted JSON), FUZZY (Levenshtein ratio at >= similarity_threshold 0.8 default), SEMANTIC, NUMERIC (relative tolerance 0.01 default, absolute when expected is zero), and CUSTOM comparisons, with None-None matches and None-vs-value mismatches.",
      "evidence": [
        {
          "resource": "repo://extract_thinker/eval/field_comparison.py#L6-L56",
          "version": "repo-lines-v1:sha256:bf5ead9f54fe3ce2500a3d8f47b73117c99c903315505ece2b78067dcb2e347e:"
        }
      ]
    },
    {
      "id": "claim_1a9a0670d17b4d72a59a06cf908c31c2",
      "statement": "FUZZY falls back to exact matching when the optional Levenshtein package is missing, and SEMANTIC tries a class-cached sentence-transformers all-MiniLM-L6-v2 model, then litellm embedding with text-embedding-ada-002, then fuzzy — all optional-dependency fallbacks.",
      "evidence": [
        {
          "resource": "repo://extract_thinker/eval/field_comparison.py#L66-L124",
