    },
    {
      "id": "claim_47d04e7f849c43eb8e7865cf885c167f",
      "statement": "flowContext carries DisableCustomSANs, SSHPublicKey, CertificateRequest, ConfirmationFingerprint and CustomAttributes; the Option interface only requires apply(fo *flowContext), and built-in options (WithSSHPublicKey, WithCertificateRequest, WithConfirmationFingerprint, WithCustomAttributes which merges into the 'user' claim map) are created with newFuncFlowOption; all options are applied to the process-global sharedContext so commands in the same invocation can pass data between flows.",
      "evidence": [
        {
          "resource": "repo://utils/cautils/certificate_flow.go#L42-L103",
          "version": "repo-lines-v1:sha256:e9014d04915579c084c9c4fbaae894e8fc438a7cb8ac9bc3c59b75da97309449:"
        }
