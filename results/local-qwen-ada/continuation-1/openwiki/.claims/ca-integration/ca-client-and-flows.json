    {
      "id": "claim_fd375bbc14ab4a1caf2a65f74abd1abb",
      "statement": "CertificateFlow.GetClient returns the OfflineCA in offline mode; online it parses the OTT and, for bootstrap/provisioning tokens (payload SHA claim plus http audience) uses the audience as the CA URL when --ca-url is unset and trusts the root via ca.WithRootSHA256, while for all other tokens --ca-url is required and the root defaults to pki.GetRootCAPath() with ca.WithRootFile.",
      "evidence": [
        {
          "resource": "repo://utils/cautils/certificate_flow.go#L134-L171",
          "version": "repo-lines-v1:sha256:eac06e54a30b1c44b73cef0ba05ec80a593dabe45011372e61bc7bd15ba6eeb7:"
        }
