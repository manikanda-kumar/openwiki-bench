    },
    {
      "id": "claim_41574edd2b4e4202810658e95a00c517",
      "statement": "GenerateToken (SignType) and GenerateSSHToken delegate to OfflineCA.GenerateToken when offline, otherwise require --ca-url (unless --token), resolve the root, and call NewTokenFlow; GenerateIdentityToken is always online and delegates to NewIdentityTokenFlow, which builds a token using only an OIDC provisioner.",
      "evidence": [
        {
          "resource": "repo://utils/cautils/certificate_flow.go#L176-L247",
          "version": "repo-lines-v1:sha256:772b8349d697e64f03a1967ffc1b13234daac5db4f052aad5e432bc96bc75d3d:"
